local gc = loadstring(game:HttpGet("https://raw.githubusercontent.com/Interception-m/severe-gc-shit/refs/heads/main/sev_gc_shit.lua", true))()
local UI = loadstring(game:HttpGet("https://raw.githubusercontent.com/1ampr1me/libraries/056da49f13d19b48444b67e409c08b39ae9985be/main-uilib", true))()

local G = _G
if G.PF_Cleanup then G.PF_Cleanup() end

local RunService = game:GetService("RunService")
local clock = os.clock
local ZERO = vector.create(0, 0, 0)

-- Pause after the LAST click before the batch is applied (gc scans are slow, so clicks are collected first)
local DEBOUNCE = 0.8

-- Keep re-reads this table every cycle, so the slider changes the value live
local aimWalk = { aimwalkspeedmult = 2 }

-- Each entry in `sets` is one gc.set call; `recoil` features zero the gun recoil sub-tables instead
-- `slider` features re-apply every 1 s so the slider stays live
local features = {
    { name = "Unlock guns + attachments", sets = {
        { unlockrank = 0 }, { unlockkills = 0 }, { unlockkils = 0 },
        { hideunlessowned = false }, { exclusiveunlock = false },
    } },
    { name = "No recoil", recoil = true, sets = {} },
    { name = "No spread", sets = { { hipfirespread = 0 }, { hipfirestability = 20, hipfirespreadrecover = 100 } } },
    { name = "Instant reload", sets = { { timescale = 0 } } },
    -- All four keys exist together in every gun table
    { name = "Instant equip", sets = { { equiptime = 0, unequiptime = 0, equipspeed = 100, unequipspeed = 100 } } },
    -- aimspeed alone also matches altaimdata entries (alt sights)
    { name = "Fast ADS", sets = { { aimspeed = 100 }, { unaimspeed = 100, magnifyspeed = 100, unmagnifyspeed = 100 } } },
    { name = "No sway", sets = { { idleswayampaimmult = 0, idleswayamphipmult = 0 }, { nosway = true } } },
    { name = "Aim walk speed", sets = { aimWalk }, slider = true },
}

local byName = {}
for _, f in features do byName[f.name] = f end

local running = true
local applying = false
-- pending[feature] = desired state; f.on = state actually applied via gc
local pending = {}
local lastChange = 0

local function onToggle(value, flag)
    local f = byName[flag]
    if not f then return end
    pending[f] = value
    lastChange = clock()
end

-- Zero every number/vector inside a remote table (recursive), remembering the originals for undo
local function zeroTable(t, depth, saved, seen)
    local addr = gc.address(t)
    if seen[addr] then return end
    seen[addr] = true

    local zeros, prev = {}, {}
    for k, v in t do
        local tv = type(v)
        if tv == "number" then
            if v ~= 0 then zeros[k], prev[k] = 0, v end
        elseif tv == "vector" then
            if v ~= ZERO then zeros[k], prev[k] = ZERO, v end
        elseif tv == "table" and depth > 1 and gc.isremote(v) then
            zeroTable(v, depth - 1, saved, seen)
        end
    end

    if next(zeros) then
        local rec = saved[addr]
        if not rec then
            rec = { t = t, prev = {} }
            saved[addr] = rec
        end
        -- keep only the first (original) value of each key
        for k, v in prev do
            if rec.prev[k] == nil then rec.prev[k] = v end
        end
        gc.setmany(t, zeros, { SameType = true })
    end
end

local function restore(saved)
    for _, rec in saved do
        gc.setmany(rec.t, rec.prev, { SameType = true })
    end
end

local function enable(f)
    f.undos = {}
    local keep = f.slider and 1 or 5
    for _, values in f.sets do
        local _, _, _, undo = gc.set(values, { Keep = keep })
        table.insert(f.undos, undo)
    end
    if f.recoil then
        f.saved = {}
        f.nextPass = 0
    end
end

local function disable(f)
    if f.undos then
        for _, undo in f.undos do undo() end
        f.undos = nil
    end
    if f.saved then
        restore(f.saved)
        f.saved = nil
    end
end

-- Gun data tables hold a `recoil` sub-table of 16 spring tables; rescan to catch new guns
local function recoilPass(cf)
    local seen, n, found = {}, 0, 0
    for _, t in gc.find({ "recoil", "hipfirespread" }) do
        found += 1
        local sub = t.recoil
        if gc.isremote(sub) and gc.typeof(sub) == "table" then
            for k, v in sub do
                if gc.isremote(v) and gc.typeof(v) == "table" and not string.find(tostring(k), "Recovery") then
                    zeroTable(v, 3, cf.saved, seen)
                end
            end
        end
        n += 1
        if n % 20 == 0 then task.wait() end
    end
    -- nothing found (gc busy / guns not loaded yet) -> retry soon instead of waiting 10 s
    cf.nextPass = clock() + (found == 0 and 1 or 10)
end

-- Menu: UI library requires ui:update() in PostLocal and ui:render() in Render
local ui = UI.new({ Title = "SEVERE | PF", Key = "RightShift", Width = 260, X = 200, Y = 100,
    Stat = { Label = "GC", Value = function()
        if applying then return "applying" end
        local n = 0
        for _ in pending do n += 1 end
        if n > 0 then return "wait " .. n end
        return "idle"
    end },
})

local tab = ui:tab("Gun mods")
for i, f in features do
    tab:toggle({ Name = f.name, Flag = f.name, Default = i == 1, OnChange = onToggle })
    if f.slider then
        tab:slider({ Name = "AIM WALK MULT", Flag = "aimwalkspeedmult", Store = aimWalk,
            Min = 1, Max = 4, Step = 0.1, Suffix = "x", Default = 2,
            Show = function() return ui.Flags[f.name] == true end })
    end
end

-- "Unlock guns + attachments" is on by default: queue it for the first batch
pending[features[1]] = true
lastChange = 0

local connLocal = RunService.PostLocal:Connect(function() ui:update() end)
local connRender = RunService.Render:Connect(function() ui:render() end)

-- Worker: waits until clicks stop for DEBOUNCE seconds, then applies the whole batch in one pass
task.spawn(function()
    while running do
        if next(pending) and clock() - lastChange >= DEBOUNCE then
            local batch = pending
            pending = {}
            applying = true
            -- recoil first and scanned right away, before the Keep loops of other features start loading gc
            for _, f in features do
                local want = batch[f]
                if f.recoil and want ~= nil and want ~= (f.on == true) then
                    f.on = want
                    if want then
                        enable(f)
                        recoilPass(f)
                    else
                        disable(f)
                    end
                end
            end
            for _, f in features do
                local want = batch[f]
                -- on->off->on within the window is a net no-op, skipped here
                if not f.recoil and want ~= nil and want ~= (f.on == true) then
                    f.on = want
                    if want then enable(f) else disable(f) end
                end
            end
            applying = false
        end

        for _, cf in features do
            if cf.on and cf.saved and clock() >= cf.nextPass then
                recoilPass(cf)
            end
        end

        task.wait(0.05)
    end
end)

G.PF_Cleanup = function()
    running = false
    connLocal:Disconnect()
    connRender:Disconnect()
    ui:destroy()
    for _, f in features do
        if f.undos then
            for _, undo in f.undos do undo() end
        end
        if f.saved then restore(f.saved) end
    end
end
