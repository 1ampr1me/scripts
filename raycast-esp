--!strict
--!optimize 2

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local CONFIG = table.freeze({
	MaxDistance = 500, -- studs: players, parts and terrain chunks farther than this are ignored
	CacheInterval = 4, -- seconds between part cache rebuilds in instance mode (GetDescendants is expensive)
	UseWorldScan = true, -- read parts from the world primitive array; falls back to instance mode if verification fails
	WorldScanInterval = 1.5, -- seconds between part cache rebuilds in world mode
	MaxPrimitives = 300000,
	MaxPartSize = 4096, -- parts larger than this on any axis are ignored (terrain-sized primitives)
	CharacterPartMaxRadiusSq = 400, -- only parts smaller than this are tested for character ownership
	LogicInterval = 0.03, -- seconds between visibility checks
	MaxTransparency = 0.8, -- parts more transparent than this do not block the ray
	TextSize = 14,
	NameOffset = vector.create(0, 2.5, 0), -- world-space offset of the label above the head
	NamePixelOffset = 14, -- extra screen-space pixels upward, keeps the text off the body at long range
	TeamCheck = true, -- hide players on the local player's team

	UseTerrain = true,
	TerrainInterval = 0.1, -- seconds between terrain checks per player (the expensive part)
	TerrainScanInterval = 3, -- seconds between terrain rescans, counted from the end of the previous one
	TerrainScanTimeout = 20, -- a scan that never finishes (error) is retried after this many seconds
	SliceBudget = 0.002, -- seconds of scan work before a scan task yields with task.wait()
	MaxTerrainChunks = 600,
	MaxMeshBytes = 4 * 1024 * 1024,
})

-- Offsets from the user's dump. Entries marked "assumed" are not in the dump.
local OFF = table.freeze({
	TerrainPrimitive = 0x178,
	PrimitiveGeometry = 0x210,
	GeometryChunkMap = 0xA0,
	MapHead = 0x08,
	MapCount = 0x10,
	ClumpNext = 0x00,
	ClumpStates = 0x24, -- assumed: 64 state bytes, one per chunk slot (0x24 .. 0x68)
	ClumpRecords = 0x68,
	RecordSize = 0x10,
	RecordMesh = 0x08,
	MeshShape = 0x10,
	ShapeIndices = 0x38,
	ShapeTriangleCount = 0x40, -- from charm's ChunkMeshShape notes: triangle count, index count = count * 3
	ShapeVertices = 0x58,
	ShapeVerticesAlt = 0x20, -- charm's layout: pointer to tightly packed world-space float3 vertices
	ShapeVertexStride = 0x70,
	ShapeIndexStride = 0x78,
	ShapeBounds = 0xA0, -- min at +0, max at +12
})

-- Offsets from theo's dump (version-5a21b87bbc2641cf) plus instance_back from the shape dump
local WORLD = table.freeze({
	WorkspaceWorld = 1016,
	WorldPrimitives = 672, -- assumed: pointer to an array of Primitive pointers
	DataModelPrimitiveCount = 1040, -- assumed: element count of that array
	BasePartPrimitive = 376,
	PrimitiveRotation = 176, -- 9 floats; position follows right after at 212
	PrimitivePosition = 212,
	PrimitiveSize = 452,
	PrimitiveInstance = 0x218, -- back pointer from a primitive to its part instance
	BasePartTransparency = 280,
})

local VISIBLE: Color3 = Color3.fromRGB(0, 255, 0)
local HIDDEN: Color3 = Color3.fromRGB(255, 0, 0)

local CACHEABLE = table.freeze({ Part = true, MeshPart = true, UnionOperation = true })

type Box = {
	pos: vector,
	right: vector,
	up: vector,
	look: vector,
	half: vector,
	radiusSq: number,
}

type Chunk = {
	shape: number,
	tri: number,
	center: vector,
	half: vector,
	vb: buffer,
	ib: buffer,
	vBytes: number,
	iBytes: number,
	vStride: number,
	iStride: number,
}

type Entry = { name: string, pos: vector, color: Color3 }

local readf32, readu16, readu32 = buffer.readf32, buffer.readu16, buffer.readu32

local LocalPlayer = Players.LocalPlayer :: Player
local boxes: { Box } = {}
local chunks: { Chunk } = {}
local chunkCache: { [number]: Chunk } = {} -- by shape address, reused between rescans
local terrainResult: { [Player]: { time: number, blocked: boolean } } = {}
local snapshot: { Entry } = {} -- written in PostLocal, read in Render
local lastParts: number = 0
local nextTerrain: number = 0
local lastLogic: number = 0
local terrainLayout: number = 0 -- index into VERTEX_LAYOUTS once one has been verified
local worldState: "unknown" | "ok" | "failed" = "unknown"
local worldColMajor: boolean = false -- detected during calibration

local function getHead(player: Player): BasePart?
	local character = player.Character
	if not character then return nil end
	return character:FindFirstChild("Head") :: BasePart?
end

local function getCameraPos(): vector?
	local camera = workspace.CurrentCamera
	if not camera then return nil end
	return camera.CFrame.Position
end

local function validPtr(p: number): boolean
	return p > 0x10000 and p < 0x800000000000
end

-- Instance.Data is the hex address string of the instance
local function addressOf(inst: Instance): number?
	return tonumber(inst.Data) or tonumber(inst.Data, 16)
end

-- Yields once the current slice of work exceeds the budget; returns the start of the next slice
local function pace(slice: number): number
	if os.clock() - slice < CONFIG.SliceBudget then return slice end
	task.wait()
	return os.clock()
end

local function getCharacters(): { Instance }
	local characters: { Instance } = {}
	for _, obj in Players:GetChildren() do
		local character = (obj :: Player).Character
		if character then characters[#characters + 1] = character end
	end
	return characters
end

-- Instance mode: walks Workspace descendants; one synchronous pass, so nothing can go stale mid-scan
local function rebuildFromInstances(origin: vector, characters: { Instance })
	local maxSq: number = CONFIG.MaxDistance * CONFIG.MaxDistance
	local list: { Box } = {}

	for _, inst in workspace:GetDescendants() do
		if not CACHEABLE[inst.ClassName] then continue end
		local part = inst :: BasePart
		if part.Transparency >= CONFIG.MaxTransparency then continue end

		local offset: vector = part.Position - origin
		if vector.dot(offset, offset) > maxSq then continue end

		local half: vector = part.Size * 0.5
		local radiusSq: number = vector.dot(half, half)

		-- Large parts cannot be character parts, so they skip the ancestry check
		if radiusSq < CONFIG.CharacterPartMaxRadiusSq then
			local owned = false
			for _, character in characters do
				if part:IsDescendantOf(character) then
					owned = true
					break
				end
			end
			if owned then continue end
		end

		list[#list + 1] = {
			pos = part.Position,
			right = part.RightVector,
			up = part.UpVector,
			look = part.LookVector,
			half = half,
			radiusSq = radiusSq,
		}
	end

	boxes = list
end

-- Returns the world primitive array pointer and element count, or nil if the pointers look wrong
local function loadPrimitiveList(): (number?, number)
	local workspaceAddr = addressOf(workspace)
	local gameAddr = addressOf(game)
	if not workspaceAddr or not gameAddr then return nil, 0 end

	local world = memory.readu64(workspaceAddr + WORLD.WorkspaceWorld)
	if not validPtr(world) then return nil, 0 end
	local array = memory.readu64(world + WORLD.WorldPrimitives)
	local count = memory.readu32(gameAddr + WORLD.DataModelPrimitiveCount)
	if not validPtr(array) or count < 1 or count > CONFIG.MaxPrimitives then return nil, 0 end
	return array, count
end

-- Checks the offsets against the local HumanoidRootPart and detects the matrix layout.
-- true = verified, false = offsets do not match, nil = no character yet, try again later
local function calibrate(array: number, count: number): boolean?
	local character = LocalPlayer.Character
	if not character then return nil end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end

	local rootAddr = addressOf(root)
	if not rootAddr then return false end
	local prim = memory.readu64(rootAddr + WORLD.BasePartPrimitive)
	if not validPtr(prim) then return false end

	-- The primitive must be listed in the world array
	local list = memory.readbuffer(array, count * 8)
	local found = false
	for i = 0, count - 1 do
		if readu32(list, i * 8) + readu32(list, i * 8 + 4) * 4294967296 == prim then
			found = true
			break
		end
	end
	if not found then return false end

	-- Back pointer, position and size must match the real instance
	if memory.readu64(prim + WORLD.PrimitiveInstance) ~= rootAddr then return false end
	local posDiff = memory.readvector(prim + WORLD.PrimitivePosition) - root.Position
	if vector.dot(posDiff, posDiff) > 25 then return false end
	local sizeDiff = memory.readvector(prim + WORLD.PrimitiveSize) - root.Size
	if vector.dot(sizeDiff, sizeDiff) > 0.01 then return false end

	-- Pick the matrix layout whose right/up axes match the real CFrame
	local m = memory.readbuffer(prim + WORLD.PrimitiveRotation, 36)
	local cf = root.CFrame
	local rowScore = math.abs(vector.dot(vector.create(readf32(m, 0), readf32(m, 12), readf32(m, 24)), cf.RightVector))
		+ math.abs(vector.dot(vector.create(readf32(m, 4), readf32(m, 16), readf32(m, 28)), cf.UpVector))
	local colScore = math.abs(vector.dot(vector.create(readf32(m, 0), readf32(m, 4), readf32(m, 8)), cf.RightVector))
		+ math.abs(vector.dot(vector.create(readf32(m, 12), readf32(m, 16), readf32(m, 20)), cf.UpVector))
	if math.max(rowScore, colScore) < 1.8 then return false end

	worldColMajor = colScore > rowScore
	return true
end

-- World mode: reads every primitive near the origin straight from memory, in one synchronous pass
local function rebuildFromWorld(array: number, count: number, origin: vector, characters: { Instance })
	-- Character primitives are excluded by address
	local excluded: { [number]: boolean } = {}
	for _, character in characters do
		for _, inst in character:GetDescendants() do
			if not CACHEABLE[inst.ClassName] then continue end
			local addr = addressOf(inst)
			if addr then excluded[memory.readu64(addr + WORLD.BasePartPrimitive)] = true end
		end
	end
	local terrain = workspace:FindFirstChild("Terrain")
	local terrainAddr = terrain and addressOf(terrain)
	if terrainAddr then excluded[memory.readu64(terrainAddr + WORLD.BasePartPrimitive)] = true end

	local list = memory.readbuffer(array, count * 8)
	local maxSq: number = CONFIG.MaxDistance * CONFIG.MaxDistance
	local maxSize: number = CONFIG.MaxPartSize
	local colMajor = worldColMajor
	local out: { Box } = {}

	for i = 0, count - 1 do
		local prim = readu32(list, i * 8) + readu32(list, i * 8 + 4) * 4294967296
		if excluded[prim] or not validPtr(prim) then continue end

		-- Distance test first; the comparison form also rejects NaN
		local offset = memory.readvector(prim + WORLD.PrimitivePosition) - origin
		if not (vector.dot(offset, offset) <= maxSq) then continue end

		local size = memory.readvector(prim + WORLD.PrimitiveSize)
		if not (size.x <= maxSize and size.y <= maxSize and size.z <= maxSize) then continue end

		-- Transparency lives on the part instance
		local inst = memory.readu64(prim + WORLD.PrimitiveInstance)
		if not validPtr(inst) or memory.readf32(inst + WORLD.BasePartTransparency) >= CONFIG.MaxTransparency then
			continue
		end

		local m = memory.readbuffer(prim + WORLD.PrimitiveRotation, 36)
		local right: vector, up: vector, look: vector
		if colMajor then
			right = vector.create(readf32(m, 0), readf32(m, 4), readf32(m, 8))
			up = vector.create(readf32(m, 12), readf32(m, 16), readf32(m, 20))
			look = vector.create(readf32(m, 24), readf32(m, 28), readf32(m, 32))
		else
			right = vector.create(readf32(m, 0), readf32(m, 12), readf32(m, 24))
			up = vector.create(readf32(m, 4), readf32(m, 16), readf32(m, 28))
			look = vector.create(readf32(m, 8), readf32(m, 20), readf32(m, 32))
		end

		local half: vector = size * 0.5
		out[#out + 1] = {
			pos = origin + offset,
			right = right,
			up = up,
			look = look,
			half = half,
			radiusSq = vector.dot(half, half),
		}
	end

	boxes = out
end

local function rebuildCache(origin: vector)
	local characters = getCharacters()

	if CONFIG.UseWorldScan and worldState ~= "failed" then
		local array, count = loadPrimitiveList()
		if array then
			if worldState == "unknown" then
				local verdict = calibrate(array, count)
				if verdict == true then
					worldState = "ok"
				elseif verdict == false then
					worldState = "failed"
				end
			end
			if worldState == "ok" then
				rebuildFromWorld(array, count, origin, characters)
				return
			end
		end
	end

	rebuildFromInstances(origin, characters)
end

-- Clips the ray interval [t0, t1] against one slab; a miss leaves t0 > t1
local function clip(o: number, d: number, h: number, t0: number, t1: number): (number, number)
	if math.abs(d) < 1e-6 then
		if o < -h or o > h then return 1, 0 end
		return t0, t1
	end
	local a = (-h - o) / d
	local b = (h - o) / d
	if a > b then a, b = b, a end
	return math.max(t0, a), math.min(t1, b)
end

-- True if any cached part box lies between origin and target
local function blockedByParts(origin: vector, seg: vector, len: number, dir: vector): boolean
	for _, box in boxes do
		-- Cheap prefilter: closest point of the segment to the box center
		local t = math.clamp(vector.dot(box.pos - origin, dir), 0, len)
		local diff = box.pos - (origin + dir * t)
		if vector.dot(diff, diff) > box.radiusSq then continue end

		-- Slab test in the box's local space, ray parameter in [0, 1]
		local rel = origin - box.pos
		local t0, t1 = 0, 1
		t0, t1 = clip(vector.dot(rel, box.right), vector.dot(seg, box.right), box.half.x, t0, t1)
		t0, t1 = clip(vector.dot(rel, box.up), vector.dot(seg, box.up), box.half.y, t0, t1)
		t0, t1 = clip(vector.dot(rel, box.look), vector.dot(seg, box.look), box.half.z, t0, t1)

		-- t0 == 0 means the origin is inside the box, which is not treated as blocking
		if t0 > 0 and t0 <= t1 then return true end
	end
	return false
end

-- Stored chunk bounds can be tighter than the real surface by 16+ studs (charm notes), so compare loosely
local BOUNDS_TOLERANCE: number = 48

-- Two known vertex layouts: this dump (pointer + stride fields) and the older fixed float3 one
local VERTEX_LAYOUTS = table.freeze({
	table.freeze({ ptr = OFF.ShapeVertices, strideField = OFF.ShapeVertexStride, stride = 0 }),
	table.freeze({ ptr = OFF.ShapeVerticesAlt, strideField = 0, stride = 12 }),
})

-- Reads one chunk with a given vertex layout; vertices must be world-space and match the stored bounds
local function readChunk(
	shape: number,
	layout: { ptr: number, strideField: number, stride: number },
	triCount: number,
	mn: vector,
	mx: vector
): Chunk?
	local vPtr = memory.readu64(shape + layout.ptr)
	local iPtr = memory.readu64(shape + OFF.ShapeIndices)
	if not validPtr(vPtr) or not validPtr(iPtr) then return nil end

	local vStride = if layout.stride > 0 then layout.stride else memory.readu32(shape + layout.strideField)
	local iStride = memory.readu32(shape + OFF.ShapeIndexStride)
	if vStride < 12 or vStride > 64 or (iStride ~= 2 and iStride ~= 4) then return nil end

	-- Cheap check on the first vertex before any bulk read
	local tol = BOUNDS_TOLERANCE
	local first = memory.readvector(vPtr)
	if not (
		first.x >= mn.x - tol and first.x <= mx.x + tol
		and first.y >= mn.y - tol and first.y <= mx.y + tol
		and first.z >= mn.z - tol and first.z <= mx.z + tol
	) then
		return nil
	end

	local iBytes = triCount * 3 * iStride
	if iBytes > CONFIG.MaxMeshBytes then return nil end
	local ib = memory.readbuffer(iPtr, iBytes)

	-- The vertex count is derived from the largest index, so no vertex end pointer is needed
	local read = if iStride == 4 then readu32 else readu16
	local maxIndex = 0
	for p = 0, iBytes - iStride, iStride do
		local v = read(ib, p)
		if v > maxIndex then maxIndex = v end
	end
	local vBytes = (maxIndex + 1) * vStride
	if vBytes > CONFIG.MaxMeshBytes then return nil end
	local vb = memory.readbuffer(vPtr, vBytes)

	-- Tight bounds from the vertices, which also verify the layout
	local loX, loY, loZ = math.huge, math.huge, math.huge
	local hiX, hiY, hiZ = -math.huge, -math.huge, -math.huge
	for p = 0, vBytes - vStride, vStride do
		local x, y, z = readf32(vb, p), readf32(vb, p + 4), readf32(vb, p + 8)
		if x < loX then loX = x end
		if y < loY then loY = y end
		if z < loZ then loZ = z end
		if x > hiX then hiX = x end
		if y > hiY then hiY = y end
		if z > hiZ then hiZ = z end
	end
	if not (
		math.abs(loX - mn.x) <= tol and math.abs(loY - mn.y) <= tol and math.abs(loZ - mn.z) <= tol
		and math.abs(hiX - mx.x) <= tol and math.abs(hiY - mx.y) <= tol and math.abs(hiZ - mx.z) <= tol
	) then
		return nil
	end

	local lo, hi = vector.create(loX, loY, loZ), vector.create(hiX, hiY, hiZ)
	return {
		shape = shape,
		tri = triCount,
		center = (lo + hi) * 0.5,
		half = (hi - lo) * 0.5,
		vb = vb,
		ib = ib,
		vBytes = vBytes,
		iBytes = iBytes,
		vStride = vStride,
		iStride = iStride,
	}
end

-- Loads one terrain chunk mesh into buffers; nil if it is out of range or fails sanity checks
local function loadChunk(shape: number, origin: vector, maxSq: number): Chunk?
	local mn = memory.readvector(shape + OFF.ShapeBounds)
	local mx = memory.readvector(shape + OFF.ShapeBounds + 12)
	-- Comparison form also rejects NaN
	if not (mx.x > mn.x and mx.y > mn.y and mx.z > mn.z) then return nil end
	if mx.x - mn.x > 4096 or mx.y - mn.y > 4096 or mx.z - mn.z > 4096 then return nil end

	local dx = math.max(mn.x - origin.x, 0, origin.x - mx.x)
	local dy = math.max(mn.y - origin.y, 0, origin.y - mx.y)
	local dz = math.max(mn.z - origin.z, 0, origin.z - mx.z)
	if dx * dx + dy * dy + dz * dz > maxSq then return nil end

	local triCount = memory.readu32(shape + OFF.ShapeTriangleCount)
	if triCount < 1 or triCount > 200000 then return nil end

	local cached = chunkCache[shape]
	if cached and cached.tri == triCount then return cached end

	if terrainLayout ~= 0 then
		return readChunk(shape, VERTEX_LAYOUTS[terrainLayout], triCount, mn, mx)
	end
	for i, layout in VERTEX_LAYOUTS do
		local chunk = readChunk(shape, layout, triCount, mn, mx)
		if chunk then
			terrainLayout = i
			return chunk
		end
	end
	return nil
end

-- Walks the clump list and reloads nearby chunk meshes; runs in a task and yields between chunks
local function scanTerrain(origin: vector)
	local terrain = workspace:FindFirstChild("Terrain")
	if not terrain then return end
	local base = addressOf(terrain)
	if not base then return end

	local primitive = memory.readu64(base + OFF.TerrainPrimitive)
	if not validPtr(primitive) then return end
	local geometry = memory.readu64(primitive + OFF.PrimitiveGeometry)
	if not validPtr(geometry) then return end

	local map = geometry + OFF.GeometryChunkMap
	local count = memory.readu64(map + OFF.MapCount)
	if count < 1 or count > 1e6 then
		-- chunk_map may be stored by pointer instead of inline
		map = memory.readu64(map)
		if not validPtr(map) then return end
		count = memory.readu64(map + OFF.MapCount)
		if count < 1 or count > 1e6 then return end
	end

	local head = memory.readu64(map + OFF.MapHead)
	if not validPtr(head) then return end
	local clump = memory.readu64(head + OFF.ClumpNext)

	local maxSq = CONFIG.MaxDistance * CONFIG.MaxDistance
	local list: { Chunk } = {}
	local cache: { [number]: Chunk } = {}
	local slice = os.clock()

	-- The list may be circular (ends at head) or null-terminated
	while count > 0 and validPtr(clump) and clump ~= head and #list < CONFIG.MaxTerrainChunks do
		local states = memory.readbuffer(clump + OFF.ClumpStates, 64)
		for slot = 0, 63 do
			if buffer.readu8(states, slot) == 0 then continue end
			local mesh = memory.readu64(clump + OFF.ClumpRecords + slot * OFF.RecordSize + OFF.RecordMesh)
			if not validPtr(mesh) then continue end
			local shape = memory.readu64(mesh + OFF.MeshShape)
			if not validPtr(shape) then continue end

			local chunk = loadChunk(shape, origin, maxSq)
			if chunk then
				list[#list + 1] = chunk
				cache[shape] = chunk
			end
			slice = pace(slice)
		end

		count -= 1
		clump = memory.readu64(clump + OFF.ClumpNext)
	end

	chunks = list
	chunkCache = cache
end

-- Segment vs triangle mesh (Moller-Trumbore, double sided), ray parameter in (0, 1)
local function segmentHitsChunk(chunk: Chunk, o: vector, seg: vector): boolean
	local vb, ib, vs = chunk.vb, chunk.ib, chunk.vStride
	local wide = chunk.iStride == 4
	local maxA = chunk.vBytes - 12
	local ox, oy, oz = o.x, o.y, o.z
	local dx, dy, dz = seg.x, seg.y, seg.z
	local step = chunk.iStride

	for p = 0, chunk.iBytes - step * 3, step * 3 do
		local a, b, c
		if wide then
			a, b, c = readu32(ib, p) * vs, readu32(ib, p + 4) * vs, readu32(ib, p + 8) * vs
		else
			a, b, c = readu16(ib, p) * vs, readu16(ib, p + 2) * vs, readu16(ib, p + 4) * vs
		end
		if a > maxA or b > maxA or c > maxA then continue end

		local ax, ay, az = readf32(vb, a), readf32(vb, a + 4), readf32(vb, a + 8)
		local e1x, e1y, e1z = readf32(vb, b) - ax, readf32(vb, b + 4) - ay, readf32(vb, b + 8) - az
		local e2x, e2y, e2z = readf32(vb, c) - ax, readf32(vb, c + 4) - ay, readf32(vb, c + 8) - az

		local px = dy * e2z - dz * e2y
		local py = dz * e2x - dx * e2z
		local pz = dx * e2y - dy * e2x
		local det = e1x * px + e1y * py + e1z * pz
		if det > -1e-9 and det < 1e-9 then continue end

		local inv = 1 / det
		local tx, ty, tz = ox - ax, oy - ay, oz - az
		local u = (tx * px + ty * py + tz * pz) * inv
		if u < 0 or u > 1 then continue end

		local qx = ty * e1z - tz * e1y
		local qy = tz * e1x - tx * e1z
		local qz = tx * e1y - ty * e1x
		local v = (dx * qx + dy * qy + dz * qz) * inv
		if v < 0 or u + v > 1 then continue end

		local t = (e2x * qx + e2y * qy + e2z * qz) * inv
		if t > 1e-4 and t < 1 then return true end
	end
	return false
end

local function blockedByTerrain(origin: vector, seg: vector): boolean
	for _, chunk in chunks do
		-- Only chunks whose bounds the segment crosses are tested triangle by triangle
		local rel = origin - chunk.center
		local t0, t1 = 0, 1
		t0, t1 = clip(rel.x, seg.x, chunk.half.x, t0, t1)
		t0, t1 = clip(rel.y, seg.y, chunk.half.y, t0, t1)
		t0, t1 = clip(rel.z, seg.z, chunk.half.z, t0, t1)
		if t0 > t1 then continue end

		if segmentHitsChunk(chunk, origin, seg) then return true end
	end
	return false
end

local function runTerrainScan(origin: vector)
	scanTerrain(origin)
	nextTerrain = os.clock() + CONFIG.TerrainScanInterval
end

-- Parts are rebuilt inline; the terrain scan runs as a finite task that yields between chunks
RunService.PostModel:Connect(function()
	local origin = getCameraPos()
	if not origin then return end
	local now = os.clock()

	local interval: number = if worldState == "ok" then CONFIG.WorldScanInterval else CONFIG.CacheInterval
	if now - lastParts >= interval then
		lastParts = now
		rebuildCache(origin)
	end

	-- nextTerrain is pushed far ahead while a scan runs, so scans never pile up or get stuck
	if CONFIG.UseTerrain and now >= nextTerrain then
		nextTerrain = now + CONFIG.TerrainScanTimeout
		task.spawn(runTerrainScan, origin)
	end
end)

RunService.PostLocal:Connect(function()
	local now = os.clock()
	if now - lastLogic < CONFIG.LogicInterval then return end
	lastLogic = now

	local origin = getCameraPos()
	if not origin then
		snapshot = {}
		return
	end

	local maxSq = CONFIG.MaxDistance * CONFIG.MaxDistance
	local list: { Entry } = {}
	local myTeam = if CONFIG.TeamCheck then LocalPlayer.Team else nil

	for _, obj in Players:GetChildren() do
		local player = obj :: Player
		if player == LocalPlayer then continue end
		if myTeam and player.Team == myTeam then continue end

		local head = getHead(player)
		if not head then continue end

		local pos = head.Position
		local seg = pos - origin
		local lenSq = vector.dot(seg, seg)
		if lenSq > maxSq then continue end

		local blocked = false
		if lenSq > 1e-8 then
			local len = math.sqrt(lenSq)
			blocked = blockedByParts(origin, seg, len, seg / len)

			if not blocked and CONFIG.UseTerrain then
				local cached = terrainResult[player]
				if not cached or now - cached.time >= CONFIG.TerrainInterval then
					cached = { time = now, blocked = blockedByTerrain(origin, seg) }
					terrainResult[player] = cached
				end
				blocked = cached.blocked
			end
		end

		list[#list + 1] = {
			name = player.Name,
			pos = pos + CONFIG.NameOffset,
			color = if blocked then HIDDEN else VISIBLE,
		}
	end

	snapshot = list
end)

RunService.Render:Connect(function()
	local camera = workspace.CurrentCamera
	if not camera then return end

	for _, entry in snapshot do
		local screen, onScreen = camera:WorldToScreenPoint(entry.pos)
		if onScreen then
			local labelPos = vector.create(screen.x, screen.y - CONFIG.NamePixelOffset, screen.z)
			DrawingImmediate.OutlinedText(labelPos, CONFIG.TextSize, entry.color, 1, entry.name, true, "Tamzen")
		end
	end
end)
