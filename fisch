local KEY_CODES: { [string]: number } = {
	RightShift = 0xA1,
	LeftShift = 0xA0,
	RightControl = 0xA3,
	LeftControl = 0xA2,
	RightAlt = 0xA5,
	LeftAlt = 0xA4,
	Return = 0x0D,
	Enter = 0x0D,
	Space = 0x20,
	Tab = 0x09,
	Escape = 0x1B,
	Insert = 0x2D,
	Delete = 0x2E,
	Home = 0x24,
	End = 0x23,
	PageUp = 0x21,
	PageDown = 0x22,
}
for i = 0, 25 do
	KEY_CODES[string.char(65 + i)] = 65 + i
end
for i = 0, 9 do
	KEY_CODES[tostring(i)] = 48 + i
end
for i = 1, 12 do
	KEY_CODES["F" .. i] = 0x6F + i
end
table.freeze(KEY_CODES)

local function keyDown(keys: { any }, spec: any): boolean
	if type(spec) == "table" then
		for _, one in spec do
			if table.find(keys, one) ~= nil then
				return true
			end
			local code = if type(one) == "string" then KEY_CODES[one] else nil
			if code ~= nil and table.find(keys, code) ~= nil then
				return true
			end
		end
		return false
	end
	if table.find(keys, spec) ~= nil then
		return true
	end
	local code = if type(spec) == "string" then KEY_CODES[spec] else nil
	return code ~= nil and table.find(keys, code) ~= nil
end

local function keyLabel(spec: any): string
	if type(spec) == "table" then
		for _, one in spec do
			if type(one) == "string" then
				return one
			end
		end
		return "?"
	end
	if type(spec) == "number" then
		return string.format("0x%02X", spec)
	end
	if spec == "RightShift" then
		return "RShift"
	elseif spec == "LeftShift" then
		return "LShift"
	end
	return tostring(spec)
end

local function inRect(px: number, py: number, x: number, y: number, w: number, h: number): boolean
	return px >= x and px <= x + w and py >= y and py <= y + h
end

local function shortLabel(s: string, maxLen: number): string
	if #s > maxLen then
		return string.sub(s, 1, maxLen - 1) .. "."
	end
	return s
end

-- Queues a callback; it runs in the next ui:update() (PostLocal), not in Render.
local function push(ui: any, fn: any, a: any, b: any): ()
	local n = ui.QN + 1
	ui.QN = n
	ui.QFn[n] = fn
	ui.QA[n] = a
	ui.QB[n] = b
end

-- Immediate mode has no rounding: corners are built from rectangles (small radii) or circles (large ones).
local function RoundRect(x: number, y: number, w: number, h: number, r: number, color: Color3): ()
	if r <= 3 then
		DrawingImmediate.FilledRectangle(vec(x + 1, y, 0), vec(w - 2, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + 1, 0), vec(w, h - 2, 0), color, 1)
		return
	end
	if r <= 6 then
		local i1 = floor(r * 0.6 + 0.5)
		local i2 = math.max(1, floor(r * 0.25 + 0.5))
		local t = floor(r * 0.6)
		DrawingImmediate.FilledRectangle(vec(x + i1, y, 0), vec(w - 2 * i1, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x + i2, y + 1, 0), vec(w - 2 * i2, h - 2, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + t, 0), vec(w, h - 2 * t, 0), color, 1)
		return
	end
	DrawingImmediate.FilledRectangle(vec(x + r, y, 0), vec(w - 2 * r, h, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x + w - r, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + h - r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + h - r, 0), r, color, 1)
end

local function DrawPill(x: number, y: number, w: number, h: number, on: boolean): ()
	RoundRect(x, y, w, h, 5, if on then T.PillLine else T.PillLineOff)
	RoundRect(x + 1, y + 1, w - 2, h - 2, 4, if on then T.PillBg else T.PillBgOff)
	local knob = 10
	local kx = if on then (x + w - knob - 4) else (x + 4)
	RoundRect(kx, y + (h - knob) / 2, knob, knob, 3, if on then T.Knob else T.KnobOff)
end

local function DrawToggleRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	enabled: boolean,
	clicked: boolean,
	mp: vector,
	swatch: Color3?
): boolean
	local labelX = x + 10
	if swatch then
		DrawingImmediate.FilledRectangle(vec(x + 10, y + h / 2 - 3, 0), vec(6, 6, 0), swatch, 1)
		labelX = x + 22
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 13, if enabled then T.TextRow else T.TextOff, 1, label, false)
	DrawPill(x + w - 32 - 10, y + (h - 18) / 2, 32, 18, enabled)
	return clicked and inRect(mp.x, mp.y, x, y, w, h)
end

local function DrawActionRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	btnText: string,
	clicked: boolean,
	mp: vector
): boolean
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextRow, 1, label, false)
	local bw = 64
	local bh = 18
	local bx = x + w - bw - 10
	local by = y + (h - bh) / 2
	local hover = inRect(mp.x, mp.y, bx, by, bw, bh)
	RoundRect(bx, by, bw, bh, 5, T.PillLine)
	RoundRect(bx + 1, by + 1, bw - 2, bh - 2, 4, if hover then T.PillLine else T.PillBg)
	DrawingImmediate.Text(vec(bx + bw / 2, by + 3, 0), 12, T.TextMain, 1, btnText, true)
	return clicked and hover
end

local function DrawChip(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	on: boolean?,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	RoundRect(x, y, w, h, 5, if hover then T.PillLine else T.Chip)
	local labelX = x + 10
	if on ~= nil then
		DrawingImmediate.FilledRectangle(vec(x + 8, y + h / 2 - 3, 0), vec(6, 6, 0), if on then T.Knob else T.PillLineOff, 1)
		labelX = x + 20
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 11, if on == false then T.TextOff else T.TextRow, 1, label, false)
	return clicked and hover
end

local function DrawDropdownHeader(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	countText: string,
	open: boolean,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	if hover or open then
		RoundRect(x, y, w, h, 6, T.Chip)
	end
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextMain, 1, label, false)
	DrawingImmediate.Text(vec(x + w - 46, y + h / 2 - 6, 0), 12, T.TextDim, 1, countText, true)
	local cx = x + w - 16
	local cy = y + h / 2
	if open then
		DrawingImmediate.FilledTriangle(vec(cx - 5, cy - 3, 0), vec(cx + 5, cy - 3, 0), vec(cx, cy + 3, 0), T.Knob, 1)
	else
		DrawingImmediate.FilledTriangle(vec(cx - 3, cy - 5, 0), vec(cx - 3, cy + 5, 0), vec(cx + 3, cy, 0), T.Knob, 1)
	end
	return clicked and hover
end

local function DrawSliderRow(ui: any, el: any, x: number, y: number, w: number, value: number, clicked: boolean, ldown: boolean, mp: vector): number
	local minV: number = el.Min
	local maxV: number = el.Max
	local step: number = el.Step
	DrawingImmediate.Text(vec(x + 10, y + 9, 0), 11, T.TextDim, 1, el.Name, false)
	RoundRect(x + w - 55, y + 9, 45, 14, 4, T.Chip)
	DrawingImmediate.Text(vec(x + w - 32.5, y + 10, 0), 11, T.TextMain, 1, tostring(floor(value)) .. el.Suffix, true)

	local tX = x + 10
	local tW = w - 20
	local tC = y + 43

	if clicked and inRect(mp.x, mp.y, tX - 6, tC - 10, tW + 12, 20) then
		ui.SliderActive = el
	end
	if not ldown then
		ui.SliderActive = nil
	end
	if ui.SliderActive == el then
		local rel = math.clamp((mp.x - tX) / tW, 0, 1)
		value = floor((minV + rel * (maxV - minV)) / step + 0.5) * step
		value = math.clamp(value, minV, maxV)
	end

	RoundRect(tX, tC - 2, tW, 4, 2, T.Track)
	local frac = math.clamp((value - minV) / (maxV - minV), 0, 1)
	RoundRect(tX + floor(tW * frac) - 5, tC - 5, 10, 10, 3, T.Knob)
	return value
end

local function DrawLabel(x: number, y: number, text: string): ()
	DrawingImmediate.Text(vec(x + 18, y, 0), 11, T.TextDim, 1, text, false)
end

local function getValue(ui: any, el: any): any
	if el.Get ~= nil then
		return el.Get()
	end
	local store = el.Store or ui.Flags
	return store[el.Flag]
end

local function setValue(ui: any, el: any, value: any): ()
	if el.Set ~= nil then
		el.Set(value)
	else
		local store = el.Store or ui.Flags
		store[el.Flag] = value
	end
	if el.OnChange ~= nil then
		push(ui, el.OnChange, value, el.Flag)
	end
end

local function drawToggle(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local on = getValue(ui, el) == true
	if DrawToggleRow(ux + 8, yo, uw - 16, ROW_H, el.Label, on, clicked, mp, el.Swatch) then
		setValue(ui, el, not on)
	end
	return yo + ROW_H + el.Gap
end

local function drawAction(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	if DrawActionRow(ux + 8, yo, uw - 16, ROW_H, el.Label, el.Button, clicked, mp) and el.Callback ~= nil then
		push(ui, el.Callback, nil, nil)
	end
	return yo + ROW_H + el.Gap
end

local function setBlock(ui: any, state: boolean): ()
	ui.BlockWant = state
end

local function blur(ui: any): ()
	if ui.Focus ~= nil then
		ui.Focus = nil
		setBlock(ui, false)
	end
end

local function focus(ui: any, el: any): ()
	ui.Focus = el
	ui.FocusAt = os.clock()
	ui.TypeDown = {}
	ui.BackDown = false
	ui.EnterDown = true
	ui.EscDown = true
	setBlock(ui, true)
end

local function drawInput(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local store = el.Store or ui.Flags
	local text: string = if type(store[el.Flag]) == "string" then store[el.Flag] else ""
	local focused = ui.Focus == el
	local bx = ux + 18
	local by = yo + 2
	local bw = uw - 36
	local bh = ROW_H - 4
	local hover = inRect(mp.x, mp.y, bx, by, bw, bh)
	if clicked then
		if hover and not focused then
			focus(ui, el)
			focused = true
		elseif not hover and focused then
			blur(ui)
			focused = false
		end
	end
	if focused then
		ui.FocusAt = os.clock()
	end
	RoundRect(bx, by, bw, bh, 5, if focused then T.PillLine else T.PillLineOff)
	RoundRect(bx + 1, by + 1, bw - 2, bh - 2, 4, T.PillBg)
	local shown = text
	local color = T.TextMain
	if text == "" and not focused then
		shown = el.Placeholder or ""
		color = T.TextOff
	end
	if #shown > 34 then
		shown = string.sub(shown, -34)
	end
	if focused and math.floor(os.clock() * 2) % 2 == 0 then
		shown ..= "|"
	end
	DrawingImmediate.Text(vec(bx + 8, by + 4, 0), 13, color, 1, shown, false)
	return yo + ROW_H + el.Gap
end

local function drawSlider(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local value: number = getValue(ui, el)
	local nextValue = DrawSliderRow(ui, el, ux + 8, yo, uw - 16, value, clicked, ui.Input.down, mp)
	if nextValue ~= value then
		setValue(ui, el, nextValue)
	end
	return yo + SLIDER_ROW_H + 9 + el.Gap
end

local function drawSection(ui: any, el: any, ux: number, yo: number, uw: number): number
	if el.Divider then
		DrawingImmediate.FilledRectangle(vec(ux + 12, yo, 0), vec(uw - 24, 1, 0), T.Divider, 1)
		DrawLabel(ux, yo + 12, el.Title)
		return yo + 30
	end
	DrawLabel(ux, yo + 2, el.Title)
	return yo + 20
end

local function drawNote(ui: any, el: any, ux: number, yo: number): number
	yo += el.Before
	local lines: { string } = el.Lines
	for i, line in lines do
		DrawLabel(ux, yo + (i - 1) * 14, line)
	end
	return yo + #lines * 14 + 6
end

local function isOpen(ui: any, el: any): boolean
	if el.Accordion ~= nil then
		return ui.Accordion[el.Accordion] == el
	end
	return ui.Open[el] == true
end

local function toggleOpen(ui: any, el: any): ()
	local open = isOpen(ui, el)
	if el.Accordion ~= nil then
		ui.Accordion[el.Accordion] = if open then nil else el
	else
		ui.Open[el] = not open
	end
end

local function drawDropdown(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local items: { any } = el.Items
	local store = el.Store or ui.Flags
	local chips = el.Layout == "chips"
	local size = #items

	local flagged = false
	local onCount = 0
	for _, item in items do
		if item.Flag ~= nil then
			flagged = true
			if store[item.Flag] == true then
				onCount += 1
			end
		end
	end
	local countText = if flagged then `{onCount}/{size}` else tostring(size)

	local open = isOpen(ui, el)
	if DrawDropdownHeader(ux + 8, yo, uw - 16, ROW_H, el.Name, countText, open, clicked, mp) then
		toggleOpen(ui, el)
	end
	yo += ROW_H
	if not open then
		return yo + el.Gap
	end
	yo += DROP_TOP_GAP

	if el.All ~= nil and flagged then
		local allOn = onCount == size
		if DrawToggleRow(ux + 16, yo, uw - 32, DROP_ROW_H, el.All, allOn, clicked, mp, T.White) then
			for _, item in items do
				store[item.Flag] = not allOn
			end
			if el.OnChange ~= nil then
				push(ui, el.OnChange, nil, not allOn)
			end
		end
		yo += DROP_ROW_H + DROP_GAP + (if chips then 2 else 0)
	end

	if chips then
		local cw = (uw - 32 - CHIP_GAP) / 2
		for i, item in items do
			local col = (i - 1) % 2
			local row = floor((i - 1) / 2)
			local cx = ux + 16 + col * (cw + CHIP_GAP)
			local cy = yo + row * (CHIP_H + CHIP_GAP)
			local label = shortLabel(item.Name, el.MaxLabel)
			if item.Flag ~= nil then
				local on = store[item.Flag] == true
				if DrawChip(cx, cy, cw, CHIP_H, label, on, clicked, mp) then
					store[item.Flag] = not on
					if el.OnChange ~= nil then
						push(ui, el.OnChange, item.Flag, not on)
					end
				end
			elseif DrawChip(cx, cy, cw, CHIP_H, label, nil, clicked, mp) and item.Callback ~= nil then
				push(ui, item.Callback, item, nil)
			end
		end
		yo += floor((size + 1) / 2) * (CHIP_H + CHIP_GAP) + 4
	else
		for _, item in items do
			local on = store[item.Flag] == true
			if DrawToggleRow(ux + 16, yo, uw - 32, DROP_ROW_H, item.Name, on, clicked, mp, item.Swatch) then
				store[item.Flag] = not on
				if el.OnChange ~= nil then
					push(ui, el.OnChange, item.Flag, not on)
				end
			end
			yo += DROP_ROW_H + DROP_GAP
		end
		yo += 4
	end
	return yo + el.Gap
end

local function drawElement(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	if el.Show ~= nil and not el.Show() then
		return yo
	end
	local kind = el.Kind
	if kind == "toggle" then
		return drawToggle(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "action" then
		return drawAction(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "slider" then
		return drawSlider(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "input" then
		return drawInput(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "dropdown" then
		return drawDropdown(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "section" then
		return drawSection(ui, el, ux, yo, uw)
	end
	return drawNote(ui, el, ux, yo)
end

local Tab: any = {}
Tab.__index = Tab

function Tab:_add(kind: string, o: any): any
	local ui = self.Ui
	o.Kind = kind
	o.Gap = o.Gap or 0
	local name: string? = o.Name
	if name ~= nil then
		o.Label = if o.Key ~= nil then `{name} [{o.KeyLabel or keyLabel(o.Key)}]` else name
	end
	local store = o.Store or ui.Flags
	if o.Flag ~= nil and store[o.Flag] == nil then
		if kind == "slider" then
			store[o.Flag] = o.Default or o.Min
		elseif kind == "input" then
			store[o.Flag] = o.Default or ""
		else
			store[o.Flag] = o.Default == true
		end
	end
	if o.Items ~= nil then
		for _, item in o.Items do
			if item.Flag ~= nil and store[item.Flag] == nil then
				store[item.Flag] = item.Default == true
			end
		end
	end
	if o.Key ~= nil then
		o.KeyWasDown = false
		table.insert(ui.Hotkeys, o)
	end
	table.insert(self.Elements, o)
	return o
end

function Tab:toggle(o: any): any
	return self:_add("toggle", o)
end

function Tab:action(o: any): any
	o.Button = o.Button or "Run"
	return self:_add("action", o)
end

function Tab:input(o: any): any
	o.Placeholder = o.Placeholder or o.Name or ""
	return self:_add("input", o)
end

function Tab:slider(o: any): any
	o.Step = o.Step or 10
	o.Suffix = o.Suffix or ""
	return self:_add("slider", o)
end

function Tab:section(o: any): any
	return self:_add("section", o)
end

function Tab:note(o: any): any
	o.Before = o.Before or 0
	return self:_add("note", o)
end

function Tab:dropdown(o: any): any
	o.MaxLabel = o.MaxLabel or 19
	return self:_add("dropdown", o)
end

function UI.new(opts: any): any
	local self = setmetatable({
		Title = opts.Title or "MENU",
		Flags = opts.Flags or {},
		Tabs = {},
		TabIndex = 1,
		X = opts.X or 200,
		Y = opts.Y or 100,
		Width = opts.Width or 290,
		PanelH = 320,
		Visible = true,
		MenuKey = opts.Key or "RightShift",
		MenuKeyLabel = opts.KeyLabel or keyLabel(opts.Key or "RightShift"),
		Stat = opts.Stat,
		Mute = opts.Mute,
		Alive = true,
		Active = false,
		Dragging = false,
		DragDX = 0,
		DragDY = 0,
		SliderActive = nil,
		Open = {},
		Accordion = {},
		Hotkeys = {},
		MenuKeyWasDown = false,
		Input = { mx = 0, my = 0, down = false, pressed = false },
		Focus = nil,
		FocusAt = 0,
		TypeDown = {},
		BackDown = false,
		BackAt = 0,
		EnterDown = true,
		EscDown = true,
		BlockWant = false,
		BlockOn = false,
		ViewW = 0,
		ViewH = 0,
		ViewAt = -math.huge,
		KeysAt = -math.huge,
		QN = 0,
		QFn = {},
		QA = {},
		QB = {},
	}, UI)
	return self
end

function UI:tab(name: string): any
	local tab = setmetatable({ Name = name, Ui = self, Elements = {} }, Tab)
	table.insert(self.Tabs, tab)
	return tab
end

function UI:destroy(): ()
	self.Alive = false
	self.Focus = nil
	self.BlockWant = false
	if self.BlockOn then
		self.BlockOn = false
		block_roblox_window(false)
	end
end

local TYPE_KEYS: { any } = {}
do
	local digitNames = { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" }
	for i = 0, 9 do
		table.insert(TYPE_KEYS, { id = "d" .. i, ch = tostring(i), specs = { 48 + i, 96 + i, tostring(i), digitNames[i + 1] } })
	end
	table.insert(TYPE_KEYS, { id = "minus", ch = "-", specs = { 0xBD, 0x6D, "Minus", "OemMinus", "Subtract", "Dash", "Hyphen", "-" } })
	table.insert(TYPE_KEYS, { id = "minusL", ch = "-", specs = { 0x4C, "L" } })
	table.insert(TYPE_KEYS, { id = "dot", ch = ".", specs = { 0xBE, 0x6E, "Period", "OemPeriod", "Decimal", "." } })
	table.insert(TYPE_KEYS, { id = "comma", ch = ",", specs = { 0xBC, "Comma", "OemComma", "," } })
	table.insert(TYPE_KEYS, { id = "space", ch = " ", specs = { 0x20, "Space" } })
end
table.freeze(TYPE_KEYS)
local KEYS_BACK: { any } = table.freeze({ 0x08, "Backspace" })
local KEYS_ENTER: { any } = table.freeze({ 0x0D, "Return", "Enter" })
local KEYS_ESC: { any } = table.freeze({ 0x1B, "Escape" })

local function typeKeys(ui: any, keys: { any }, now: number): ()
	local el = ui.Focus
	local store = el.Store or ui.Flags
	local text: string = if type(store[el.Flag]) == "string" then store[el.Flag] else ""
	local changed = false
	for _, k in TYPE_KEYS do
		local pressed = keyDown(keys, k.specs)
		if pressed and ui.TypeDown[k.id] ~= true and #text < (el.MaxLen or 48) then
			text ..= k.ch
			changed = true
		end
		ui.TypeDown[k.id] = pressed
	end
	if keyDown(keys, KEYS_BACK) then
		if not ui.BackDown then
			ui.BackDown = true
			ui.BackAt = now + 0.4
			text = string.sub(text, 1, -2)
			changed = true
		elseif now >= ui.BackAt then
			ui.BackAt = now + 0.05
			text = string.sub(text, 1, -2)
			changed = true
		end
	else
		ui.BackDown = false
	end
	if changed then
		store[el.Flag] = text
	end
	local enter = keyDown(keys, KEYS_ENTER)
	if enter and not ui.EnterDown then
		if el.OnSubmit ~= nil then
			push(ui, el.OnSubmit, text, nil)
		end
		blur(ui)
	end
	ui.EnterDown = enter
	local esc = keyDown(keys, KEYS_ESC)
	if esc and not ui.EscDown then
		blur(ui)
	end
	ui.EscDown = esc
end

local function fireHotkey(ui: any, el: any): ()
	if el.Kind == "toggle" then
		setValue(ui, el, getValue(ui, el) ~= true)
	elseif el.Callback ~= nil then
		push(ui, el.Callback, nil, nil)
	end
end

local function sampleMouse(ui: any, active: boolean): ()
	local input = ui.Input
	local mouse = getmouseposition()
	local mx: number = mouse.x
	local my: number = mouse.y
	local ldown: boolean = active and isleftpressed()
	if ldown and ui.Mute ~= nil and ui.Mute() then
		ldown = false
	end
	local pressed = ldown and not input.down
	input.down = ldown
	input.mx = mx
	input.my = my
	if pressed then
		input.pressed = true
	end
	if not ldown then
		ui.Dragging = false
		return
	end
	local uw: number = ui.Width
	if not ui.Dragging then
		if pressed and ui.Visible and ui.SliderActive == nil and inRect(mx, my, ui.X, ui.Y, uw - 28, HEADER_H) then
			ui.Dragging = true
			ui.DragDX = mx - ui.X
			ui.DragDY = my - ui.Y
		end
	else
		ui.X = math.clamp(mx - ui.DragDX, 0, math.max(0, ui.ViewW - uw))
		ui.Y = math.clamp(my - ui.DragDY, 0, math.max(0, ui.ViewH - ui.PanelH))
	end
end

function UI:update(): ()
	if not self.Alive then
		return
	end
	local now = os.clock()
	local active = isrbxactive()
	if self.Focus ~= nil and (not self.Visible or now - self.FocusAt > 0.4) then
		blur(self)
	end

	self.Active = active

	if now - self.ViewAt >= 1 then
		self.ViewAt = now
		local cam = workspace.CurrentCamera
		if cam ~= nil then
			local vp = cam.ViewportSize
			self.ViewW = vp.x
			self.ViewH = vp.y
		end
	end

	sampleMouse(self, active)

	if now - self.KeysAt >= KEY_POLL then
		self.KeysAt = now
		local keys: { any } = if active then getpressedkeys() else EMPTY_KEYS
		local menuDown = keyDown(keys, self.MenuKey)
		if menuDown and not self.MenuKeyWasDown then
			self.Visible = not self.Visible
		end
		self.MenuKeyWasDown = menuDown
		if self.Focus ~= nil then
			typeKeys(self, keys, now)
		end
		for _, el in self.Hotkeys do
			local pressed = keyDown(keys, el.Key)
			if pressed and not el.KeyWasDown then
				fireHotkey(self, el)
			end
			el.KeyWasDown = pressed
		end
	end

	local n = self.QN
	if n > 0 then
		local fns, qa, qb = self.QFn, self.QA, self.QB
		local runFn: { any } = table.move(fns, 1, n, 1, {})
		local runA: { any } = table.move(qa, 1, n, 1, {})
		local runB: { any } = table.move(qb, 1, n, 1, {})
		local total = self.QN
		for i = n + 1, total do
			fns[i - n] = fns[i]
			qa[i - n] = qa[i]
			qb[i - n] = qb[i]
		end
		for i = total - n + 1, total do
			fns[i] = nil
			qa[i] = nil
			qb[i] = nil
		end
		self.QN = total - n
		for i = 1, n do
			runFn[i](runA[i], runB[i])
		end
	end

	if self.BlockWant ~= self.BlockOn and self.Alive then
		self.BlockOn = self.BlockWant
		block_roblox_window(self.BlockOn)
	end
end

function UI:render(): ()
	if not self.Alive then
		return
	end
	local input = self.Input
	local clicked: boolean = input.pressed
	input.pressed = false
	if not self.Visible then
		return
	end
	local mx: number = input.mx
	local my: number = input.my
	local mp: vector = vec(mx, my, 0)
	local uw: number = self.Width

	local ux: number = self.X
	local uy: number = self.Y
	RoundRect(ux, uy, uw, self.PanelH, 10, T.Bg)

	DrawingImmediate.FilledRectangle(vec(ux + 18, uy + 18, 0), vec(6, 6, 0), T.White, 1)
	DrawingImmediate.Text(vec(ux + 30, uy + 14, 0), 13, T.TextMain, 1, self.Title, false)
	DrawingImmediate.Text(vec(ux + 31, uy + 14, 0), 13, T.TextMain, 1, self.Title, false)
	DrawingImmediate.Text(vec(ux + uw - 26, uy + 13, 0), 14, T.TextDim, 1, "x", false)
	if clicked and inRect(mx, my, ux + uw - 28, uy, 28, HEADER_H) then
		self.Visible = false
		return
	end

	local tabs: { any } = self.Tabs
	local count = #tabs
	if count == 0 then
		return
	end
	local gap = 4
	local tabsW = uw - 16
	local tabW = (tabsW - gap * (count - 1)) / count
	for i, tab in tabs do
		local tx = ux + 8 + (i - 1) * (tabW + gap)
		local ty = uy + HEADER_H
		local active = self.TabIndex == i
		local hover = inRect(mx, my, tx, ty, tabW, TAB_H)
		if active or hover then
			RoundRect(tx, ty, tabW, TAB_H, 6, T.Chip)
		end
		DrawingImmediate.Text(vec(tx + tabW / 2, ty + TAB_H / 2 - 6, 0), 12, if active then T.TextMain else T.TextOff, 1, tab.Name, true)
		if clicked and hover then
			self.TabIndex = i
		end
	end

	local yo: number = uy + HEADER_H + TAB_H + 8
	local tab = tabs[self.TabIndex]
	for _, el in tab.Elements do
		yo = drawElement(self, el, ux, yo, uw, clicked, mp)
	end
	yo += 6

	DrawingImmediate.FilledRectangle(vec(ux + 12, yo, 0), vec(uw - 24, 1, 0), T.Divider, 1)
	local stat = self.Stat
	if stat ~= nil then
		DrawingImmediate.Text(vec(ux + 18, yo + 11, 0), 11, T.TextDim, 1, stat.Label, false)
		DrawingImmediate.Text(vec(ux + 62, yo + 11, 0), 11, T.TextRow, 1, stat.Value(), false)
	end
	DrawingImmediate.Text(vec(ux + 114, yo + 11, 0), 11, T.TextDim, 1, "Hide menu:", false)
	DrawingImmediate.Text(vec(ux + 188, yo + 11, 0), 11, T.TextMain, 1, self.MenuKeyLabel, false)
	self.PanelH = yo + 32 - uy
end

return UI
end)()
local T: any = Lib.Theme

-- ───────────────────────── Offsets ─────────────────────────

local OFF: { [string]: number } = { Position = 0x4D8, Size = 0x4F8, GuiEnabled = 0x48C, Rotation = 0, Visible = 0 }
local offsetInfo = "built-in (26.10.2026)"

local loadOffsets: any
do
	local OFFSET_FIELDS = table.freeze({
		{ "Position", "GuiObject", "Position" },
		{ "Size", "GuiObject", "Size" },
		{ "GuiEnabled", "GuiObject", "ScreenGui_Enabled" },
		{ "Rotation", "GuiObject", "Rotation" },
		{ "Visible", "GuiObject", "Visible" },
	})

	local function namespaceBlock(body: string, name: string): string?
		local at = string.find(body, "namespace " .. name .. " {", 1, true)
		if at == nil then
			return nil
		end
		local stop = string.find(body, "\n    }", at, true)
		if stop == nil then
			return nil
		end
		return string.sub(body, at, stop)
	end

	local function applyOffsets(body: string): number
		local found = 0
		for _, f in OFFSET_FIELDS do
			local block = namespaceBlock(body, f[2])
			local hex = if block ~= nil then string.match(block, "uintptr_t%s+" .. f[3] .. "%s*=%s*0x(%x+)") else nil
			local value = if hex ~= nil then tonumber(hex, 16) else nil
			if value ~= nil then
				OFF[f[1]] = value
				found += 1
			end
		end
		if found > 0 then
			local vAt = string.find(body, "ClientVersion", 1, true)
			local version = if vAt ~= nil then string.match(string.sub(body, vAt, vAt + 80), '"([^"]+)"') else nil
			offsetInfo = `live {found}/{#OFFSET_FIELDS} ({version or "?"})`
		end
		return found
	end

	function loadOffsets(): ()
		for _, url in OFFSETS_URLS do
			local body: any = game:HttpGet(url)
			if type(body) == "string" and #body > 0 and applyOffsets(body) > 0 then
				return
			end
		end
	end
end
loadOffsets()

-- ───────────────────────── Memory helpers ─────────────────────────

local function parseAddress(text: any): number
	if type(text) ~= "string" then
		return 0
	end
	local n: number? = if string.sub(text, 1, 2) == "0x" then tonumber(text) else tonumber(text, 16)
	return if n ~= nil and n > 4096 then n else 0
end

local function addressOf(inst: any): number
	if inst == nil then
		return 0
	end
	return parseAddress(inst.Data)
end

local function readF32(a: number): number
	return if a == 0 then 0 else memory.readf32(a)
end

local function readI32(a: number): number
	return if a == 0 then 0 else memory.readi32(a)
end

local function readU8(a: number): number
	return if a == 0 then 0 else memory.readu8(a)
end

local function sane(v: number, lo: number, hi: number): boolean
	return v == v and v >= lo and v <= hi
end

local function guiEnabled(gui: any): boolean
	local a = addressOf(gui)
	return a ~= 0 and readU8(a + OFF.GuiEnabled) ~= 0
end

local function frameX(obj: any): number
	local a = addressOf(obj)
	return if a == 0 then 0 else readF32(a + OFF.Position)
end

local function frameW(obj: any): number
	local a = addressOf(obj)
	return if a == 0 then 0 else readF32(a + OFF.Size)
end

-- ───────────────────────── Input ─────────────────────────

local HAS_RELEASE = type(mouse1release) == "function"
local mouseHeld = false
local pendingKeys: { { code: number, at: number } } = {}

local function holdMouse(): ()
	if not mouseHeld then
		mouse1press()
		mouseHeld = true
	end
end

local function releaseMouse(): ()
	if mouseHeld then
		mouseHeld = false
		if HAS_RELEASE then
			mouse1release()
		else
			keyrelease(0x01)
		end
	end
end

local function repressMouse(): ()
	if mouseHeld then
		if HAS_RELEASE then
			mouse1release()
		else
			keyrelease(0x01)
		end
	end
	mouse1press()
	mouseHeld = true
end

local function rereleaseMouse(): ()
	if HAS_RELEASE then
		mouse1release()
	else
		keyrelease(0x01)
	end
	mouseHeld = false
end

local syncMouse: any
do
	local mouseSees = false
	local mouseGapAt = 0.0
	local mouseNudgeAt = 0.0

	-- Re-presses when we want the button held but the system says it is up (user click, missed event).
	function syncMouse(now: number): ()
		if not mouseHeld then
			mouseGapAt = 0.0
			return
		end
		if isleftpressed() then
			mouseSees = true
			mouseGapAt = 0.0
			return
		end
		if mouseSees then
			if mouseGapAt == 0.0 then
				mouseGapAt = now
			elseif now - mouseGapAt >= 0.04 then
				mouseGapAt = 0.0
				mouse1press()
			end
		elseif now - mouseNudgeAt >= 0.15 then
			mouseNudgeAt = now
			mouse1press()
		end
	end
end

local function tapKey(code: number, holdSec: number): ()
	keypress(code)
	table.insert(pendingKeys, { code = code, at = os.clock() + holdSec })
end

local function flushKeys(now: number): ()
	for i = #pendingKeys, 1, -1 do
		local p = pendingKeys[i]
		if now >= p.at then
			keyrelease(p.code)
			table.remove(pendingKeys, i)
		end
	end
end

