-- Converts an end-time value to unix seconds (nil when it is not one).
local function toUnix(v: any): number?
	if type(v) ~= "number" or v ~= v then
		return nil
	end
	local n = if v >= 1e12 then v / 1000 else v
	return if n >= 1e8 then n else nil
end

-- Reads weather and events from a few known places and updates the World tab text.
local function scanWorld(): ()
	local names: { string } = {}
	local ends: { [string]: number } = {}
	local srcs: { [string]: string } = {}
	-- Registers one active event (first source wins, the end time is kept when known).
	local function add(name: string, endAt: number?, source: string): ()
		if srcs[name] == nil then
			table.insert(names, name)
			srcs[name] = source
		end
		if endAt ~= nil then
			ends[name] = endAt
		end
	end
	local unixNow = os.time()
	local world: any = getWorld()
	if world ~= nil then
		for _, slotName in { "weather", "clientWeather", "event", "admin_event", "AdminEventText" } do
			local slot: any = world:FindFirstChild(slotName)
			if slot ~= nil and slot.ClassName == "StringValue" then
				local text: any = slot.Value
				if type(text) == "string" and text ~= "" and string.lower(text) ~= "none" then
					local e: any = slot:GetAttribute("EndTime")
					if e == nil then
						e = slot:GetAttribute("endTime")
					end
					local endAt = toUnix(e)
					if endAt == nil or endAt > unixNow then
						add(text, endAt, "world." .. slotName)
					end
				end
			end
		end
		for flagName, display in { meteor_active = "Meteor", blizzard_active = "Blizzard", absolute_darkness_active = "Absolute Darkness" } do
			local f: any = world:FindFirstChild(flagName)
			if f ~= nil and f.ClassName == "BoolValue" and f.Value == true then
				add(display, nil, "world." .. flagName)
			end
		end
	end
	for key, display in EVENT_ATTRS do
		local v: any = workspace:GetAttribute(key)
		if v == nil then
			v = workspace:GetAttribute(key .. "Active")
		end
		if type(v) == "number" then
			local endAt = toUnix(v)
			if endAt ~= nil then
				if endAt > unixNow then
					add(display, endAt, "workspace." .. key)
				end
			elseif v > 0 then
				add(display, nil, "workspace." .. key)
			end
		elseif v == true then
			add(display, nil, "workspace." .. key)
		end
	end

	local current: { [string]: boolean } = {}
	local lines: { string } = { "", "", "", "", "" }
	for i, name in names do
		current[name] = true
		local endAt = ends[name]
		local left = if endAt ~= nil then math.max(0, endAt - unixNow) else nil
		if i <= 5 then
			lines[i] = if left ~= nil then string.format("%s  %d:%02d", name, math.floor(left / 60), math.floor(left % 60)) else name
		end
	end
	worldSeen = current
	if #names == 0 then
		lines[1] = "Events: none"
	end
	worldState.events = lines
	publishWorld()
end

local streakNode: any = nil
local streakNodeAt = -1e9

-- The game's own streak (workspace.PlayerStats.<name>.T.<name>.Stats.tracker_streak); nil when unreadable.
local function readGameStreak(): number?
	local player: any = Players.LocalPlayer
	if player == nil then
		return nil
	end
	if streakNode ~= nil and streakNode.Parent == nil then
		streakNode = nil
	end
	if streakNode == nil then
		local now = os.clock()
		if now - streakNodeAt < 1.0 then
			return nil
		end
		streakNodeAt = now
		local node: any = workspace
		for _, name in { "PlayerStats", player.Name, "T", player.Name, "Stats", "tracker_streak" } do
			node = node:FindFirstChild(name)
			if node == nil then
				return nil
			end
		end
		streakNode = node
	end
	local v: any = streakNode.Value
	return if type(v) == "number" and v == v then v else nil
end

-- Counts catches and losses from the game's own streak: +1 = caught, a drop = lost. Counted only while
-- Auto Fish runs (phase is not OFF); the first sample is just the baseline. Independent of the reel state machine.
local function trackStreak(now: number): ()
	if now - W.gsAt < 0.1 then
		return
	end
	W.gsAt = now
	local cur = readGameStreak()
	if cur == nil then
		return
	end
	local last = S.gs
	S.gs = cur
	if last == nil or cur == last then
		return
	end
	local counting = S.phase ~= "OFF"
	if cur > last then
		S.ups += 1
		if counting then
			S.caught += 1
			S.streak += 1
			S.bestStreak = math.max(S.bestStreak, S.streak)
			if S.cycleAt > 0 then
				S.catchSum += now - S.cycleAt
			end
		end
	else
		S.downs += 1
		if counting then
			S.lost += 1
			S.streak = 0
		end
	end
end

