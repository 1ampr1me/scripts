local function isCasted(tool: any): boolean
	local values = tool:FindFirstChild("values")
	local flag = if values ~= nil then values:FindFirstChild("casted") else nil
	return flag ~= nil and flag.Value == true
end

local shakeScan = { alt = false, at = 0.0 }
local scanShake: any
local shakeUp: any
do
	-- Fast path: PlayerGui.shakeui.safezone.button (the known layout), only FindFirstChild lookups.
	local function shakeFast(pg: any): boolean
		local gui = pg:FindFirstChild("shakeui")
		local zone = if gui ~= nil then gui:FindFirstChild("safezone") else nil
		return zone ~= nil and zone:FindFirstChild("button") ~= nil
	end

	-- Model thread: bounded search for a renamed shake gui or button.
	function scanShake(pg: any, now: number): ()
		shakeScan.at = now
		local gui: any = pg:FindFirstChild("shakeui")
		if gui == nil then
			for _, c in pg:GetChildren() do
				if string.find(string.lower(c.Name), "shake", 1, true) ~= nil then
					gui = c
					break
				end
			end
		end
		if gui == nil then
			shakeScan.alt = false
			return
		end
		local found = false
		local queue: { any } = { gui }
		local i = 1
		while not found and i <= #queue and i <= 80 do
			local node = queue[i]
			i += 1
			for _, c in node:GetChildren() do
				if string.lower(c.Name) == "button" or string.find(c.ClassName, "Button", 1, true) ~= nil then
					found = true
					break
				end
				table.insert(queue, c)
			end
		end
		shakeScan.alt = found
	end

	function shakeUp(pg: any): boolean
		return shakeFast(pg) or shakeScan.alt
	end
end

local function readReel(pg: any): boolean
	local gui = pg:FindFirstChild("reel")
	if gui == nil then
		reel.why = "no gui"
		return false
	end
	if not guiEnabled(gui) then
		reel.why = "gui off"
		return false
	end
	local bar = gui:FindFirstChild("bar")
	if bar == nil then
		reel.why = "no bar"
		return false
	end
	local fish = bar:FindFirstChild("fish")
	if fish == nil then
		reel.why = "no fish"
		return false
	end
	local playerbar = bar:FindFirstChild("playerbar")
	if playerbar == nil then
		reel.why = "no playerbar"
		return false
	end
	reel.why = "ok"
	reel.bar = bar
	reel.fish = fish
	reel.playerbar = playerbar
	return true
end

local function readProgress(): number?
	local progress = reel.bar:FindFirstChild("progress")
	local fill = if progress ~= nil then progress:FindFirstChild("bar") else nil
	if fill == nil then
		return nil
	end
	local w = frameW(fill)
	if not sane(w, -0.05, 1.5) then
		return nil
	end
	return math.clamp(w * 100, 0, 100)
end

local function readPower(char: any): number?
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local power = if hrp ~= nil then hrp:FindFirstChild("power") else nil
	if power == nil then
		return nil
	end
	local bar = power:FindFirstChild("bar")
	if bar == nil then
		for _, c in power:GetChildren() do
			bar = c:FindFirstChild("bar")
			if bar ~= nil then
				break
			end
		end
	end
	local a = addressOf(bar)
	if a == 0 then
		return nil
	end
	local h = readF32(a + OFF.Size + 8)
	if not sane(h, -0.05, 1.5) then
		return nil
	end
	return math.clamp(h * 100, 0, 100)
end

-- ───────────────────────── Reel controller ─────────────────────────

local ctl: any = {
	stuck = 0.0,
	resyncs = 0,
	dt = 0.016,
	lastCall = 0.0,
	invert = false,
	hasLast = false,
	lastTime = 0.0,
	fishVel = 0.0,
	barVel = 0.0,
	smoothFish = 0.0,
	smoothBar = 0.0,
	smoothCtl = 0.0,
	integ = 0.0,
	pulseUntil = 0.0,
	stable = false,
	stableUntil = 0.0,
	warmupUntil = 0.0,
	lastBarRaw = nil :: number?,
	lastFishRaw = nil :: number?,
	fv = 0.0,
	bv = 0.0,
	fishAt = 0.0,
	barAt = 0.0,
}

local function resetCtl(): ()
	ctl.stuck = 0.0
	ctl.lastCall = 0.0
	ctl.invert = false
	ctl.hasLast = false
	ctl.lastTime = 0.0
	ctl.fishVel = 0.0
	ctl.barVel = 0.0
	ctl.smoothFish = 0.0
	ctl.smoothBar = 0.0
	ctl.smoothCtl = 0.0
	ctl.integ = 0.0
	ctl.pulseUntil = 0.0
	ctl.stable = false
	ctl.stableUntil = 0.0
	ctl.warmupUntil = os.clock() + 0.2
	ctl.lastBarRaw = nil
	ctl.lastFishRaw = nil
	ctl.fv = 0.0
	ctl.bv = 0.0
	ctl.fishAt = 0.0
	ctl.barAt = 0.0
end

local reelTrack: any
do
	-- Logical hold: the mouse is released instead while the rod is inverted (Dreambreaker past 40%).
	local function hold(): ()
		if ctl.invert then
			releaseMouse()
		else
			holdMouse()
		end
	end

	local function rel(): ()
		if ctl.invert then
			holdMouse()
		else
			releaseMouse()
		end
	end

	-- Tuning (positions are 0-1 along the bar track, times in seconds)
	local TUNE_H = table.freeze({
		EdgeBoundary = 0.1,
		CloseThreshold = 0.0055,
		FishLeadS = 0.18,
		PredictionS = 0.13,
		BrakeS = 0.08,
		Kp = 2.7,
		Ki = 0.08,
		Kd = 3.6,
		PdClamp = 48.0,
		IntegralClamp = 130.0,
		BarRatioFromSide = 0.6,
		CenterZoneRatio = 0.05,
		CenterPulsePeriodS = 0.016,
		CenterPulseHoldS = 0.013,
		CenterReleaseBlipS = 0.006,
		CenterWeakPeriodS = 0.017,
		CenterWeakHoldS = 0.01,
		OnThreshold = 3.5,
		MaxVelocity = 1.05,
		PositionAlpha = 0.92,
		ControlAlpha = 0.99,
	})

	local function posmod(v: number, m: number): number
		local mm = math.max(0.001, m)
		local r = v % mm
		return if r < 0 then r + mm else r
	end

	-- Speed from real game updates only: re-reading an unchanged value is not zero speed.
	local function trackSpeed(fishC: number, barC: number, now: number): ()
		local lf = ctl.lastFishRaw
		local lb = ctl.lastBarRaw
		if lf == nil or lb == nil then
			ctl.lastFishRaw = fishC
			ctl.lastBarRaw = barC
			ctl.fishAt = now
			ctl.barAt = now
			return
		end
		if fishC ~= lf then
			ctl.fv = math.clamp(0.6 * (fishC - lf) / math.max(0.004, now - ctl.fishAt) + 0.4 * ctl.fv, -4, 4)
			ctl.lastFishRaw = fishC
			ctl.fishAt = now
		elseif now - ctl.fishAt > 0.1 then
			ctl.fv *= 0.8
		end
		if barC ~= lb then
			ctl.bv = math.clamp(0.6 * (barC - lb) / math.max(0.004, now - ctl.barAt) + 0.4 * ctl.bv, -4, 4)
			ctl.lastBarRaw = barC
			ctl.barAt = now
		elseif now - ctl.barAt > 0.1 then
			ctl.bv *= 0.8
		end
	end

	local function hybridEma(fishC: number, barC: number, now: number, s: any): ()
		trackSpeed(fishC, barC, now)
		local fishX = fishC * 1000
		local barX = barC * 1000
		if not ctl.hasLast then
			ctl.smoothFish = fishX
			ctl.smoothBar = barX
			ctl.fishVel = 0
			ctl.barVel = 0
			ctl.lastTime = now
			ctl.hasLast = true
			return
		end
		local alpha: number = s.PositionAlpha
		ctl.smoothFish = alpha * fishX + (1 - alpha) * ctl.smoothFish
		ctl.smoothBar = alpha * barX + (1 - alpha) * ctl.smoothBar
		local maxv = math.max(1, s.MaxVelocity * 1000)
		ctl.fishVel = math.clamp(ctl.fv * 1000, -maxv, maxv)
		ctl.barVel = math.clamp(ctl.bv * 1000, -maxv, maxv)
		ctl.lastTime = now
	end

	-- Fine control near the fish: PID with a stable zone; returns whether to hold.
	local function hybridFine(fishC: number, barC: number, barW01: number, now: number, s: any): boolean
		local barWidth = math.max(1, barW01 * 1000)
		local g = (flags.trackGain or 100) / 100
		local lead = math.clamp(ctl.fishVel * s.FishLeadS * g, -barWidth * 1.2, barWidth * 1.2)
		local err = ctl.smoothFish + lead - ctl.smoothBar
		err += math.clamp(barWidth * 0.035, 1.5, 5.0)
		local dt = ctl.dt
		ctl.integ = math.clamp(ctl.integ + err * dt, -s.IntegralClamp, s.IntegralClamp)
		local sideMargin = barWidth * s.BarRatioFromSide
		local clampV = math.max(s.PdClamp, s.OnThreshold + 1)
		local raw: number
		if ctl.smoothFish < sideMargin then
			raw = -clampV
		elseif ctl.smoothFish > 1000 - sideMargin then
			raw = clampV
		else
			raw = math.clamp(s.Kp * g * err + s.Ki * ctl.integ + s.Kd * g * (ctl.fishVel - ctl.barVel), -s.PdClamp, s.PdClamp)
		end
		ctl.smoothCtl = s.ControlAlpha * raw + (1 - s.ControlAlpha) * ctl.smoothCtl
		local control = ctl.smoothCtl
		local centerZone = math.max(2, barWidth * s.CenterZoneRatio)
		if math.abs(err) <= centerZone then
			if not ctl.stable then
				ctl.stable = true
				ctl.stableUntil = now + 3.0
			end
			if now < ctl.stableUntil then
				return control > s.OnThreshold
			end
			if now < ctl.pulseUntil then
				return false
			elseif control > s.OnThreshold then
				local h = posmod(now, s.CenterPulsePeriodS) < math.max(0.001, s.CenterPulseHoldS)
				if h then
					ctl.pulseUntil = now + math.max(0, s.CenterReleaseBlipS)
				end
				return h
			elseif control < -s.OnThreshold then
				return false
			end
			return control > 0 and posmod(now, s.CenterWeakPeriodS) < math.max(0.001, s.CenterWeakHoldS)
		end
		ctl.stable = false
		return control > s.OnThreshold
	end

	-- Aims at the predicted fish position; hard correction when far, PID when close.
	local function reelHybrid(fishC: number, barC: number, barW01: number): ()
		local s = TUNE_H
		local now = os.clock()
		local g = (flags.trackGain or 100) / 100
		hybridEma(fishC, barC, now, s)
		local leadMax = math.max(0.03, barW01 * 1.2)
		local fishP = fishC + math.clamp(ctl.fv * s.FishLeadS * g, -leadMax, leadMax)
		local err = fishP - barC
		if now < ctl.warmupUntil then
			if err > math.max(0.015, barW01 * 0.04) then
				hold()
			else
				rel()
			end
			return
		end
		if barC < s.EdgeBoundary and err > 0 then
			hold()
			return
		end
		if barC > 1 - s.EdgeBoundary and err < 0 then
			rel()
			return
		end
		if math.abs(err) > s.CloseThreshold then
			local remaining = math.abs(err) - s.CloseThreshold
			local predErr = fishP - (barC + ctl.bv * s.PredictionS * g)
			if err * predErr > 0 and not (err * ctl.bv > 0 and math.abs(ctl.bv) * s.BrakeS >= remaining) then
				if err > 0 then
					hold()
				else
					rel()
				end
				return
			end
		end
		if hybridFine(fishC, barC, barW01, now, s) then
			hold()
		else
			rel()
		end
	end

	-- Drives the mouse from the fish and bar positions (tracker plus input resync).
	function reelTrack(fishC: number, barC: number, barW01: number): ()
		local clock = os.clock()
		ctl.dt = if ctl.lastCall > 0 then math.clamp(clock - ctl.lastCall, 0.001, 0.1) else 0.016
		ctl.lastCall = clock
		-- Resync: the bar keeps drifting the wrong way, so the game probably missed a press or release.
		local err = fishC - barC
		local barVel = ctl.bv * 0.021
		local held = if ctl.invert then not mouseHeld else mouseHeld
		local halfW = barW01 / 2 + 0.03
		if held and err > 0.06 and barVel < 0.0003 and barC < 1 - halfW then
			ctl.stuck += ctl.dt
		elseif not held and err < -0.06 and barVel > -0.0003 and barC > halfW then
			ctl.stuck += ctl.dt
		else
			ctl.stuck = 0.0
		end
		if ctl.stuck >= STUCK_RESYNC_S then
			ctl.stuck = 0.0
			ctl.resyncs += 1
			if held == not ctl.invert then
				repressMouse()
			else
				rereleaseMouse()
			end
		end
		reelHybrid(fishC, barC, barW01)
	end
end

