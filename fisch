local ROD_SRC_LABEL = table.freeze({ exact = "exact spot", hub = "island hub (walk from there)", zone = "zone center (live lookup)" })

-- Finds a spot by exact name, then case-insensitively; without a table it looks in locations, then in points of interest.
local function resolveSpot(name: string, tbl: any?): any?
	if tbl == nil then
		return resolveSpot(name, LOCATIONS) or resolveSpot(name, POI)
	end
	local direct = tbl[name]
	if direct ~= nil then
		return direct
	end
	local lower = string.lower(name)
	for key, value in tbl do
		if string.lower(key) == lower then
			return value
		end
	end
	return nil
end

local function sortedNames(tbl: { [string]: any }): { string }
	local names: { string } = {}
	for name in tbl do
		table.insert(names, name)
	end
	table.sort(names, function(a: string, b: string): boolean
		return string.lower(a) < string.lower(b)
	end)
	return names
end

local function partPos(part: any): (number?, number?, number?)
	local ok, p = pcall(function(): any
		return part.Position
	end)
	if not ok or p == nil then
		return nil, nil, nil
	end
	local x, y, z = p.X, p.Y, p.Z
	if type(x) == "number" and type(y) == "number" and type(z) == "number" then
		return x, y, z
	end
	return nil, nil, nil
end

-- Zone centers from workspace.zones.player (cached for 5 seconds).
local zoneMap: { [string]: any } = {}
local zoneMapAt = -1e9

local function zoneName(zone: any): string
	local value: any = zone:FindFirstChild("zonename")
	if value ~= nil then
		local ok, text = pcall(function(): any
			return value.Value
		end)
		if ok and type(text) == "string" and text ~= "" then
			return text
		end
	end
	return zone.Name
end

local function zonePos(name: string): any?
	if name == "" then
		return nil
	end
	if os.clock() - zoneMapAt > 5 then
		zoneMapAt = os.clock()
		local map: { [string]: any } = {}
		local zones: any = workspace:FindFirstChild("zones")
		local player: any = if zones ~= nil then zones:FindFirstChild("player") else nil
		if player ~= nil then
			for _, zone in player:GetChildren() do
				local x, y, z = partPos(zone)
				if x ~= nil and y ~= nil and z ~= nil then
					local zn = zoneName(zone)
					if map[zn] == nil then
						map[zn] = V3(x, y, z)
					end
				end
			end
		end
		zoneMap = map
	end
	local want = string.lower(name)
	local partial: any = nil
	for key, value in zoneMap do
		local lower = string.lower(key)
		if lower == want then
			return value
		end
		if partial == nil and (string.find(lower, want, 1, true) ~= nil or string.find(want, lower, 1, true) ~= nil) then
			partial = value
		end
	end
	return partial
end

-- Where a rod can be reached: exact spot, island hub or the live zone center.
local function rodPos(rod: any): (any?, string?)
	if rod.pos ~= nil then
		return rod.pos, "exact"
	end
	local hub = resolveSpot(rod.tp or rod.zone)
	if hub ~= nil then
		return hub, "hub"
	end
	local zp = zonePos(rod.zone)
	if zp ~= nil then
		return zp, "zone"
	end
	return nil, nil
end

-- NPCs in the world (workspace.world.npcs, workspace.npcs and the NewNpc tag), cached for 10 seconds.
local npcList: { any } = {}
local npcAt = -1e9

local function collectNpcs(): { any }
	local out: { any } = {}
	local seen: { [string]: boolean } = {}
	local function addModel(model: any): ()
		local x, y, z = nil, nil, nil
		local hrp: any = model:FindFirstChild("HumanoidRootPart")
		if hrp ~= nil then
			x, y, z = partPos(hrp)
		end
		if x == nil then
			local head: any = model:FindFirstChild("Head")
			if head ~= nil then
				x, y, z = partPos(head)
			end
		end
		if x == nil then
			for _, c in model:GetChildren() do
				x, y, z = partPos(c)
				if x ~= nil then
					break
				end
			end
		end
		if x == nil or y == nil or z == nil then
			return
		end
		local key = string.format("%s@%d,%d", model.Name, math.floor(x), math.floor(z))
		if not seen[key] then
			seen[key] = true
			table.insert(out, { name = model.Name, pos = V3(x, y, z) })
		end
	end
	local function walk(folder: any, depth: number): ()
		if folder == nil or depth > 3 then
			return
		end
		for _, child in folder:GetChildren() do
			if child:FindFirstChild("Humanoid") ~= nil or child:FindFirstChild("HumanoidRootPart") ~= nil then
				addModel(child)
			elseif #child:GetChildren() > 0 then
				walk(child, depth + 1)
			end
		end
	end
	local world: any = workspace:FindFirstChild("world")
	walk(if world ~= nil then world:FindFirstChild("npcs") else nil, 1)
	walk(workspace:FindFirstChild("npcs"), 1)
	pcall(function()
		local service: any = game:GetService("CollectionService")
		for _, model in service:GetTagged("NewNpc") do
			addModel(model)
		end
	end)
	return out
end

local function npcSnapshot(): { any }
	local now = os.clock()
	if now - npcAt >= 10 then
		npcAt = now
		npcList = collectNpcs()
	end
	return npcList
end

-- Live check of a rod spot: the named NPC within 500 studs gives its real position; an NPC within 60 is "likely".
local function rodLiveCheck(rod: any, pos: any?): (any?, string?)
	local p: any = pos
	if p == nil then
		p = rodPos(rod)
	end
	if p == nil then
		return nil, nil
	end
	local wanted: string? = if rod.npc ~= nil then string.lower(rod.npc) else nil
	local nearest: number? = nil
	local nearestName: string? = nil
	local verified: any = nil
	for _, npc in npcSnapshot() do
		local dx, dy, dz = npc.pos.X - p.X, npc.pos.Y - p.Y, npc.pos.Z - p.Z
		local d = math.sqrt(dx * dx + dy * dy + dz * dz)
		if nearest == nil or d < nearest then
			nearest = d
			nearestName = npc.name
		end
		if wanted ~= nil and verified == nil and d <= 500 and string.find(string.lower(npc.name), wanted, 1, true) ~= nil then
			verified = npc.pos
		end
	end
	if verified ~= nil then
		return verified, "verified - " .. rod.npc .. " on site"
	end
	if nearest ~= nil and nearest <= 60 then
		return nil, string.format("likely - %s [%d]", nearestName or "?", math.floor(nearest))
	end
	return nil, "unverified (too far)"
end

local function wrapText(text: string, width: number): { string }
	local lines: { string } = {}
	local line = ""
	for word in string.gmatch(text, "%S+") do
		if line == "" then
			line = word
		elseif #line + 1 + #word <= width then
			line ..= " " .. word
		else
			table.insert(lines, line)
			line = word
		end
	end
	if line ~= "" then
		table.insert(lines, line)
	end
	return lines
end

local function rodDescribe(rod: any): { string }
	local pos, src = rodPos(rod)
	local _, live = rodLiveCheck(rod, pos)
	local lines: { string } = { rod.name }
	for _, l in wrapText("Where: " .. rod.zone, 54) do
		table.insert(lines, l)
	end
	for _, l in wrapText("How: " .. rod.how, 54) do
		table.insert(lines, l)
	end
	table.insert(lines, "Teleport: " .. (if src ~= nil then ROD_SRC_LABEL[src] else "n/a - no fixed spot"))
	if live ~= nil then
		table.insert(lines, "Live check: " .. live)
	end
	return lines
end

-- Teleports to a rod (the NPC's live position wins over the catalog spot).
local function rodTeleport(rod: any): ()
	local pos = rodPos(rod)
	if pos == nil then
		notice(rod.name .. " has no fixed spot (" .. rod.zone .. ")")
		return
	end
	local live = rodLiveCheck(rod, pos)
