-- Maps an instance name to a known hunt name (handles fish_ / Hunt / Default / Paths / Nodes decorations).
local function classifyHuntRaw(raw: string): string?
	local key = huntKey(raw)
	key = string.gsub(key, "^fish", "")
	local direct = huntKeys[key]
	if direct ~= nil then
		return direct
	end
	for _, suffix in { "hunt", "default", "paths", "waypoints", "nodes", "parts", "huntpools" } do
		local n = #suffix
		if #key > n and string.sub(key, -n) == suffix then
			local hit = huntKeys[string.sub(key, 1, #key - n)]
			if hit ~= nil then
				return hit
			end
		end
	end
	local lower = string.lower(raw)
	if
		string.find(lower, "hunt", 1, true) ~= nil
		or string.find(lower, "pool", 1, true) ~= nil
		or string.find(lower, "boil", 1, true) ~= nil
	then
		return raw
	end
	return nil
end

