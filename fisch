local function chestTpNearest(): ()
	local list = chestsNow()
	if #list == 0 then
		notice("No treasure chests up right now.")
		return
	end
	local mx, my, mz = myPosition()
	local best: any = nil
	local bestD = 0.0
	for _, c in list do
		local d = 0.0
		if mx ~= nil and my ~= nil and mz ~= nil then
			local dx, dy, dz = c.x - mx, c.y - my, c.z - mz
			d = math.sqrt(dx * dx + dy * dy + dz * dz)
		end
		if best == nil or d < bestD then
			best = c
			bestD = d
		end
	end
	teleportTo("Chest", best.x, best.y + 3, best.z, 0, nil)
end

local function chestTpNext(): ()
	local list = chestsNow()
	if #list == 0 then
		notice("No treasure chests up right now.")
		return
