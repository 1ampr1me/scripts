--   local ui = UI.new({ Title = "MY SCRIPT", Key = "RightShift", Flags = flagsTable, Mute = function() return false end })
--   local tab = ui:tab("Main")
--   tab:toggle({ Name = "Enabled", Flag = "enabled", Default = true, Key = "F1", OnChange = function(value) end })
