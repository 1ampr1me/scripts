-- Menu flags that are saved between runs (Auto Fish is never saved).
local PERSIST = table.freeze({
	"autoCast", "autoShake", "autoReel", "perfect", "holdMs", "shakeMs", "navOnStart", "autoEquip",
	"hud", "fromSaved", "trackGain", "worldOn", "huntOn",
	"walkWater", "walkOcean", "walkDesolate", "walkDepths",
})
local SETTINGS_FILE = "fisch_settings.json"
local settingsSnap: { [string]: any } = {}

-- Loads saved flags from the workspace file (the menu keeps values that are already set).
local function loadSettings(): ()
	if not isfile(SETTINGS_FILE) then
		return
	end
	local text: string = readfile(SETTINGS_FILE)
	if string.sub(text, 1, 1) ~= "{" then
		return
	end
	local data: any = crypt.json.decode(text)
	if type(data) ~= "table" then
		return
	end
	for _, key in PERSIST do
		local v = data[key]
		if type(v) == "boolean" or type(v) == "number" then
			flags[key] = v
			settingsSnap[key] = v
		end
	end
end
loadSettings()

-- Writes the saved flags when any of them changed.
local function saveSettings(): ()
	local changed = false
	for _, key in PERSIST do
		if flags[key] ~= settingsSnap[key] then
			changed = true
			break
		end
	end
	if not changed then
		return
	end
	local out: { [string]: any } = {}
	for _, key in PERSIST do
		local v = flags[key]
		out[key] = v
		settingsSnap[key] = v
	end
	writefile(SETTINGS_FILE, crypt.json.encode(out))
end

