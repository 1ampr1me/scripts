	chestCycle = chestCycle % #list + 1
	local c: any = list[chestCycle]
	teleportTo("Chest", c.x, c.y + 3, c.z, 0, nil)
end

-- Collect-all run: teleport to each chest, tap E, move on.
local chestRun = { active = false, list = {} :: { any }, i = 1, stage = "tp", nextAt = 0.0, visited = 0 }

local function chestRunStart(): ()
	if flags.enabled == true then
		notice("Stop Auto Fish to teleport")
		return
	end
	chestRun.list = chestsNow()
	chestRun.i = 1
	chestRun.stage = "tp"
	chestRun.nextAt = 0.0
	chestRun.visited = 0
	chestRun.active = #chestRun.list > 0
	notice(if chestRun.active then string.format("Chest run: visiting %d chest(s)...", #chestRun.list) else "Chest run: no chests found.")
end

local function chestRunStop(): ()
	if not chestRun.active then
		return
	end
	chestRun.active = false
	keyrelease(VK.E)
	notice(string.format("Chest run stopped (%d visited).", chestRun.visited))
end

-- One step of the collect-all run (PostLocal). The teleport is applied for a moment, so the E tap waits for it to finish.
function stepChestRun(now: number): ()
	if not chestRun.active or now < chestRun.nextAt then
		return
	end
	if chestRun.i > #chestRun.list then
		chestRun.active = false
		notice(string.format("Chest run done: %d chest(s) visited.", chestRun.visited))
		return
	end
	local c: any = chestRun.list[chestRun.i]
	if chestRun.stage == "tp" then
		queueTeleport("Chest", c.x, c.y, c.z, 0, nil)
		chestRun.stage = "wait"
	elseif chestRun.stage == "wait" then
		if tpJob == nil then
			chestRun.stage = "press"
			chestRun.nextAt = now + 0.15
		end
	else
		tapKey(VK.E, 0.15)
		chestRun.visited += 1
		chestRun.i += 1
		chestRun.stage = "tp"
		chestRun.nextAt = now + 0.2
	end
end

-- PostLocal: builds the ESP rows (distance, max distance filter, label) from the chest snapshot.
function updateChestRows(now: number): ()
	if flags.chestOn ~= true then
		if #chestRows > 0 then
			chestRows = {}
		end
		return
	end
	if espHrp ~= nil and espHrp.Parent == nil then
		espHrp = nil
	end
	if espHrp == nil and now - espHrpAt >= 0.25 then
		espHrpAt = now
		local char: any = getCharacter()
		espHrp = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	end
	local mx, my, mz = nil, nil, nil
	if espHrp ~= nil then
		mx, my, mz = readPosition(espHrp)
	end
	local maxd: number = flags.chestMax or 0
	local rows: { any } = {}
	for _, c in chestList do
		local d: number? = nil
		if mx ~= nil and my ~= nil and mz ~= nil then
			local dx, dy, dz = c.x - mx, c.y - my, c.z - mz
			d = math.sqrt(dx * dx + dy * dy + dz * dz)
		end
		if not (maxd > 0 and d ~= nil and d > maxd) then
			local label: string = c.name
			if flags.chestDist == true and d ~= nil then
				label = string.format("%s [%d]", c.name, math.floor(d))
			end
			table.insert(rows, { pos = vec(c.x, c.y, c.z), label = label })
		end
	end
	chestRows = rows
end

-- Render: the label of every chest on screen.
function drawChests(): ()
	if flags.chestOn ~= true or #chestRows == 0 then
		return
	end
	local cam: any = workspace.CurrentCamera
	if cam == nil then
		return
	end
	local textSize: number = flags.chestText or 14
	for _, row in chestRows do
		local sp: any, onScreen: any = cam:WorldToScreenPoint(row.pos)
		if onScreen and sp ~= nil then
			local sx: number = sp.X
			local sy: number = sp.Y
			DrawingImmediate.Text(vec(sx, sy - textSize / 2, 0), textSize, CHEST_TEXT, 1, row.label, true)
		end
	end
end

