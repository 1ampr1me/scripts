	["Great Hammerhead Shark"] = { 0.0, 135.0, 0.0 },
	["Great White Shark"] = { 0.0, 135.0, 0.0 },
	["Whale Shark"] = { 0.0, 135.0, 0.0 },
	["The Depths - Serpent"] = { 0.0, 50.0, 0.0 },
})

local function gotoHuntNamed(name: string): ()
	local inst: any = huntFound[name]
	if inst == nil then
		notice("Hunt is gone")
		return
	end
	local x, y, z = posOf(inst)
	if x == nil or y == nil or z == nil then
		notice("Hunt position unknown")
		return
	end
	local off: any = HUNT_TP[name]
	if off ~= nil then
		teleportTo(name, x + off[1], y + off[2], z + off[3], 0, nil)
	else
		teleportTo(name, x, math.max(y + 10, 135), z, 0, nil)
	end
end

-- A Megalodon can spawn outside zones.fishing: exact names are looked up in workspace, the small
-- active and active.bosses folders are scanned by name.
local function scanMegalodon(current: { [string]: any }): ()
	local active: any = workspace:FindFirstChild("active")
	local bosses: any = if active ~= nil then active:FindFirstChild("bosses") else nil
	for _, name in MEGA_EXACT do
		local c: any = workspace:FindFirstChild(name)
		if c ~= nil and current[name] == nil then
			current[name] = c
		end
	end
	local roots: { any } = {}
	if active ~= nil then
		table.insert(roots, active)
	end
	if bosses ~= nil then
		table.insert(roots, bosses)
	end
	for _, root in roots do
		for _, c in root:GetChildren() do
			local raw: string = c.Name
			local name = megaNames[raw]
			if name == nil then
				local lower = string.lower(raw)
				if string.find(lower, "megalodon", 1, true) == nil then
					name = false
				elseif string.find(lower, "ancient", 1, true) ~= nil then
					name = "Ancient Megalodon"
				else
					name = "Megalodon"
				end
				megaNames[raw] = name
			end
			if name ~= false and current[name] == nil then
				current[name] = c
			end
		end
	end
end

-- Looks for hunts and events among the children of Workspace.zones.fishing (they exist only while active).
local function scanHunts(): ()
	huntActive = true
	local zones: any = workspace:FindFirstChild("zones")
	local fishing: any = if zones ~= nil then zones:FindFirstChild("fishing") else nil
	if fishing == nil then
		worldState.hunts = { "Hunt: zones.fishing not found" }
		publishWorld()
		return
	end
	local current: { [string]: any } = {}
	for _, c in fishing:GetChildren() do
		local hit = classifyHunt(c.Name)
		if hit ~= nil then
			current[hit] = c
		end
	end
	if current["Megalodon"] == nil and current["Ancient Megalodon"] == nil then
		scanMegalodon(current)
	end
	local order: { string } = {}
	for name in current do
		table.insert(order, name)
		if huntFound[name] == nil then
			notice(`Hunt: {name}`)
		end
	end
	table.sort(order)
	huntFound = current
	huntOrder = order
	local orderKey = table.concat(order, "|")
	if huntPicker ~= nil and orderKey ~= huntPickerKey then
		huntPickerKey = orderKey
		local items: { any } = {}
		for _, name in order do
			table.insert(items, {
				Name = name,
				Callback = function()
					gotoHuntNamed(name)
				end,
			})
		end
		huntPicker.Items = items
	end
	local lines: { string } = {}
	for _, name in order do
		local x, _, z = posOf(current[name])
		table.insert(lines, if x ~= nil and z ~= nil then string.format("%s (%.0f, %.0f)", name, x, z) else name)
	end
	if #lines == 0 then
		lines[1] = "Hunt: none"
	end
	worldState.hunts = lines
	publishWorld()
end

-- Clears hunt results when detection is switched off, so no stale hunt can be teleported to.
local function clearHunts(): ()
	huntActive = false
	huntFound = {}
	huntOrder = {}
	huntPickerKey = ""
	if huntPicker ~= nil then
		huntPicker.Items = {}
	end
	worldState.hunts = { "Hunt: off" }
	publishWorld()
end

local function gotoHunt(): ()
	if #huntOrder == 0 then
		notice("No hunt detected")
		return
	end
	huntCursor = huntCursor % #huntOrder + 1
	gotoHuntNamed(huntOrder[huntCursor])
end

-- Walk on water: makes the sea parts of the chosen zones solid (client-side CanCollide).
local WATER_ZONES = table.freeze({
	{ "walkOcean", "Ocean" },
	{ "walkDesolate", "Desolate Deep" },
	{ "walkDepths", "The Depths" },
})
local waterOn = false

-- Sets CanCollide on the zone parts (Ocean also covers Deep Ocean); zones that are not selected go back to off.
local function applyWater(on: boolean): ()
	local zones: any = workspace:FindFirstChild("zones")
	local fishing: any = if zones ~= nil then zones:FindFirstChild("fishing") else nil
	if fishing == nil then
		return
	end
	for _, part in fishing:GetChildren() do
		local class: string = part.ClassName
		if class == "Part" or class == "MeshPart" or class == "UnionOperation" then
			local name: string = part.Name
			local known = false
			local target = false
			for _, z in WATER_ZONES do
				if name == z[2] or (z[2] == "Ocean" and name == "Deep Ocean") then
					known = true
					target = on and flags[z[1]] == true
				end
			end
			if known and part.CanCollide ~= target then
				part.CanCollide = target
			end
		end
	end
end

table.insert(onUnload, function()
	if waterOn then
		waterOn = false
		applyWater(false)
	end
end)

-- Model thread (scans belong here, not in the macro tick): one heavy job per tick, each on its own cooldown.
function onPostModel(): ()
	local now = os.clock()
	local pg: any = getPlayerGui()
	if flags.enabled == true and pg ~= nil and now - shakeScan.at >= 0.3 then
		scanShake(pg, now)
		return
	end
	local wantWater = flags.walkWater == true
	if (wantWater or waterOn) and (wantWater ~= waterOn or now - W.waterAt >= 2.0) then
		W.waterAt = now
		waterOn = wantWater
		applyWater(wantWater)
		return
	end
	if flags.worldOn == true then
		if now - W.clockAt >= 1.0 then
			W.clockAt = now
			worldState.time = serverClock()
			publishWorld()
			return
		end
		if now - W.scanAt >= 3.0 then
			W.scanAt = now
			scanWorld()
			return
		end
	end
	if flags.huntOn == true then
		if now - W.huntAt >= 4.0 then
			W.huntAt = now
			scanHunts()
			return
		end
	elseif huntActive then
		clearHunts()
		return
	end
	if flags.chestOn == true and now - W.chestAt >= 1.5 then
		W.chestAt = now
		refreshChests()
		return
	end
	if now - W.playersAt >= 2.0 then
		W.playersAt = now
		scanPlayers()
		return
	end
end

