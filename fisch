-- ───────────────────────── Teleport engine ─────────────────────────

local tpJob: any = nil

local function readPosition(part: any): (number?, number?, number?)
	local p: any = part.Position
	if p == nil then
		return nil, nil, nil
	end
	local x, y, z = p.X, p.Y, p.Z
	if type(x) == "number" and type(y) == "number" and type(z) == "number" then
		return x, y, z
	end
	return nil, nil, nil
end

-- Position of a part, or of a model's primary / first part (folders: first part found below).
local function posOf(inst: any): (number?, number?, number?)
	local target: any = inst
	if inst.ClassName == "Folder" then
		local queue: { any } = { inst }
		local depths: { number } = { 0 }
		local i = 1
		while i <= #queue and i <= 60 do
			local node = queue[i]
			local depth = depths[i]
			i += 1
			for _, c in node:GetChildren() do
				local cn = c.ClassName
				if cn == "Part" or cn == "MeshPart" or cn == "UnionOperation" then
					return readPosition(c)
				end
				if depth < 3 and (cn == "Folder" or cn == "Model") then
					table.insert(queue, c)
					table.insert(depths, depth + 1)
				end
			end
		end
		return nil, nil, nil
	end
	if inst.ClassName == "Model" then
		local pp: any = inst.PrimaryPart
		if pp ~= nil then
			target = pp
		else
			for _, c in inst:GetChildren() do
				local cn = c.ClassName
				if cn == "Part" or cn == "MeshPart" or cn == "UnionOperation" then
					target = c
					break
				end
			end
		end
	end
	return readPosition(target)
end

local function readFacing(part: any): { number }?
	local v: any = part.LookVector
	if v == nil then
		return nil
	end
	local x, z = v.X, v.Z
	if type(x) ~= "number" or type(z) ~= "number" then
		return nil
	end
	local len = math.sqrt(x * x + z * z)
	if len < 0.1 then
		return nil
	end
	return { x / len, z / len }
end

local function queueTeleport(name: string, x: number, y: number, z: number, lift: number, face: { number }?): ()
	tpJob = {
		name = name,
		x = x,
		y = y + lift,
		z = z,
		face = face,
		untilAt = os.clock() + 0.6,
		woke = false,
		frames = 0,
		noCf = false,
	}
end

-- Menu teleport (blocked while Auto Fish runs).
local function teleportTo(name: string, x: number, y: number, z: number, lift: number?, face: { number }?): ()
	if flags.enabled == true then
		notice("Stop Auto Fish to teleport")
		return
	end
	queueTeleport(name, x, y, z, lift or 4, face)
	notice(`Teleporting: {name}`)
end

-- Writes the target every frame for a moment (CFrame when a facing is given, otherwise Position).
-- A standing character has a sleeping physics assembly that ignores the write, so a short W tap wakes it first.
local function stepTeleport(now: number): ()
	local job = tpJob
	if job == nil then
		return
	end
	local char: any = getCharacter()
	local hrp: any = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil then
		tpJob = nil
		notice("No character")
		return
	end
	if now >= job.untilAt then
		tpJob = nil
		notice(`Teleported: {job.name}`)
		return
	end
	if not job.woke and isrbxactive() then
		job.woke = true
		tapKey(VK.W, 0.25)
	end
	job.frames += 1
	local face: { number }? = job.face
	local useCf = face ~= nil and not job.noCf
	if useCf and job.frames == 4 then
		local px, py, pz = readPosition(hrp)
		if px == nil or py == nil or pz == nil then
			job.noCf = true
		else
			local dx, dy, dz = px - job.x, py - job.y, pz - job.z
			if dx * dx + dy * dy + dz * dz > 400 then
				job.noCf = true
			end
		end
	end
	if useCf and face ~= nil then
		hrp.CFrame = CFrame.new(
			Vector3.new(job.x, job.y, job.z),
			Vector3.new(job.x + face[1], job.y, job.z + face[2])
		)
	else
		hrp.Position = vec(job.x, job.y, job.z)
	end
end

local SAVE_FILE = "fisch_saved_spot.txt" -- saved position and facing: "x,y,z[,fx,fz]"
local savedLines: { string } = { "Saved: none", "Facing: --" }

local function setSaved(x: number, y: number, z: number, face: { number }?): ()
	saved = { x = x, y = y, z = z, face = face }
	savedLines[1] = string.format("Saved: %.0f, %.0f, %.0f", x, y, z)
	savedLines[2] = if face ~= nil then "Facing: saved" else "Facing: not saved"
end

local function savePosition(): ()
	local char: any = getCharacter()
	local hrp: any = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil then
		notice("No character")
		return
	end
	local x, y, z = readPosition(hrp)
	if x == nil or y == nil or z == nil then
		notice("Can't read position")
		return
	end
	local face = readFacing(hrp)
	setSaved(x, y, z, face)
	local text = string.format("%.2f,%.2f,%.2f", x, y, z)
	if face ~= nil then
		text ..= string.format(",%.4f,%.4f", face[1], face[2])
	end
	writefile(SAVE_FILE, text)
	notice("Position saved")
end

local function gotoSaved(): ()
	local pos = saved
	if pos == nil then
		notice("No saved position")
		return
	end
	teleportTo("saved position", pos.x, pos.y, pos.z, 0, pos.face)
end

if isfile(SAVE_FILE) then
	local nums: { number } = {}
	for token in string.gmatch(readfile(SAVE_FILE), "%-?%d+%.?%d*") do
		local n = tonumber(token)
		if n ~= nil then
			table.insert(nums, n)
		end
	end
	if #nums >= 3 then
		setSaved(nums[1], nums[2], nums[3], if #nums >= 5 then { nums[4], nums[5] } else nil)
	end
end

local function myPosition(): (number?, number?, number?)
	local char: any = getCharacter()
	local hrp: any = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil then
		return nil, nil, nil
	end
	return readPosition(hrp)
end

