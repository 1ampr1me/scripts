	S.cycleAt = 0.0
	notice("Stats reset")
end

-- Model thread (scans belong here, not in the macro tick): one heavy job per tick, each on its own cooldown.
local function onPostModel(): ()
	local now = os.clock()
	local pg: any = getPlayerGui()
	if flags.enabled == true and pg ~= nil and now - shakeScan.at >= 0.3 then
		scanShake(pg, now)
		return
	end
	local wantWater = flags.walkWater == true
	if (wantWater or waterOn) and (wantWater ~= waterOn or now - W.waterAt >= 2.0) then
		W.waterAt = now
		waterOn = wantWater
		applyWater(wantWater)
		return
	end
	if flags.worldOn == true then
		if now - W.clockAt >= 1.0 then
			W.clockAt = now
			worldState.time = serverClock()
			publishWorld()
			return
		end
		if now - W.scanAt >= 3.0 then
			W.scanAt = now
			scanWorld()
			return
		end
	end
	if flags.huntOn == true then
		if now - W.huntAt >= 4.0 then
			W.huntAt = now
			scanHunts()
			return
		end
	elseif huntActive then
		clearHunts()
		return
	end
	if now - W.playersAt >= 2.0 then
		W.playersAt = now
		scanPlayers()
		return
	end
end

