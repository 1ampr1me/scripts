-- Keys that type a character into a focused text field: { id, ch, specs }.
local TYPE_KEYS: { any } = {}
do
	local digitNames = { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" }
	for i = 0, 9 do
		table.insert(TYPE_KEYS, { id = "d" .. i, ch = tostring(i), specs = { 48 + i, 96 + i, tostring(i), digitNames[i + 1] } })
	end
	table.insert(TYPE_KEYS, { id = "minus", ch = "-", specs = { 0xBD, 0x6D, "Minus", "OemMinus", "Subtract", "Dash", "Hyphen", "-" } })
	table.insert(TYPE_KEYS, { id = "minusL", ch = "-", specs = { 0x4C, "L" } })
	table.insert(TYPE_KEYS, { id = "dot", ch = ".", specs = { 0xBE, 0x6E, "Period", "OemPeriod", "Decimal", "." } })
	table.insert(TYPE_KEYS, { id = "comma", ch = ",", specs = { 0xBC, "Comma", "OemComma", "," } })
	table.insert(TYPE_KEYS, { id = "space", ch = " ", specs = { 0x20, "Space" } })
end
table.freeze(TYPE_KEYS)
local KEYS_BACK: { any } = table.freeze({ 0x08, "Backspace" })
local KEYS_ENTER: { any } = table.freeze({ 0x0D, "Return", "Enter" })
local KEYS_ESC: { any } = table.freeze({ 0x1B, "Escape" })

-- Reads typed characters, Backspace (with repeat), Enter and Esc for the focused text field.
local function typeKeys(ui: any, keys: { any }, now: number): ()
	local el = ui.Focus
	local store = el.Store or ui.Flags
	local text: string = if type(store[el.Flag]) == "string" then store[el.Flag] else ""
	local changed = false
	for _, k in TYPE_KEYS do
		local pressed = keyDown(keys, k.specs)
		if pressed and ui.TypeDown[k.id] ~= true and #text < (el.MaxLen or 48) then
			text ..= k.ch
			changed = true
		end
		ui.TypeDown[k.id] = pressed
	end
	if keyDown(keys, KEYS_BACK) then
		if not ui.BackDown then
			ui.BackDown = true
			ui.BackAt = now + 0.4
			text = string.sub(text, 1, -2)
			changed = true
		elseif now >= ui.BackAt then
			ui.BackAt = now + 0.05
			text = string.sub(text, 1, -2)
			changed = true
		end
	else
		ui.BackDown = false
	end
	if changed then
		store[el.Flag] = text
	end
	local enter = keyDown(keys, KEYS_ENTER)
	if enter and not ui.EnterDown then
		if el.OnSubmit ~= nil then
			push(ui, el.OnSubmit, text, nil)
		end
		blur(ui)
	end
	ui.EnterDown = enter
	local esc = keyDown(keys, KEYS_ESC)
	if esc and not ui.EscDown then
		blur(ui)
	end
	ui.EscDown = esc
end

-- Hotkey pressed: flips a toggle or runs an action.
local function fireHotkey(ui: any, el: any): ()
	if el.Kind == "toggle" then
		setValue(ui, el, getValue(ui, el) ~= true)
	elseif el.Callback ~= nil then
		push(ui, el.Callback, nil, nil)
	end
end

-- Samples the mouse once per update, latches new presses for Render and moves the window while dragging.
local function sampleMouse(ui: any, active: boolean): ()
	local input = ui.Input
	local mouse = getmouseposition()
	local mx: number = mouse.x
	local my: number = mouse.y
	local ldown: boolean = active and isleftpressed()
	if ldown and ui.Mute ~= nil and ui.Mute() then
		ldown = false
	end
	local pressed = ldown and not input.down
	input.down = ldown
	input.mx = mx
	input.my = my
	if pressed then
		input.pressed = true
	end
	if not ldown then
		ui.Dragging = false
		return
	end
	local uw: number = ui.Width
	if not ui.Dragging then
		if pressed and ui.Visible and ui.SliderActive == nil and inRect(mx, my, ui.X, ui.Y, uw - 28, HEADER_H) then
			ui.Dragging = true
			ui.DragDX = mx - ui.X
			ui.DragDY = my - ui.Y
		end
	else
		ui.X = math.clamp(mx - ui.DragDX, 0, math.max(0, ui.ViewW - uw))
		ui.Y = math.clamp(my - ui.DragDY, 0, math.max(0, ui.ViewH - ui.PanelH))
	end
end

-- PostLocal: reads input (mouse, menu key, hotkeys), refreshes the viewport, runs queued callbacks.
function UI:update(): ()
	if not self.Alive then
		return
	end
	local now = os.clock()
	local active = isrbxactive()
	if self.Focus ~= nil and (not self.Visible or now - self.FocusAt > 0.4) then
		blur(self)
	end

	self.Active = active

	if now - self.ViewAt >= 1 then
		self.ViewAt = now
		local cam = workspace.CurrentCamera
		if cam ~= nil then
			local vp = cam.ViewportSize
			self.ViewW = vp.x
			self.ViewH = vp.y
		end
	end

	sampleMouse(self, active)

	-- Keys are read only while Roblox is the active window
	if now - self.KeysAt >= KEY_POLL then
		self.KeysAt = now
		local keys: { any } = if active then getpressedkeys() else EMPTY_KEYS
		local menuDown = keyDown(keys, self.MenuKey)
		if menuDown and not self.MenuKeyWasDown then
			self.Visible = not self.Visible
		end
		self.MenuKeyWasDown = menuDown
		if self.Focus ~= nil then
			typeKeys(self, keys, now)
		end
		for _, el in self.Hotkeys do
			local pressed = keyDown(keys, el.Key)
			if pressed and not el.KeyWasDown then
				fireHotkey(self, el)
			end
			el.KeyWasDown = pressed
		end
	end

	-- Callbacks queued by Render and by hotkeys; ones queued while running wait for the next update
	local n = self.QN
	if n > 0 then
		local fns, qa, qb = self.QFn, self.QA, self.QB
		local runFn: { any } = table.move(fns, 1, n, 1, {})
		local runA: { any } = table.move(qa, 1, n, 1, {})
		local runB: { any } = table.move(qb, 1, n, 1, {})
		-- Shift the queue first so a failing callback is not re-run on every update
		local total = self.QN
		for i = n + 1, total do
			fns[i - n] = fns[i]
			qa[i - n] = qa[i]
			qb[i - n] = qb[i]
		end
		for i = total - n + 1, total do
			fns[i] = nil
			qa[i] = nil
			qb[i] = nil
		end
		self.QN = total - n
		for i = 1, n do
			runFn[i](runA[i], runB[i])
		end
	end

	-- Game input block follows the text field focus (requested by Render, applied here)
	if self.BlockWant ~= self.BlockOn and self.Alive then
		self.BlockOn = self.BlockWant
		block_roblox_window(self.BlockOn)
	end
end

-- Render: draws the menu and hit-tests the latched click (state changes only, no input or API calls).
function UI:render(): ()
	if not self.Alive then
		return
	end
	local input = self.Input
	local clicked: boolean = input.pressed
	input.pressed = false
	if not self.Visible then
		return
	end
	local mx: number = input.mx
	local my: number = input.my
	local mp: vector = vec(mx, my, 0)
	local uw: number = self.Width

	local ux: number = self.X
	local uy: number = self.Y
	RoundRect(ux, uy, uw, self.PanelH, 10, T.Bg)

	DrawingImmediate.FilledRectangle(vec(ux + 18, uy + 18, 0), vec(6, 6, 0), T.White, 1)
	DrawingImmediate.Text(vec(ux + 30, uy + 14, 0), 13, T.TextMain, 1, self.Title, false)
	DrawingImmediate.Text(vec(ux + 31, uy + 14, 0), 13, T.TextMain, 1, self.Title, false) -- second pass = bolder title
	DrawingImmediate.Text(vec(ux + uw - 26, uy + 13, 0), 14, T.TextDim, 1, "x", false)
	if clicked and inRect(mx, my, ux + uw - 28, uy, 28, HEADER_H) then
		self.Visible = false
		return
	end

	-- Tab bar
	local tabs: { any } = self.Tabs
	local count = #tabs
	if count == 0 then
		return
	end
	local gap = 4
	local tabsW = uw - 16
	local tabW = (tabsW - gap * (count - 1)) / count
	for i, tab in tabs do
		local tx = ux + 8 + (i - 1) * (tabW + gap)
		local ty = uy + HEADER_H
		local active = self.TabIndex == i
		local hover = inRect(mx, my, tx, ty, tabW, TAB_H)
		if active or hover then
			RoundRect(tx, ty, tabW, TAB_H, 6, T.Chip)
		end
		DrawingImmediate.Text(vec(tx + tabW / 2, ty + TAB_H / 2 - 6, 0), 12, if active then T.TextMain else T.TextOff, 1, tab.Name, true)
		if clicked and hover then
			self.TabIndex = i
		end
	end

	-- Controls of the open tab
	local yo: number = uy + HEADER_H + TAB_H + 8
	local tab = tabs[self.TabIndex]
	for _, el in tab.Elements do
		yo = drawElement(self, el, ux, yo, uw, clicked, mp)
	end
	yo += 6

	-- Footer: optional status text on the left, the menu key on the right
	DrawingImmediate.FilledRectangle(vec(ux + 12, yo, 0), vec(uw - 24, 1, 0), T.Divider, 1)
	local stat = self.Stat
	if stat ~= nil then
		DrawingImmediate.Text(vec(ux + 18, yo + 11, 0), 11, T.TextDim, 1, stat.Label, false)
		DrawingImmediate.Text(vec(ux + 62, yo + 11, 0), 11, T.TextRow, 1, stat.Value(), false)
	end
	DrawingImmediate.Text(vec(ux + 114, yo + 11, 0), 11, T.TextDim, 1, "Hide menu:", false)
	DrawingImmediate.Text(vec(ux + 188, yo + 11, 0), 11, T.TextMain, 1, self.MenuKeyLabel, false)
	self.PanelH = yo + 32 - uy
end

return UI
end)()
local T: any = Lib.Theme

-- ───────────────────────── Offsets ─────────────────────────

-- GUI offsets: built-in values are replaced by the live dump when it can be fetched (they change every Roblox update)
local OFF: { [string]: number } = { Position = 0x4D8, Size = 0x4F8, GuiEnabled = 0x48C }
local offsetInfo = "built-in (26.10.2026)"

-- Offset keys with the namespace and field they come from in the offsets dump.
local OFFSET_FIELDS = table.freeze({
	{ "Position", "GuiObject", "Position" },
	{ "Size", "GuiObject", "Size" },
	{ "GuiEnabled", "GuiObject", "ScreenGui_Enabled" },
})

-- Text of one `namespace Name { ... }` block (plain searches only, the dump is large).
local function namespaceBlock(body: string, name: string): string?
	local at = string.find(body, "namespace " .. name .. " {", 1, true)
	if at == nil then
		return nil
	end
	local stop = string.find(body, "\n    }", at, true)
	if stop == nil then
		return nil
	end
	return string.sub(body, at, stop)
end

-- Overwrites the offsets from one dump text; returns how many of them were found.
local function applyOffsets(body: string): number
	local found = 0
	for _, f in OFFSET_FIELDS do
		local block = namespaceBlock(body, f[2])
		local hex = if block ~= nil then string.match(block, "uintptr_t%s+" .. f[3] .. "%s*=%s*0x(%x+)") else nil
		local value = if hex ~= nil then tonumber(hex, 16) else nil
		if value ~= nil then
			OFF[f[1]] = value
			found += 1
		end
	end
	if found > 0 then
		local vAt = string.find(body, "ClientVersion", 1, true)
		local version = if vAt ~= nil then string.match(string.sub(body, vAt, vAt + 80), '"([^"]+)"') else nil
		offsetInfo = `live {found}/{#OFFSET_FIELDS} ({version or "?"})`
	end
	return found
end

-- Fetches the latest offsets dump once at start; the built-in values stay when nothing usable comes back.
local function loadOffsets(): ()
	for _, url in OFFSETS_URLS do
		local body: any = game:HttpGet(url)
		if type(body) == "string" and #body > 0 and applyOffsets(body) > 0 then
			return
		end
	end
end
loadOffsets()

-- ───────────────────────── Memory helpers ─────────────────────────

-- Converts Instance.Data (hex text, with or without the 0x prefix) into an address number (0 when invalid).
local function parseAddress(text: any): number
	if type(text) ~= "string" then
		return 0
	end
	local n: number? = if string.sub(text, 1, 2) == "0x" then tonumber(text) else tonumber(text, 16)
	return if n ~= nil and n > 4096 then n else 0
end

-- Address of an instance (0 when unknown).
local function addressOf(inst: any): number
	if inst == nil then
		return 0
	end
	return parseAddress(inst.Data)
end

-- Reads a float at the address (0 for a null address).
local function readF32(a: number): number
	return if a == 0 then 0 else memory.readf32(a)
end

-- Reads a byte at the address (0 for a null address).
local function readU8(a: number): number
	return if a == 0 then 0 else memory.readu8(a)
end

-- True for a normal finite number inside [lo, hi].
local function sane(v: number, lo: number, hi: number): boolean
	return v == v and v >= lo and v <= hi
end

-- ScreenGui.Enabled read from memory.
local function guiEnabled(gui: any): boolean
	local a = addressOf(gui)
	return a ~= 0 and readU8(a + OFF.GuiEnabled) ~= 0
end

-- Position.X.Scale of a frame.
local function frameX(obj: any): number
	local a = addressOf(obj)
	return if a == 0 then 0 else readF32(a + OFF.Position)
end

-- Size.X.Scale of a frame.
local function frameW(obj: any): number
	local a = addressOf(obj)
	return if a == 0 then 0 else readF32(a + OFF.Size)
end

-- ───────────────────────── Input ─────────────────────────

local HAS_RELEASE = type(mouse1release) == "function"
local mouseHeld = false
local pendingKeys: { { code: number, at: number } } = {}

-- Presses the left mouse button once (no-op while already held).
local function holdMouse(): ()
	if not mouseHeld then
		mouse1press()
		mouseHeld = true
	end
end

-- Releases the left mouse button (no-op while not held).
local function releaseMouse(): ()
	if mouseHeld then
		mouseHeld = false
		if HAS_RELEASE then
			mouse1release()
		else
			keyrelease(0x01)
		end
	end
end

-- Sends a fresh press even if the game missed the previous one.
local function repressMouse(): ()
	if mouseHeld then
		if HAS_RELEASE then
			mouse1release()
		else
			keyrelease(0x01)
		end
	end
	mouse1press()
	mouseHeld = true
end

-- Sends a fresh release even if the game missed the previous one.
local function rereleaseMouse(): ()
	if HAS_RELEASE then
		mouse1release()
	else
		keyrelease(0x01)
	end
	mouseHeld = false
end

local mouseSees = false -- true once isleftpressed() was seen true while we held the button
local mouseGapAt = 0.0
local mouseNudgeAt = 0.0

-- Re-presses when we want the button held but the system says it is up (user click, missed event).
local function syncMouse(now: number): ()
	if not mouseHeld then
		mouseGapAt = 0.0
		return
	end
	if isleftpressed() then
		mouseSees = true
		mouseGapAt = 0.0
		return
	end
	if mouseSees then
		if mouseGapAt == 0.0 then
			mouseGapAt = now
		elseif now - mouseGapAt >= 0.04 then
			mouseGapAt = 0.0
			mouse1press()
		end
	elseif now - mouseNudgeAt >= 0.15 then
		-- isleftpressed has not shown our presses yet: keep nudging, a press while held is harmless
		mouseNudgeAt = now
		mouse1press()
	end
end

-- Presses a key now and releases it after holdSec (handled by flushKeys).
local function tapKey(code: number, holdSec: number): ()
	keypress(code)
	table.insert(pendingKeys, { code = code, at = os.clock() + holdSec })
end

-- Releases keys whose hold time has passed.
local function flushKeys(now: number): ()
	for i = #pendingKeys, 1, -1 do
		local p = pendingKeys[i]
		if now >= p.at then
			keyrelease(p.code)
			table.remove(pendingKeys, i)
		end
	end
end

-- ───────────────────────── Game readers ─────────────────────────

local reel: { [string]: any } = {}
local flags: { [string]: any } = {}

local pgCache: any = nil

-- PlayerGui of the local player (cached while it stays parented).
local function getPlayerGui(): any
	if pgCache ~= nil and pgCache.Parent ~= nil then
		return pgCache
	end
	local lp = Players.LocalPlayer
	pgCache = if lp ~= nil then lp:FindFirstChild("PlayerGui") else nil
	return pgCache
end

-- Character model of the local player (workspace model by name, then Player.Character).
local function getCharacter(): any
	local lp = Players.LocalPlayer
	if lp == nil then
		return nil
	end
	local model: any = workspace:FindFirstChild(lp.Name)
	if model ~= nil then
		return model
	end
	return lp.Character
end

-- First Tool held by the character.
local function findTool(char: any): any
	return char:FindFirstChildOfClass("Tool")
end

-- True when the rod's values.casted flag is set.
local function isCasted(tool: any): boolean
	local values = tool:FindFirstChild("values")
	local flag = if values ~= nil then values:FindFirstChild("casted") else nil
	return flag ~= nil and flag.Value == true
end

local shakeScan = { alt = false, at = 0.0 } -- alt: a shake button was found by the bounded search (Model thread)

-- Fast path: PlayerGui.shakeui.safezone.button (the known layout), only FindFirstChild lookups.
local function shakeFast(pg: any): boolean
	local gui = pg:FindFirstChild("shakeui")
	local zone = if gui ~= nil then gui:FindFirstChild("safezone") else nil
	return zone ~= nil and zone:FindFirstChild("button") ~= nil
end

-- Model thread: bounded search for a renamed shake gui or button, so GetChildren never runs in the macro tick.
local function scanShake(pg: any, now: number): ()
	shakeScan.at = now
	local gui: any = pg:FindFirstChild("shakeui")
	if gui == nil then
		for _, c in pg:GetChildren() do
			if string.find(string.lower(c.Name), "shake", 1, true) ~= nil then
				gui = c
				break
			end
		end
	end
	if gui == nil then
		shakeScan.alt = false
		return
	end
	local found = false
	local queue: { any } = { gui }
	local i = 1
	while not found and i <= #queue and i <= 80 do
		local node = queue[i]
		i += 1
		for _, c in node:GetChildren() do
			if string.lower(c.Name) == "button" or string.find(c.ClassName, "Button", 1, true) ~= nil then
				found = true
				break
			end
			table.insert(queue, c)
		end
	end
	shakeScan.alt = found
end

-- Shake prompt: its button exists.
local function shakeUp(pg: any): boolean
	return shakeFast(pg) or shakeScan.alt
end

-- Resolves the reel minigame parts into `reel`; false when it is not on screen.
local function readReel(pg: any): boolean
	local gui = pg:FindFirstChild("reel")
	if gui == nil then
		reel.why = "no gui"
		return false
	end
	if not guiEnabled(gui) then
		reel.why = "gui off"
		return false
	end
	local bar = gui:FindFirstChild("bar")
	if bar == nil then
		reel.why = "no bar"
		return false
	end
	local fish = bar:FindFirstChild("fish")
	if fish == nil then
		reel.why = "no fish"
		return false
	end
	local playerbar = bar:FindFirstChild("playerbar")
	if playerbar == nil then
		reel.why = "no playerbar"
		return false
	end
	reel.why = "ok"
	reel.bar = bar
	reel.fish = fish
	reel.playerbar = playerbar
	return true
end

-- Reel progress 0-100 (reel.bar.progress.bar width), nil when unreadable.
local function readProgress(): number?
	local progress = reel.bar:FindFirstChild("progress")
	local fill = if progress ~= nil then progress:FindFirstChild("bar") else nil
	if fill == nil then
		return nil
	end
	local w = frameW(fill)
	if not sane(w, -0.05, 1.5) then
		return nil
	end
	return math.clamp(w * 100, 0, 100)
end

-- Cast power 0-100 (power bar height), nil when the bar is not there.
local function readPower(char: any): number?
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local power = if hrp ~= nil then hrp:FindFirstChild("power") else nil
	if power == nil then
		return nil
	end
	local bar = power:FindFirstChild("bar")
	if bar == nil then
		for _, c in power:GetChildren() do
			bar = c:FindFirstChild("bar")
			if bar ~= nil then
				break
			end
		end
	end
	local a = addressOf(bar)
	if a == 0 then
		return nil
	end
	local h = readF32(a + OFF.Size + 8)
	if not sane(h, -0.05, 1.5) then
		return nil
	end
	return math.clamp(h * 100, 0, 100)
end

