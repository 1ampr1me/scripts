-- Key names accepted by Key options (virtual-key codes); letters, digits and F1-F12 are added below
local KEY_CODES: { [string]: number } = {
	RightShift = 0xA1,
	LeftShift = 0xA0,
	RightControl = 0xA3,
	LeftControl = 0xA2,
	RightAlt = 0xA5,
	LeftAlt = 0xA4,
	Return = 0x0D,
	Enter = 0x0D,
	Space = 0x20,
	Tab = 0x09,
	Escape = 0x1B,
	Insert = 0x2D,
	Delete = 0x2E,
	Home = 0x24,
	End = 0x23,
	PageUp = 0x21,
	PageDown = 0x22,
}
for i = 0, 25 do
	KEY_CODES[string.char(65 + i)] = 65 + i
end
for i = 0, 9 do
	KEY_CODES[tostring(i)] = 48 + i
end
for i = 1, 12 do
	KEY_CODES["F" .. i] = 0x6F + i
end
table.freeze(KEY_CODES)

-- ───────────────────────── Helpers ─────────────────────────

-- True if a key spec (name, virtual-key code or a list of them) is in the pressed keys.
local function keyDown(keys: { any }, spec: any): boolean
	if type(spec) == "table" then
		for _, one in spec do
			if table.find(keys, one) ~= nil then
				return true
			end
			local code = if type(one) == "string" then KEY_CODES[one] else nil
			if code ~= nil and table.find(keys, code) ~= nil then
				return true
			end
		end
		return false
	end
	if table.find(keys, spec) ~= nil then
		return true
	end
	local code = if type(spec) == "string" then KEY_CODES[spec] else nil
	return code ~= nil and table.find(keys, code) ~= nil
end

-- Text shown for a key spec.
local function keyLabel(spec: any): string
	if type(spec) == "table" then
		for _, one in spec do
			if type(one) == "string" then
				return one
			end
		end
		return "?"
	end
	if type(spec) == "number" then
		return string.format("0x%02X", spec)
	end
	if spec == "RightShift" then
		return "RShift"
	elseif spec == "LeftShift" then
		return "LShift"
	end
	return tostring(spec)
end

-- True if the point is inside the rectangle.
local function inRect(px: number, py: number, x: number, y: number, w: number, h: number): boolean
	return px >= x and px <= x + w and py >= y and py <= y + h
end

-- Cuts a label to maxLen characters.
local function shortLabel(s: string, maxLen: number): string
	if #s > maxLen then
		return string.sub(s, 1, maxLen - 1) .. "."
	end
	return s
end

-- Queues a callback; it runs in the next ui:update() (PostLocal), not in Render.
local function push(ui: any, fn: any, a: any, b: any): ()
	local n = ui.QN + 1
	ui.QN = n
	ui.QFn[n] = fn
	ui.QA[n] = a
	ui.QB[n] = b
end

-- ───────────────────────── Drawing primitives ─────────────────────────

-- Immediate mode has no rounding: corners are built from rectangles (small radii) or circles (large ones).
local function RoundRect(x: number, y: number, w: number, h: number, r: number, color: Color3): ()
	if r <= 3 then
		DrawingImmediate.FilledRectangle(vec(x + 1, y, 0), vec(w - 2, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + 1, 0), vec(w, h - 2, 0), color, 1)
		return
	end
	if r <= 6 then
		local i1 = floor(r * 0.6 + 0.5)
		local i2 = math.max(1, floor(r * 0.25 + 0.5))
		local t = floor(r * 0.6)
		DrawingImmediate.FilledRectangle(vec(x + i1, y, 0), vec(w - 2 * i1, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x + i2, y + 1, 0), vec(w - 2 * i2, h - 2, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + t, 0), vec(w, h - 2 * t, 0), color, 1)
		return
	end
	DrawingImmediate.FilledRectangle(vec(x + r, y, 0), vec(w - 2 * r, h, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x + w - r, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + h - r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + h - r, 0), r, color, 1)
end

-- Toggle pill with a 1px outline and a square knob (right = on, left = off).
local function DrawPill(x: number, y: number, w: number, h: number, on: boolean): ()
	RoundRect(x, y, w, h, 5, if on then T.PillLine else T.PillLineOff)
	RoundRect(x + 1, y + 1, w - 2, h - 2, 4, if on then T.PillBg else T.PillBgOff)
	local knob = 10
	local kx = if on then (x + w - knob - 4) else (x + 4)
	RoundRect(kx, y + (h - knob) / 2, knob, knob, 3, if on then T.Knob else T.KnobOff)
end

-- One toggle row (optional color swatch). Returns true if the row was clicked.
local function DrawToggleRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	enabled: boolean,
	clicked: boolean,
	mp: vector,
	swatch: Color3?
): boolean
	local labelX = x + 10
	if swatch then
		DrawingImmediate.FilledRectangle(vec(x + 10, y + h / 2 - 3, 0), vec(6, 6, 0), swatch, 1)
		labelX = x + 22
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 13, if enabled then T.TextRow else T.TextOff, 1, label, false)
	DrawPill(x + w - 32 - 10, y + (h - 18) / 2, 32, 18, enabled)
	return clicked and inRect(mp.x, mp.y, x, y, w, h)
end

-- A row with a small button on the right. Returns true if the button was clicked.
local function DrawActionRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	btnText: string,
	clicked: boolean,
	mp: vector
): boolean
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextRow, 1, label, false)
	local bw = 64
	local bh = 18
	local bx = x + w - bw - 10
	local by = y + (h - bh) / 2
	local hover = inRect(mp.x, mp.y, bx, by, bw, bh)
	RoundRect(bx, by, bw, bh, 5, T.PillLine)
	RoundRect(bx + 1, by + 1, bw - 2, bh - 2, 4, if hover then T.PillLine else T.PillBg)
	DrawingImmediate.Text(vec(bx + bw / 2, by + 3, 0), 12, T.TextMain, 1, btnText, true)
	return clicked and hover
end

-- A compact chip; `on` = nil hides the on/off indicator. Returns true if it was clicked.
local function DrawChip(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	on: boolean?,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	RoundRect(x, y, w, h, 5, if hover then T.PillLine else T.Chip)
	local labelX = x + 10
	if on ~= nil then
		DrawingImmediate.FilledRectangle(vec(x + 8, y + h / 2 - 3, 0), vec(6, 6, 0), if on then T.Knob else T.PillLineOff, 1)
		labelX = x + 20
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 11, if on == false then T.TextOff else T.TextRow, 1, label, false)
	return clicked and hover
end

-- Collapsible list header (label, counter, arrow). Returns true if clicked.
local function DrawDropdownHeader(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	countText: string,
	open: boolean,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	if hover or open then
		RoundRect(x, y, w, h, 6, T.Chip)
	end
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextMain, 1, label, false)
	DrawingImmediate.Text(vec(x + w - 46, y + h / 2 - 6, 0), 12, T.TextDim, 1, countText, true)
	local cx = x + w - 16
	local cy = y + h / 2
	if open then
		DrawingImmediate.FilledTriangle(vec(cx - 5, cy - 3, 0), vec(cx + 5, cy - 3, 0), vec(cx, cy + 3, 0), T.Knob, 1)
	else
		DrawingImmediate.FilledTriangle(vec(cx - 3, cy - 5, 0), vec(cx - 3, cy + 5, 0), vec(cx + 3, cy, 0), T.Knob, 1)
	end
	return clicked and hover
end

-- Slider row; returns the new value and keeps dragging while the button is held.
local function DrawSliderRow(ui: any, el: any, x: number, y: number, w: number, value: number, clicked: boolean, ldown: boolean, mp: vector): number
	local minV: number = el.Min
	local maxV: number = el.Max
	local step: number = el.Step
	DrawingImmediate.Text(vec(x + 10, y + 9, 0), 11, T.TextDim, 1, el.Name, false)
	RoundRect(x + w - 55, y + 9, 45, 14, 4, T.Chip)
	DrawingImmediate.Text(vec(x + w - 32.5, y + 10, 0), 11, T.TextMain, 1, tostring(floor(value)) .. el.Suffix, true)

	local tX = x + 10
	local tW = w - 20
	local tC = y + 43 -- vertical center of the track

	if clicked and inRect(mp.x, mp.y, tX - 6, tC - 10, tW + 12, 20) then
		ui.SliderActive = el
	end
	if not ldown then
		ui.SliderActive = nil
	end
	if ui.SliderActive == el then
		local rel = math.clamp((mp.x - tX) / tW, 0, 1)
		value = floor((minV + rel * (maxV - minV)) / step + 0.5) * step
		value = math.clamp(value, minV, maxV)
	end

	RoundRect(tX, tC - 2, tW, 4, 2, T.Track)
	local frac = math.clamp((value - minV) / (maxV - minV), 0, 1)
	RoundRect(tX + floor(tW * frac) - 5, tC - 5, 10, 10, 3, T.Knob)
	return value
end

-- Dim small label text.
local function DrawLabel(x: number, y: number, text: string): ()
	DrawingImmediate.Text(vec(x + 18, y, 0), 11, T.TextDim, 1, text, false)
end

-- ───────────────────────── Controls ─────────────────────────

-- Reads the current value of a control.
local function getValue(ui: any, el: any): any
	if el.Get ~= nil then
		return el.Get()
	end
	local store = el.Store or ui.Flags
	return store[el.Flag]
end

-- Stores a new value and queues OnChange.
local function setValue(ui: any, el: any, value: any): ()
	if el.Set ~= nil then
		el.Set(value)
	else
		local store = el.Store or ui.Flags
		store[el.Flag] = value
	end
	if el.OnChange ~= nil then
		push(ui, el.OnChange, value, el.Flag)
	end
end

-- Draws a toggle row and returns the y of the next control.
local function drawToggle(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local on = getValue(ui, el) == true
	if DrawToggleRow(ux + 8, yo, uw - 16, ROW_H, el.Label, on, clicked, mp, el.Swatch) then
		setValue(ui, el, not on)
	end
	return yo + ROW_H + el.Gap
end

-- Draws an action row and returns the y of the next control.
local function drawAction(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	if DrawActionRow(ux + 8, yo, uw - 16, ROW_H, el.Label, el.Button, clicked, mp) and el.Callback ~= nil then
		push(ui, el.Callback, nil, nil)
	end
	return yo + ROW_H + el.Gap
end

-- Requests the game-input block state; it is applied in ui:update() (never from Render).
local function setBlock(ui: any, state: boolean): ()
	ui.BlockWant = state
end

-- Leaves the text field and gives the keyboard back to the game.
local function blur(ui: any): ()
	if ui.Focus ~= nil then
		ui.Focus = nil
		setBlock(ui, false)
	end
end

-- Focuses a text field and blocks game input while typing.
local function focus(ui: any, el: any): ()
	ui.Focus = el
	ui.FocusAt = os.clock()
	ui.TypeDown = {}
	ui.BackDown = false
	ui.EnterDown = true
	ui.EscDown = true
	setBlock(ui, true)
end

-- Text field row: click to type, Enter submits, Esc or a click elsewhere leaves it.
local function drawInput(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local store = el.Store or ui.Flags
	local text: string = if type(store[el.Flag]) == "string" then store[el.Flag] else ""
	local focused = ui.Focus == el
	local bx = ux + 18
	local by = yo + 2
	local bw = uw - 36
	local bh = ROW_H - 4
	local hover = inRect(mp.x, mp.y, bx, by, bw, bh)
	if clicked then
		if hover and not focused then
			focus(ui, el)
			focused = true
		elseif not hover and focused then
			blur(ui)
			focused = false
		end
	end
	if focused then
		ui.FocusAt = os.clock()
	end
	RoundRect(bx, by, bw, bh, 5, if focused then T.PillLine else T.PillLineOff)
	RoundRect(bx + 1, by + 1, bw - 2, bh - 2, 4, T.PillBg)
	local shown = text
	local color = T.TextMain
	if text == "" and not focused then
		shown = el.Placeholder or ""
		color = T.TextOff
	end
	if #shown > 34 then
		shown = string.sub(shown, -34)
	end
	if focused and math.floor(os.clock() * 2) % 2 == 0 then
		shown ..= "|"
	end
	DrawingImmediate.Text(vec(bx + 8, by + 4, 0), 13, color, 1, shown, false)
	return yo + ROW_H + el.Gap
end

-- Draws a slider row and returns the y of the next control.
local function drawSlider(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local value: number = getValue(ui, el)
	local nextValue = DrawSliderRow(ui, el, ux + 8, yo, uw - 16, value, clicked, ui.Input.down, mp)
	if nextValue ~= value then
		setValue(ui, el, nextValue)
	end
	return yo + SLIDER_ROW_H + 9 + el.Gap
end

-- Draws a section heading and returns the y of the next control.
local function drawSection(ui: any, el: any, ux: number, yo: number, uw: number): number
	if el.Divider then
		DrawingImmediate.FilledRectangle(vec(ux + 12, yo, 0), vec(uw - 24, 1, 0), T.Divider, 1)
		DrawLabel(ux, yo + 12, el.Title)
		return yo + 30
	end
	DrawLabel(ux, yo + 2, el.Title)
	return yo + 20
end

-- Draws dim text lines (a snapshot of el.Lines) and returns the y of the next control.
local function drawNote(ui: any, el: any, ux: number, yo: number): number
	yo += el.Before
	local lines: { string } = el.Lines
	for i, line in lines do
		DrawLabel(ux, yo + (i - 1) * 14, line)
	end
	return yo + #lines * 14 + 6
end

-- Open state of a list: one open list per accordion id, or one flag per list.
local function isOpen(ui: any, el: any): boolean
	if el.Accordion ~= nil then
		return ui.Accordion[el.Accordion] == el
	end
	return ui.Open[el] == true
end

-- Opens or closes a list.
local function toggleOpen(ui: any, el: any): ()
	local open = isOpen(ui, el)
	if el.Accordion ~= nil then
		ui.Accordion[el.Accordion] = if open then nil else el
	else
		ui.Open[el] = not open
	end
end

-- Draws a collapsible list (rows or chips) and returns the y of the next control.
local function drawDropdown(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	local items: { any } = el.Items
	local store = el.Store or ui.Flags
	local chips = el.Layout == "chips"
	local size = #items

	-- Counter: on / total for flag items, the item count for plain action chips
	local flagged = false
	local onCount = 0
	for _, item in items do
		if item.Flag ~= nil then
			flagged = true
			if store[item.Flag] == true then
				onCount += 1
			end
		end
	end
	local countText = if flagged then `{onCount}/{size}` else tostring(size)

	local open = isOpen(ui, el)
	if DrawDropdownHeader(ux + 8, yo, uw - 16, ROW_H, el.Name, countText, open, clicked, mp) then
		toggleOpen(ui, el)
	end
	yo += ROW_H
	if not open then
		return yo + el.Gap
	end
	yo += DROP_TOP_GAP

	-- "All" row switches every flag item at once
	if el.All ~= nil and flagged then
		local allOn = onCount == size
		if DrawToggleRow(ux + 16, yo, uw - 32, DROP_ROW_H, el.All, allOn, clicked, mp, T.White) then
			for _, item in items do
				store[item.Flag] = not allOn
			end
			if el.OnChange ~= nil then
				push(ui, el.OnChange, nil, not allOn)
			end
		end
		yo += DROP_ROW_H + DROP_GAP + (if chips then 2 else 0)
	end

	if chips then
		local cw = (uw - 32 - CHIP_GAP) / 2
		for i, item in items do
			local col = (i - 1) % 2
			local row = floor((i - 1) / 2)
			local cx = ux + 16 + col * (cw + CHIP_GAP)
			local cy = yo + row * (CHIP_H + CHIP_GAP)
			local label = shortLabel(item.Name, el.MaxLabel)
			if item.Flag ~= nil then
				local on = store[item.Flag] == true
				if DrawChip(cx, cy, cw, CHIP_H, label, on, clicked, mp) then
					store[item.Flag] = not on
					if el.OnChange ~= nil then
						push(ui, el.OnChange, item.Flag, not on)
					end
				end
			elseif DrawChip(cx, cy, cw, CHIP_H, label, nil, clicked, mp) and item.Callback ~= nil then
				push(ui, item.Callback, item, nil)
			end
		end
		yo += floor((size + 1) / 2) * (CHIP_H + CHIP_GAP) + 4
	else
		for _, item in items do
			local on = store[item.Flag] == true
			if DrawToggleRow(ux + 16, yo, uw - 32, DROP_ROW_H, item.Name, on, clicked, mp, item.Swatch) then
				store[item.Flag] = not on
				if el.OnChange ~= nil then
					push(ui, el.OnChange, item.Flag, not on)
				end
			end
			yo += DROP_ROW_H + DROP_GAP
		end
		yo += 4
	end
	return yo + el.Gap
end

-- Draws one control and returns the y of the next one.
local function drawElement(ui: any, el: any, ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	if el.Show ~= nil and not el.Show() then
		return yo
	end
	local kind = el.Kind
	if kind == "toggle" then
		return drawToggle(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "action" then
		return drawAction(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "slider" then
		return drawSlider(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "input" then
		return drawInput(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "dropdown" then
		return drawDropdown(ui, el, ux, yo, uw, clicked, mp)
	elseif kind == "section" then
		return drawSection(ui, el, ux, yo, uw)
	end
	return drawNote(ui, el, ux, yo)
end

-- ───────────────────────── Tabs ─────────────────────────

local Tab: any = {}
Tab.__index = Tab

-- Registers a control: defaults, hotkey, label.
function Tab:_add(kind: string, o: any): any
	local ui = self.Ui
	o.Kind = kind
	o.Gap = o.Gap or 0
	local name: string? = o.Name
	if name ~= nil then
		o.Label = if o.Key ~= nil then `{name} [{o.KeyLabel or keyLabel(o.Key)}]` else name
	end
	local store = o.Store or ui.Flags
	if o.Flag ~= nil and store[o.Flag] == nil then
		if kind == "slider" then
			store[o.Flag] = o.Default or o.Min
		elseif kind == "input" then
			store[o.Flag] = o.Default or ""
		else
			store[o.Flag] = o.Default == true
		end
	end
	if o.Items ~= nil then
		for _, item in o.Items do
			if item.Flag ~= nil and store[item.Flag] == nil then
				store[item.Flag] = item.Default == true
			end
		end
	end
	if o.Key ~= nil then
		o.KeyWasDown = false
		table.insert(ui.Hotkeys, o)
	end
	table.insert(self.Elements, o)
	return o
end

-- Toggle: Name, Flag (or Get / Set), Default, Key, KeyLabel, Swatch, Gap, Store, OnChange(value, flag).
function Tab:toggle(o: any): any
	return self:_add("toggle", o)
end

-- Button row: Name, Button (text), Callback(), Key, KeyLabel, Gap.
function Tab:action(o: any): any
	o.Button = o.Button or "Run"
	return self:_add("action", o)
end

-- Text field: Name (placeholder), Flag (string), Default, MaxLen (48), Gap, OnSubmit(text).
function Tab:input(o: any): any
	o.Placeholder = o.Placeholder or o.Name or ""
	return self:_add("input", o)
end

-- Slider: Name, Flag, Min, Max, Default, Step (10), Suffix, Gap, OnChange(value, flag).
function Tab:slider(o: any): any
	o.Step = o.Step or 10
	o.Suffix = o.Suffix or ""
	return self:_add("slider", o)
end

-- Small heading: Title, Divider (line above it).
function Tab:section(o: any): any
	return self:_add("section", o)
end

-- Dim text lines: Lines (replace the whole table to update it), Before (space above, 0).
function Tab:note(o: any): any
	o.Before = o.Before or 0
	return self:_add("note", o)
end

-- Collapsible list: Name, Items, All (text of the all-row), Layout ("rows" or "chips"), Accordion (id: only one list
-- of that id stays open), Store, Gap, MaxLabel, OnChange(flag, value) (flag = nil for the all-row).
-- Items: { Name, Flag, Swatch, Default } for switches, { Name, Callback } for plain chips.
function Tab:dropdown(o: any): any
	o.MaxLabel = o.MaxLabel or 19
	return self:_add("dropdown", o)
