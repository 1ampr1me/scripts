local savedLines: { string } = { "Saved: none", "Facing: --" }

-- Remembers the saved position and facing and updates the Teleports tab text.
local function setSaved(x: number, y: number, z: number, face: { number }?): ()
	saved = { x = x, y = y, z = z, face = face }
	savedLines[1] = string.format("Saved: %.0f, %.0f, %.0f", x, y, z)
	savedLines[2] = if face ~= nil then "Facing: saved" else "Facing: not saved"
end

-- Stores the current character position and facing (also written to a workspace file).
local function savePosition(): ()
	local char: any = getCharacter()
	local hrp: any = if char ~= nil then char:FindFirstChild("HumanoidRootPart") else nil
	if hrp == nil then
		notice("No character")
		return
	end
	local x, y, z = readPosition(hrp)
	if x == nil or y == nil or z == nil then
		notice("Can't read position")
		return
	end
	local face = readFacing(hrp)
	setSaved(x, y, z, face)
	local text = string.format("%.2f,%.2f,%.2f", x, y, z)
	if face ~= nil then
		text ..= string.format(",%.4f,%.4f", face[1], face[2])
	end
	writefile(SAVE_FILE, text)
	notice("Position saved")
end

-- Teleports to the stored position and facing.
local function gotoSaved(): ()
	local pos = saved
	if pos == nil then
		notice("No saved position")
		return
	end
	teleportTo("saved position", pos.x, pos.y, pos.z, 0, pos.face)
end

if isfile(SAVE_FILE) then
