-- A Megalodon can spawn outside zones.fishing: exact names are looked up in workspace (no GetChildren on the
-- big root), the small active and active.bosses folders are scanned by name.
local function scanMegalodon(current: { [string]: any }): ()
	local active: any = workspace:FindFirstChild("active")
	local bosses: any = if active ~= nil then active:FindFirstChild("bosses") else nil
	for _, name in MEGA_EXACT do
		local c: any = workspace:FindFirstChild(name)
		if c ~= nil and current[name] == nil then
			current[name] = c
		end
	end
	local roots: { any } = {}
	if active ~= nil then
		table.insert(roots, active)
	end
	if bosses ~= nil then
		table.insert(roots, bosses)
	end
	for _, root in roots do
		for _, c in root:GetChildren() do
			local raw: string = c.Name
			local name = megaNames[raw]
			if name == nil then
				local lower = string.lower(raw)
				if string.find(lower, "megalodon", 1, true) == nil then
					name = false
				elseif string.find(lower, "ancient", 1, true) ~= nil then
					name = "Ancient Megalodon"
				else
					name = "Megalodon"
				end
				megaNames[raw] = name
			end
			if name ~= false and current[name] == nil then
				current[name] = c
			end
		end
	end
end
