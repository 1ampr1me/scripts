-- Adds chip lists (14 names each, alphabetical) that teleport to the spots of one table.
local function addSpotGroups(tab: any, prefix: string, tbl: { [string]: any }): ()
	local names = sortedNames(tbl)
	local per = 14
	local i = 1
	while i <= #names do
		local last = math.min(i + per - 1, #names)
		local items: { any } = {}
		for k = i, last do
			local name: string = names[k]
			local p: any = tbl[name]
			table.insert(items, {
				Name = name,
				Callback = function()
					teleportTo(name, p.X, p.Y, p.Z, 0, nil)
				end,
			})
		end
		local label = string.format("%s %s-%s", prefix, string.upper(string.sub(names[i], 1, 1)), string.upper(string.sub(names[last], 1, 1)))
		tab:dropdown({ Name = label, Items = items, Layout = "chips", Accordion = "tp", MaxLabel = 26 })
		i = last + 1
	end
end

