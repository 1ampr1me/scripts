-- ───────────────────────── Macro ─────────────────────────

-- Switches the phase and stamps the time.
local function go(phase: string, now: number): ()
	S.phase = phase
	S.phaseAt = now
	if phase == "CAST" then
		S.castPressAt = 0
		if S.cycleAt == 0 then
			S.cycleAt = now
		end
	elseif phase == "SHAKE" then
		S.shakeSeen = false
		S.lastShakeAt = 0
	elseif phase == "REEL" then
		resetCtl()
		ctl.resyncs = 0
		S.reelStartAt = now
		S.inTicks = 0
		S.totalTicks = 0
		S.streakBefore = readGameStreak() or -1
		S.maxProgress = 0
		S.reelGoneAt = 0
		S.badTicks = 0
		S.ups0 = S.ups
		S.downs0 = S.downs
	elseif phase == "REEQUIP" then
		S.reequipLeft = 2
		S.reequipAt = 0
	end
end

local pendingRec: any = nil

-- Settles one finished reel. `counted` = the streak events already
-- updated the counters (trackStreak), so only the fallback verdicts (progress) add to them here.
local function finalizeReel(rec: any, caught: boolean, how: string, counted: boolean): ()
	if caught then
		if not counted then
			S.caught += 1
			S.streak += 1
			S.bestStreak = math.max(S.bestStreak, S.streak)
			if rec.cycleDur > 0 then
				S.catchSum += rec.cycleDur
			end
		end
		return
	end
	if not counted then
		S.lost += 1
		S.streak = 0
	end
end

-- Verdict for a pending reel: (caught, how, counted). caught = nil while undecided (force = decide now).
-- A streak rise or drop since the reel started decides it (trackStreak already counted it). If the streak did
-- not move, the reel progress decides after a wait (a loss at streak 0 leaves the value unchanged).
local function verdict(rec: any, now: number, force: boolean): (boolean?, string, boolean)
	rec.after = S.gs
	if S.ups > rec.ups0 then
		return true, "streak up", true
	elseif S.downs > rec.downs0 then
		return false, "streak down", true
	end
	local wait = if rec.before > 0 then STREAK_WAIT_S else STREAK_ZERO_WAIT_S
	if force or now - rec.at > wait then
		local how = if S.gs ~= nil then "streak unchanged" else "no streak"
		return rec.maxP >= CATCH_PCT, how .. ", progress", false
	end
	return nil, "", false
end

-- Settles the pending reel as soon as a verdict exists.
local function resolvePending(now: number): ()
	local rec = pendingRec
	if rec == nil or now - W.resolveAt < 0.1 then
		return
	end
	W.resolveAt = now
	local caught, how, counted = verdict(rec, now, false)
	if caught ~= nil then
		pendingRec = nil
		finalizeReel(rec, caught, how, counted)
	end
end

-- Equips the rod with the game's T key (works from any hotbar slot).
local function equipRod(): ()
	tapKey(VK.T, 0.06)
end

-- True while the character attributes Reeling / ReelActive say a reel is running (read every REEL_ATTR_EVERY s).
-- Learned, not assumed: the end of the attributes is trusted only after they were seen active during a reel.
local function reelAttrActive(char: any, now: number): boolean
	if char == nil then
		return false
	end
	if now - S.attrAt >= REEL_ATTR_EVERY then
		S.attrAt = now
		local reeling: any = char:GetAttribute("Reeling")
		local reelActive: any = char:GetAttribute("ReelActive")
		S.attrReeling = reeling == true or (reelActive ~= nil and reelActive ~= false)
	end
	return S.attrReeling
end

-- Runs one macro tick.
local function step(now: number): ()
	local pg: any = getPlayerGui()
	if pg == nil then
		return
	end
	local char: any = getCharacter()
	local tool: any = if char ~= nil then findTool(char) else nil
	S.rod = if tool ~= nil then tool.Name else "none"

	local reeling = readReel(pg)
	if reeling and S.phase ~= "REEL" then
		releaseMouse()
		go("REEL", now)
	end
	local phase = S.phase

	-- Rod watchdog: re-equip only after the rod was missing for 3 checks in a row.
	if tool ~= nil then
		S.rodMissing = 0
	elseif
		flags.autoEquip == true
		and (phase == "CAST" or phase == "CASTED" or phase == "SHAKE")
		and now - S.rodCheckAt >= 1.2
	then
		S.rodCheckAt = now
		S.rodMissing += 1
		if S.rodMissing >= 3 and now - S.equipAt >= 1.5 then
			S.rodMissing = 0
			S.equipAt = now
			equipRod()
		end
	end

	if phase == "REEL" then
		if reeling then
			S.reelGoneAt = 0
			S.status = "Reeling"
			if not S.attrLearned and reelAttrActive(char, now) then
				S.attrLearned = true
			end
			local p = readProgress()
			if p ~= nil then
				S.progress = p
				S.maxProgress = math.max(S.maxProgress, p)
			end
			if flags.autoReel ~= true then
				releaseMouse()
				return
			end
			ctl.invert = S.progress >= 40 and string.find(string.lower(S.rod), "dreambreaker", 1, true) ~= nil
			local fishX = frameX(reel.fish) + frameW(reel.fish) / 2
			local barX = frameX(reel.playerbar)
			local barW = math.max(0.001, frameW(reel.playerbar))
			S.lastFishX = fishX
			S.lastBarX = barX
			S.resyncs = ctl.resyncs
			if sane(fishX, -0.5, 1.5) and sane(barX, -0.5, 1.5) then
				S.totalTicks += 1
				if math.abs(fishX - barX) <= barW / 2 then
					S.inTicks += 1
				end
				S.badTicks = 0
				reelTrack(fishX, barX, barW)
			else
				S.badTicks += 1
				if S.badTicks > 6 then
					releaseMouse()
				end
			end
		else
			if S.reelGoneAt == 0 then
				S.reelGoneAt = now
			end
			-- The reel is over at once when the attributes (already seen active in a reel) went inactive
			local over = S.attrLearned and not reelAttrActive(char, now)
			local partial = reel.why == "no fish" or reel.why == "no playerbar"
			if not over and now - S.reelGoneAt < (if partial then REEL_PART_GRACE_S else REEL_GONE_S) then
				return -- short miss: keep the mouse state and the tracker
			end
			releaseMouse()
			resetCtl()
			local rec = {
				at = now,
				before = S.streakBefore,
				maxP = S.maxProgress,
				cycleDur = if S.cycleAt > 0 then now - S.cycleAt else 0,
				after = nil :: number?,
				ups0 = S.ups0,
				downs0 = S.downs0,
			}
			if pendingRec ~= nil then
				local caught, how, counted = verdict(pendingRec, now, true)
				finalizeReel(pendingRec, caught == true, "superseded, " .. how, counted)
				pendingRec = nil
			end
			if S.streakBefore >= 0 then
				pendingRec = rec
			else
				finalizeReel(rec, S.maxProgress >= CATCH_PCT, "progress", false)
			end
			S.cycleAt = 0
			S.progress = -1
			go("DONE", now)
		end
	elseif phase == "GOTO" then
		releaseMouse()
		S.status = "Going to saved spot"
		if tpJob == nil and now - S.phaseAt >= 1.0 then
			go("CAST", now)
		end
	elseif phase == "DONE" then
		S.status = "Next cast soon"
		if now - S.phaseAt >= POST_CATCH_S then
			go("CAST", now)
		end
	elseif phase == "CAST" then
		S.power = -1
		if char == nil then
			S.status = "No character"
			return
		end
		if tool == nil then
			releaseMouse()
			S.castPressAt = 0
			S.status = "No rod in hand"
			return
		end
		if shakeUp(pg) or isCasted(tool) then
			releaseMouse()
			go("SHAKE", now)
			return
		end
		if flags.autoCast ~= true then
			releaseMouse()
			S.status = "Waiting (auto cast off)"
			return
		end
		S.status = "Casting"
		holdMouse()
		if S.castPressAt == 0 then
			S.castPressAt = now
		end
		local held = now - S.castPressAt
		local power = readPower(char)
		if power ~= nil then
			S.power = power
		end
		local release = false
		if flags.perfect == true then
			release = (power ~= nil and power >= CAST_FULL) or held >= CAST_TIMEOUT
		else
			release = held * 1000 >= (flags.holdMs or 300)
		end
		if release then
			releaseMouse()
			S.casts += 1
			go("CASTED", now)
		end
	elseif phase == "CASTED" then
		S.status = "Line cast"
		releaseMouse()
		if now - S.phaseAt >= POST_CAST_S then
			go("SHAKE", now)
		end
	elseif phase == "SHAKE" then
		releaseMouse()
		local waited = now - S.phaseAt
		if shakeUp(pg) then
			S.shakeSeen = true
			S.status = "Shaking"
			if flags.autoShake == true and now - S.lastShakeAt >= (flags.shakeMs or 25) / 1000 then
				S.lastShakeAt = now
				S.shakes += 1
				tapKey(VK.Enter, 0.02)
			end
		else
			S.status = "Waiting for a bite"
		end
		-- A cast that never produced a reel keeps values.casted set, so recasting directly would loop back here:
		-- the rod is re-equipped instead, which resets the line.
		if (not S.shakeSeen and waited >= SHAKE_MISS_S) or waited >= SHAKE_LOST_S then
			S.timeouts += 1
			go("REEQUIP", now)
		end
	elseif phase == "REEQUIP" then
		releaseMouse()
		S.status = "Re-equipping rod"
		if S.reequipLeft > 0 then
			if S.reequipAt == 0 or now - S.reequipAt >= 0.4 then
				equipRod()
				S.reequipLeft -= 1
				S.reequipAt = now
			end
		elseif now - S.reequipAt >= 0.6 then
			go("CAST", now)
		end
	end
end

-- Rebuilds the info texts (menu tab and overlay).
local function refreshInfo(now: number): ()
	if now - S.infoAt < INFO_EVERY then
		return
	end
	S.infoAt = now
	infoLines[1] = `State: {if now < S.noticeUntil then S.notice else S.status}`
	infoLines[2] = `Phase: {S.phase}   Rod: {S.rod}`
	infoLines[3] = string.format("Casts: %d   Shakes: %d", S.casts, S.shakes)
	infoLines[4] = string.format("Caught: %d   Lost: %d", S.caught, S.lost)
	infoLines[5] = if S.progress >= 0 then string.format("Reel progress: %.0f%%", S.progress) else "Reel progress: --"
	infoLines[6] = if S.power >= 0 then string.format("Cast power: %.0f%%", S.power) else "Cast power: --"
	local act = S.activeSec
	infoLines[7] = string.format("Uptime: %02d:%02d", math.floor(act / 60), math.floor(act % 60))
	local total = S.caught + S.lost
	local rate = if total > 0 then string.format("%d%%", math.floor(S.caught * 100 / total + 0.5)) else "--"
	local perHour = if act >= 60 then string.format("%.0f", S.caught * 3600 / act) else "--"
	infoLines[8] = `Success: {rate}   Fish/h: {perHour}`
	local avg = if S.caught > 0 and S.catchSum > 0 then string.format("%.0fs", S.catchSum / S.caught) else "--"
	infoLines[9] = `Avg catch: {avg}   Streak: {S.streak} (best {S.bestStreak})`
	infoLines[10] = `Timeouts: {S.timeouts}`
	infoLines[11] = `Offsets: {offsetInfo}`
	infoLines[12] = if HAS_RELEASE then "Mouse release: ok" else "Mouse release: missing (fallback)"
	S.hz = S.tickCount / math.max(0.001, now - S.hzAt)
	S.tickCount = 0
	S.hzAt = now
	infoLines[13] = string.format("Tick rate: %.0f Hz", S.hz)
	local gs = S.gs
	infoLines[14] = if gs ~= nil then `Game streak: {gs} (ours {S.streak})` else "Game streak: unreadable"
	hudLines[1] = S.status
	hudLines[2] = string.format("Caught %d   Lost %d", S.caught, S.lost)
end

-- Starts or stops the macro when the Auto Fish flag changes.
local function syncEnabled(now: number): ()
	local on = flags.enabled == true
	if on == S.wasEnabled then
		return
	end
	S.wasEnabled = on
	if on then
		S.rodMissing = 0
		S.rodCheckAt = now
		local startChar: any = getCharacter()
		if flags.autoEquip == true and (startChar == nil or findTool(startChar) == nil) then
			equipRod()
			S.equipAt = now
		end
		local pos = saved
		if flags.fromSaved == true and pos ~= nil then
			queueTeleport("saved spot", pos.x, pos.y, pos.z, 0, pos.face)
			go("GOTO", now)
			S.status = "Going to saved spot"
		else
			if flags.fromSaved == true then
				notice("No saved position")
			end
			go("CAST", now)
			S.status = "Starting"
		end
		if flags.navOnStart == true and not S.navDone then
			S.navDone = true
			tapKey(VK.Backslash, 0.02)
		end
	else
		releaseMouse()
		resetCtl()
		shakeScan.alt = false
		S.phase = "OFF"
		S.status = "Off"
		S.progress = -1
		S.power = -1
	end
end

-- PostLocal: menu input and callbacks, then the macro tick.
local function onPostLocal(): ()
	ui:update()
	local now = os.clock()
	flushKeys(now)
	stepTeleport(now)
	syncEnabled(now)
	trackStreak(now)
	resolvePending(now)
	if flags.enabled == true then
		S.activeSec += math.min(now - W.lastTick, 0.5)
		if isrbxactive() then
			syncMouse(now)
			step(now)
		else
			releaseMouse()
			S.status = "Roblox not focused"
		end
	end
	S.tickCount += 1
	W.lastTick = now
	if now - W.saveAt >= 2.0 then
		W.saveAt = now
		saveSettings()
	end
	refreshInfo(now)
end

-- PreLocal: extra reel samples between the PostLocal ticks. Uses the reel parts found by the last
-- step() and feeds the same tracker; a destroyed part (no Parent) stops it before any memory read.
local function onPreLocal(): ()
	if flags.enabled ~= true or flags.autoReel ~= true or S.phase ~= "REEL" or S.reelGoneAt ~= 0 then
		return
	end
	local bar: any = reel.bar
	local fish: any = reel.fish
	local playerbar: any = reel.playerbar
	if bar == nil or fish == nil or playerbar == nil then
		return
	end
	if bar.Parent == nil or fish.Parent == nil or playerbar.Parent == nil then
		return
	end
	if not isrbxactive() then
		return
	end
	local fishX = frameX(fish) + frameW(fish) / 2
	local barX = frameX(playerbar)
	local barW = math.max(0.001, frameW(playerbar))
	if sane(fishX, -0.5, 1.5) and sane(barX, -0.5, 1.5) then
		reelTrack(fishX, barX, barW)
	end
end

-- Draws the small info panel in the menu style.
local function drawHud(): ()
	local x, y, w = 16, 16, 190
	local h = 34 + #hudLines * 15
	DrawingImmediate.FilledRectangle(vec(x, y, 0), vec(w, h, 0), T.Bg, 0.92)
	DrawingImmediate.Rectangle(vec(x, y, 0), vec(w, h, 0), T.Divider, 1, 1)
	DrawingImmediate.FilledRectangle(vec(x + 12, y + 13, 0), vec(6, 6, 0), T.White, 1)
	DrawingImmediate.Text(vec(x + 24, y + 9, 0), 13, T.TextMain, 1, "FISCH", false)
	for i, line in hudLines do
		DrawingImmediate.Text(vec(x + 12, y + 28 + (i - 1) * 15, 0), 12, T.TextRow, 1, line, false)
	end
end

-- Render: drawing only.
local function onRender(): ()
	ui:render()
	if flags.hud == true then
		drawHud()
	end
end

table.insert(connections, (RunService.PreLocal:Connect(onPreLocal)))
table.insert(connections, (RunService.PostLocal:Connect(onPostLocal)))
table.insert(connections, (RunService.PostModel:Connect(onPostModel)))
table.insert(connections, (RunService.Render:Connect(onRender)))
