-- ===== Chams (convex hull outlines) =====

-- Projects model parts into screen polygons, fills them and draws one merged outline (convex hull per part).
local Chams: any = (function()
	local ChamsCamera: any = Workspace.CurrentCamera
	local Convex: any = {
		Scratch = { Points = {}, Hull = {}, Poly = {} },
		Static = { HWMPoints = 0, HWMHull = 0, HWMPoly = 0 },
	}
	local GROUP_EPSILON = 0.0001
	local GROUP_JOIN_EPSILON = 0.75

	local function TruncateBuffer(Buffer: any, NewSize: number, HighWaterMark: number): number
		for Index = NewSize + 1, HighWaterMark do
			Buffer[Index] = nil
		end
		return math.max(NewSize, HighWaterMark)
	end

	local function CrossDimension(OriginX: number, OriginY: number, PointAX: number, PointAY: number, PointBX: number, PointBY: number): number
		return (PointAX - OriginX) * (PointBY - OriginY) - (PointAY - OriginY) * (PointBX - OriginX)
	end

	local function CalculateConvexHull(Points: any, PointCount: number, Outer: any): number
		if PointCount == 0 then
			return 0
		end
		if PointCount == 1 then
			Outer[1] = Points[1]
			return 1
		end
		if PointCount == 2 then
			Outer[1] = Points[1]
			Outer[2] = Points[2]
			return 2
		end
		table.sort(Points, function(PointA: any, PointB: any): boolean
			return PointA.X < PointB.X or (PointA.X == PointB.X and PointA.Y < PointB.Y)
		end)
		local Size = 0
		for Index = 1, PointCount do
			local Point = Points[Index]
			while Size >= 2 and CrossDimension(Outer[Size - 1].X, Outer[Size - 1].Y, Outer[Size].X, Outer[Size].Y, Point.X, Point.Y) <= 0 do
				Size = Size - 1
			end
			Size = Size + 1
			Outer[Size] = Point
		end
		local LowerHullSize = Size
		for Index = PointCount - 1, 1, -1 do
			local Point = Points[Index]
			while Size > LowerHullSize and CrossDimension(Outer[Size - 1].X, Outer[Size - 1].Y, Outer[Size].X, Outer[Size].Y, Point.X, Point.Y) <= 0 do
				Size = Size - 1
			end
			Size = Size + 1
			Outer[Size] = Point
		end
		return Size - 1
	end

	local function ProjectPartCorners(Position: any, RightVector: any, UpVector: any, LookVector: any, PartSize: any, WriteOffset: number): number
		local HalfSizeX = PartSize.X * 0.5
		local HalfSizeY = PartSize.Y * 0.5
		local HalfSizeZ = PartSize.Z * 0.5
		local RightX = RightVector.X * HalfSizeX
		local RightY = RightVector.Y * HalfSizeX
		local RightZ = RightVector.Z * HalfSizeX
		local UpX = UpVector.X * HalfSizeY
		local UpY = UpVector.Y * HalfSizeY
		local UpZ = UpVector.Z * HalfSizeY
		local LookX = LookVector.X * HalfSizeZ
		local LookY = LookVector.Y * HalfSizeZ
		local LookZ = LookVector.Z * HalfSizeZ
		local SignR = 1
		for _ = 1, 2 do
			local SignU = 1
			for _ = 1, 2 do
				local SignL = 1
				for _ = 1, 2 do
					local WorldPoint = vector.create(
						Position.X + SignR * RightX + SignU * UpX + SignL * LookX,
						Position.Y + SignR * RightY + SignU * UpY + SignL * LookY,
						Position.Z + SignR * RightZ + SignU * UpZ + SignL * LookZ
					)
					local ScreenPoint, OnScreen = ChamsCamera:WorldToScreenPoint(WorldPoint)
					if OnScreen then
						WriteOffset = WriteOffset + 1
						local Slot = Convex.Scratch.Points[WriteOffset]
						if Slot then
							Slot.X = ScreenPoint.X
							Slot.Y = ScreenPoint.Y
						else
							Convex.Scratch.Points[WriteOffset] = { X = ScreenPoint.X, Y = ScreenPoint.Y }
						end
					end
					SignL = -1
				end
				SignU = -1
			end
			SignR = -1
		end
		return WriteOffset
	end

	local function DrawPolygon(Hull: any, Size: number, Color: Color3, Opacity: number)
		if Size < 3 then
			return
		end
		local Pivot = vector.create(Hull[1].X, Hull[1].Y, 0)
		for Index = 2, Size - 1 do
			DrawingImmediate.FilledTriangle(Pivot, vector.create(Hull[Index].X, Hull[Index].Y, 0), vector.create(Hull[Index + 1].X, Hull[Index + 1].Y, 0), Color, Opacity)
		end
	end

	local function DrawOutline(Hull: any, Size: number, Color: Color3, Opacity: number, Thickness: number)
		if Size < 2 then
			return
		end
		for Index = 1, Size do
			local Entry = Hull[Index]
			Convex.Scratch.Poly[Index] = vector.create(Entry.X, Entry.Y, 0)
		end
		Convex.Scratch.Poly[Size + 1] = vector.create(Hull[1].X, Hull[1].Y, 0)
		Convex.Scratch.Poly[Size + 2] = nil
		if Size + 1 < Convex.Static.HWMPoly then
			for Index = Size + 2, Convex.Static.HWMPoly do
				Convex.Scratch.Poly[Index] = nil
			end
		end
		Convex.Static.HWMPoly = math.max(Convex.Static.HWMPoly, Size + 1)
		DrawingImmediate.Polyline(Convex.Scratch.Poly, Color, Opacity, Thickness)
	end

	local function PolygonArea(Poly: any): number
		local Area = 0
		local Count = #Poly
		for Index = 1, Count do
			local A = Poly[Index]
			local B = Poly[Index % Count + 1]
			Area += A.X * B.Y - B.X * A.Y
		end
		return Area * 0.5
	end

	local function ReversePolygon(Poly: any)
		local Left = 1
		local Right = #Poly
		while Left < Right do
			Poly[Left], Poly[Right] = Poly[Right], Poly[Left]
			Left += 1
			Right -= 1
		end
	end

	local function ExpandPolygon(Poly: any, Padding: number?)
		if not Padding or Padding <= 0 then
			return
		end
		local CenterX = 0
		local CenterY = 0
		for _, Point in Poly do
			CenterX += Point.X
			CenterY += Point.Y
		end
		CenterX /= #Poly
		CenterY /= #Poly
		for _, Point in Poly do
			local DX = Point.X - CenterX
			local DY = Point.Y - CenterY
			local Length = math.sqrt(DX * DX + DY * DY)
			if Length > 0 then
				Point.X += DX / Length * Padding
				Point.Y += DY / Length * Padding
			end
		end
	end

	local function ProjectPartPolygon(Position: any, RightVector: any, UpVector: any, LookVector: any, PartSize: any, Padding: number?): any
		local PointCount = ProjectPartCorners(Position, RightVector, UpVector, LookVector, PartSize, 0)
		Convex.Static.HWMPoints = TruncateBuffer(Convex.Scratch.Points, PointCount, Convex.Static.HWMPoints)
		if PointCount < 3 then
			return nil
		end
		local Size = CalculateConvexHull(Convex.Scratch.Points, PointCount, Convex.Scratch.Hull)
		Convex.Static.HWMHull = TruncateBuffer(Convex.Scratch.Hull, Size, Convex.Static.HWMHull)
		if Size < 3 then
			return nil
		end
		local Poly: any = {}
		for Index = 1, Size do
			local Point = Convex.Scratch.Hull[Index]
			Poly[Index] = { X = Point.X, Y = Point.Y }
		end
		-- Every polygon is made counter-clockwise.
		if PolygonArea(Poly) < 0 then
			ReversePolygon(Poly)
		end
		ExpandPolygon(Poly, Padding)
		return Poly
	end

	local function PointInsideConvex(Point: any, Poly: any): boolean
		for Index = 1, #Poly do
			local A = Poly[Index]
			local B = Poly[Index % #Poly + 1]
			if CrossDimension(A.X, A.Y, B.X, B.Y, Point.X, Point.Y) < -GROUP_EPSILON then
				return false
			end
		end
		return true
	end

	local function SegmentIntersectionT(A: any, B: any, C: any, D: any): number?
		local RX = B.X - A.X
		local RY = B.Y - A.Y
		local SX = D.X - C.X
		local SY = D.Y - C.Y
		local Denominator = RX * SY - RY * SX
		if math.abs(Denominator) <= GROUP_EPSILON then
			return nil
		end
		local QX = C.X - A.X
		local QY = C.Y - A.Y
		local T = (QX * SY - QY * SX) / Denominator
		local U = (QX * RY - QY * RX) / Denominator
		if T > GROUP_EPSILON and T < 1 - GROUP_EPSILON and U >= -GROUP_EPSILON and U <= 1 + GROUP_EPSILON then
			return T
		end
		return nil
	end

	local function LerpPoint(A: any, B: any, T: number): any
		return { X = A.X + (B.X - A.X) * T, Y = A.Y + (B.Y - A.Y) * T }
	end

	local function BuildBoundarySegments(Polygons: any): any
		local Boundary: any = {}
		for PolygonIndex, Poly in Polygons do
			for EdgeIndex = 1, #Poly do
				local A = Poly[EdgeIndex]
				local B = Poly[EdgeIndex % #Poly + 1]
				local Splits: any = { 0, 1 }
				for OtherIndex, Other in Polygons do
					if OtherIndex ~= PolygonIndex then
						for OtherEdgeIndex = 1, #Other do
							local C = Other[OtherEdgeIndex]
							local D = Other[OtherEdgeIndex % #Other + 1]
							local T = SegmentIntersectionT(A, B, C, D)
							if T then
								Splits[#Splits + 1] = T
							end
						end
					end
				end
				table.sort(Splits)
				local CleanSplits: any = {}
				for _, T in Splits do
					if #CleanSplits == 0 or math.abs(T - CleanSplits[#CleanSplits]) > GROUP_EPSILON then
						CleanSplits[#CleanSplits + 1] = T
					end
				end
				for SplitIndex = 1, #CleanSplits - 1 do
					local T1 = CleanSplits[SplitIndex]
					local T2 = CleanSplits[SplitIndex + 1]
					if T2 - T1 <= GROUP_EPSILON then
						continue
					end
					local Mid = LerpPoint(A, B, (T1 + T2) * 0.5)
					local Covered = false
					for OtherIndex, Other in Polygons do
						if OtherIndex ~= PolygonIndex and PointInsideConvex(Mid, Other) then
							Covered = true
							break
						end
					end
					if not Covered then
						Boundary[#Boundary + 1] = { A = LerpPoint(A, B, T1), B = LerpPoint(A, B, T2) }
					end
				end
			end
		end
		return Boundary
	end

	local function SamePoint(A: any, B: any): boolean
		local DX = A.X - B.X
		local DY = A.Y - B.Y
		return DX * DX + DY * DY <= GROUP_JOIN_EPSILON * GROUP_JOIN_EPSILON
	end

	local function StitchBoundary(Segments: any): any
		local Loops: any = {}
		local Used: any = {}
		for StartIndex, StartSegment in Segments do
			if Used[StartIndex] then
				continue
			end
			Used[StartIndex] = true
			local Loop: any = { StartSegment.A, StartSegment.B }
			local StartPoint = StartSegment.A
			local CurrentPoint = StartSegment.B
			local Guard = 0
			while not SamePoint(CurrentPoint, StartPoint) and Guard <= #Segments do
				Guard += 1
				local Found = false
				for Index, Segment in Segments do
					if Used[Index] then
						continue
					end
					if SamePoint(Segment.A, CurrentPoint) then
						Used[Index] = true
						Loop[#Loop + 1] = Segment.B
						CurrentPoint = Segment.B
						Found = true
						break
					elseif SamePoint(Segment.B, CurrentPoint) then
						Used[Index] = true
						Loop[#Loop + 1] = Segment.A
						CurrentPoint = Segment.A
						Found = true
						break
					end
				end
				if not Found then
					break
				end
			end
			if #Loop >= 4 and SamePoint(Loop[#Loop], StartPoint) then
				Loop[#Loop] = nil
				if #Loop >= 3 then
					Loops[#Loops + 1] = Loop
				end
			end
		end
		return Loops
	end

	-- Draws the fill of every part polygon and one merged outline around the whole group.
	local function HighlightGroup(Parts: any, Color: Color3, OpacityFill: number, OpacityOutline: number, Thickness: number, MergePadding: number?)
		MergePadding = MergePadding or 1.25
		local Polygons: any = {}
		for _, Target in Parts do
			if not Target.Parent then
				continue
			end
			local Success, Poly = pcall(ProjectPartPolygon, Target.Position, Target.RightVector, Target.UpVector, Target.LookVector, Target.PartSize, MergePadding)
			if Success and Poly then
				Polygons[#Polygons + 1] = Poly
				if OpacityFill and OpacityFill > 0 then
					DrawPolygon(Poly, #Poly, Color, OpacityFill)
				end
			end
		end
		if #Polygons == 0 then
			return
		end
		if #Polygons == 1 then
			DrawOutline(Polygons[1], #Polygons[1], Color, OpacityOutline, Thickness)
			return
		end
		local Loops = StitchBoundary(BuildBoundarySegments(Polygons))
		if #Loops == 0 then
			for _, Poly in Polygons do
				DrawOutline(Poly, #Poly, Color, OpacityOutline, Thickness)
			end
			return
		end
		for _, Loop in Loops do
			DrawOutline(Loop, #Loop, Color, OpacityOutline, Thickness)
		end
	end

	-- Replaces the camera used for projection.
	local function SetCamera(NewCamera: any)
		if NewCamera then
			ChamsCamera = NewCamera
		end
	end

	return { HighlightGroup = HighlightGroup, SetCamera = SetCamera }
end)()


-- ===== Helpers =====

-- Reads a property without throwing when it does not exist.
local function safeGet(object: any, property: string): any
	local ok, value = pcall(function(): any
		return object[property]
	end)
	if ok then
		return value
	end
	return nil
end

-- Returns the children of an instance, or an empty table on failure.
local function safeChildren(object: any): { any }
	local ok, result = pcall(function(): any
		return object:GetChildren()
	end)
	if ok and type(result) == "table" then
		return result
	end
	return {}
end

-- Returns a named child, or nil.
local function child(object: any, name: string): any
	local ok, result = pcall(function(): any
		return object:FindFirstChild(name)
	end)
	if ok then
		return result
	end
	return nil
end

-- Returns the first child of a class, or nil.
local function childOfClass(object: any, className: string): any
	local ok, result = pcall(function(): any
		return object:FindFirstChildOfClass(className)
	end)
	if ok then
		return result
	end
	return nil
end

-- Returns an attribute as text, or nil when it is missing or empty.
local function attribute(object: any, name: string): string?
	local ok, value = pcall(function(): any
		return object:GetAttribute(name)
	end)
	if not ok or value == nil then
		return nil
	end
	local text = tostring(value)
	if text == "" then
		return nil
	end
	return text
end

-- Returns the first non-empty attribute of the list, or nil.
local function firstAttribute(object: any, names: { string }): string?
	for _, name in names do
		local value = attribute(object, name)
		if value ~= nil then
			return value
		end
	end
	return nil
end

-- Replaces underscores with spaces ("custom_smg" -> "custom smg").
local function prettify(text: string): string
	return (string.gsub(text, "_", " "))
end

-- Upper-cases the first letter.
local function capitalize(text: string): string
	return string.upper(string.sub(text, 1, 1)) .. string.sub(text, 2)
end

-- Sorts labels and joins them into one row; "" when there are none.
local function joinLabels(prefix: string, labels: { string }): string
	if #labels == 0 then
		return ""
	end
	table.sort(labels)
	return prefix .. ": " .. table.concat(labels, ", ")
end

-- True when the instance has a vector Size and Position (i.e. it is a BasePart).
local function isBasePart(object: any): boolean
	return typeof(safeGet(object, "Size")) == "vector" and typeof(safeGet(object, "Position")) == "vector"
end

-- Finds a part that represents the model's position.
local function findRoot(model: any): any
	local root: any = child(model, "HumanoidRootPart") or child(model, "Head")
	if root ~= nil then
		return root
	end
	if isBasePart(model) then
		return model
	end
	local primary: any = safeGet(model, "PrimaryPart")
	if primary ~= nil then
		return primary
	end
	return childOfClass(model, "MeshPart") or childOfClass(model, "Part")
end

-- Returns the position of a model's root part, or nil.
local function positionOf(model: any): vector?
	local root: any = findRoot(model)
	local position: any = if root ~= nil then safeGet(root, "Position") else nil
	if typeof(position) == "vector" then
		return position
	end
	return nil
end

-- Builds ONE oriented box around all parts of a model (axes of its largest part); nil when it has no readable part.
local function readPose(model: any): any
	local parts: { any } = {}

	-- Adds one part when it exposes a complete pose.
	local function add(part: any)
		local size: any = safeGet(part, "Size")
		if typeof(size) ~= "vector" then
			return
		end
		local position: any = safeGet(part, "Position")
		local right: any = safeGet(part, "RightVector")
		local up: any = safeGet(part, "UpVector")
		local look: any = safeGet(part, "LookVector")
		if typeof(position) == "vector" and typeof(right) == "vector" and typeof(up) == "vector" and typeof(look) == "vector" then
			table.insert(parts, { position = position, right = right, up = up, look = look, size = size, volume = size.x * size.y * size.z })
		end
	end

	add(model)
	if #parts == 0 then
		for _, item in safeChildren(model) do
			add(item)
			for _, inner in safeChildren(item) do
				if #parts >= CONFIG.ChamParts then
					break
				end
				add(inner)
			end
			if #parts >= CONFIG.ChamParts then
				break
			end
		end
	end
	if #parts == 0 then
		return nil
	end
	table.sort(parts, function(a: any, b: any): boolean
		return a.volume > b.volume
	end)

	local reference = parts[1]
	local minR: number = math.huge
	local maxR: number = -math.huge
	local minU: number = math.huge
	local maxU: number = -math.huge
	local minL: number = math.huge
	local maxL: number = -math.huge
	for _, part in parts do
		local hx, hy, hz = part.size.x * 0.5, part.size.y * 0.5, part.size.z * 0.5
		for _, signR in { -1, 1 } do
			for _, signU in { -1, 1 } do
				for _, signL in { -1, 1 } do
					local cx = part.position.x + signR * hx * part.right.x + signU * hy * part.up.x + signL * hz * part.look.x
					local cy = part.position.y + signR * hx * part.right.y + signU * hy * part.up.y + signL * hz * part.look.y
					local cz = part.position.z + signR * hx * part.right.z + signU * hy * part.up.z + signL * hz * part.look.z
					local delta = vector.create(cx - reference.position.x, cy - reference.position.y, cz - reference.position.z)
					local r = vector.dot(delta, reference.right)
					local u = vector.dot(delta, reference.up)
					local l = vector.dot(delta, reference.look)
					minR = math.min(minR, r)
					maxR = math.max(maxR, r)
					minU = math.min(minU, u)
					maxU = math.max(maxU, u)
					minL = math.min(minL, l)
					maxL = math.max(maxL, l)
				end
			end
		end
	end

	local center = reference.position
		+ reference.right * ((minR + maxR) * 0.5)
		+ reference.up * ((minU + maxU) * 0.5)
		+ reference.look * ((minL + maxL) * 0.5)
	return {
		Position = center,
		RightVector = reference.right,
		UpVector = reference.up,
		LookVector = reference.look,
		PartSize = vector.create(maxR - minR, maxU - minU, maxL - minL),
		Parent = true,
	}
end

-- Studs above a pose's center where its label is anchored.
local function poseHeight(pose: any): number
	local size = pose.PartSize
	return math.max(size.x, size.y, size.z) * 0.5 + 0.4
end

-- Returns the armor tier estimate for an item id, or nil when unknown.
local function tierOf(itemId: string): number?
	for _, rule in TIER_RULES do
		if string.find(itemId, rule.prefix, 1, true) == 1 then
			return rule.tier
		end
	end
	return nil
end

-- Returns a color that fades from green (full health) to red (dead).
local function healthColor(health: number, maxHealth: number): Color3
	local ratio = math.clamp(health / maxHealth, 0, 1)
	return Color3.fromRGB(math.floor(255 - 175 * ratio), math.floor(60 + 195 * ratio), math.floor(60 + 60 * ratio))
end

-- Packs the header toggles into one number (used as a change detector).
local function headerBits(): number
	return (if Flags.showName == true then 1 else 0) + (if Flags.showHealth == true then 2 else 0) + (if Flags.showDist == true then 4 else 0)
end

-- Builds the two header strings; health is drawn over the padded part of the first one.
local function buildHeader(target: Target, bits: number)
	local text = ""
	if bit32.band(bits, 1) ~= 0 then
		text = target.name
	end
	if bit32.band(bits, 4) ~= 0 then
		local dist = "[" .. tostring(math.floor(math.sqrt(target.distSq))) .. "m]"
		text = if text == "" then dist else text .. " " .. dist
	end
	if bit32.band(bits, 2) ~= 0 and target.health >= 0 then
		local hp = tostring(math.floor(target.health))
		local textLength = utf8.len(text) or #text
		target.headA = if text == "" then "" else string.rep(" ", #hp + 1) .. text
		target.headB = if text == "" then hp else hp .. string.rep(" ", textLength + 1)
	else
		target.headA = text
		target.headB = ""
	end
end

-- Returns "label  [123m]" or just the label.
local function entryText(label: string, distSq: number, showDist: boolean): string
	if showDist then
		return label .. "  [" .. tostring(math.floor(math.sqrt(distSq))) .. "m]"
	end
	return label
end

-- ===== Loot tables =====

local LOOT: { [string]: LootTable } = {}
for name, data in BAKED do
	local items: { { id: string, p: number } } = {}
	for id, chance in string.gmatch(data[3] :: string, "([%w_]+):([%d%.]+)") do
		table.insert(items, { id = id, p = tonumber(chance) or 0 })
	end
	table.sort(items, function(a: { id: string, p: number }, b: { id: string, p: number }): boolean
		return a.p < b.p
	end)
	LOOT[name] = { low = data[1] :: number, high = data[2] :: number, items = items }
end

local previewCache: { [string]: string } = {}

-- Returns the info line of a crate type: roll count and pool size (optionally the rarest possible drops).
local function lootInfo(tableKey: string): string
	local hit = previewCache[tableKey]
	if hit ~= nil then
		return hit
	end
	local tbl = LOOT[tableKey]
	local line = ""
	if tbl ~= nil then
		line = string.format("%d-%d rolls", tbl.low, tbl.high)
		local body = ""
		if CONFIG.PreviewPossible and CONFIG.PreviewCount > 0 then
			local parts: { string } = {}
			for index = 1, math.min(CONFIG.PreviewCount, #tbl.items) do
				table.insert(parts, prettify(tbl.items[index].id))
			end
			body = table.concat(parts, ", ")
			local more = #tbl.items - #parts
			if more > 0 then
				body ..= "  +" .. tostring(more)
			end
			if #body > 46 then
				body = string.sub(body, 1, 43) .. "..."
			end
		end
		if body ~= "" then
			line ..= " | could drop: " .. body
		else
			line = string.format("%s, %d possible items", line, #tbl.items)
		end
	end
	previewCache[tableKey] = line
	return line
end

-- ===== Equipment readers =====

-- Held row: the equipped Tool.
local function readHeld(character: any): string
	local tool: any = childOfClass(character, "Tool")
	if tool == nil then
		return ""
	end
	return "Held: " .. tostring(safeGet(tool, "Name"))
end

-- Armor (with and without tiers) and clothes rows: item names from the ItemId of every worn part.
local function readGear(character: any): (string, string, string)
	local folder: any = child(character, CONFIG.WearFolder)
	if folder == nil then
		return "", "", ""
	end
	local seenParts: { [string]: boolean } = {}
	local seenItems: { [string]: boolean } = {}
	local armor: { string } = {}
	local armorPlain: { string } = {}
	local clothes: { string } = {}
	for _, part in safeChildren(folder) do
		local name = tostring(safeGet(part, "Name"))
		if not seenParts[name] then
			seenParts[name] = true
			local itemId = attribute(part, CONFIG.ItemIdAttribute)
			if itemId ~= nil and not seenItems[itemId] then
				seenItems[itemId] = true
				local tier = tierOf(itemId)
				local text = capitalize(prettify(itemId))
				if (tier ~= nil and tier >= 2) or string.find(name, "armor", 1, true) ~= nil then
					table.insert(armorPlain, text)
					table.insert(armor, if tier ~= nil then text .. " T" .. tostring(tier) else text)
				else
					table.insert(clothes, text)
				end
			end
		end
	end
	return joinLabels("Armor", armor), joinLabels("Armor", armorPlain), joinLabels("Clothes", clothes)
end

-- Backpack row: names of the models in the pack folder.
local function readPack(character: any): string
	local folder: any = child(character, CONFIG.PackFolder)
	if folder == nil then
		return ""
	end
	local labels: { string } = {}
	for _, item in safeChildren(folder) do
		table.insert(labels, tostring(safeGet(item, "Name")))
	end
	return joinLabels("Pack", labels)
end

-- Holster row: weapon id of every holstered model (falls back to the model name).
local function readHolster(character: any): string
	local folder: any = child(character, CONFIG.HolsterFolder)
	if folder == nil then
		return ""
	end
	local labels: { string } = {}
	for _, item in safeChildren(folder) do
		table.insert(labels, prettify(attribute(item, CONFIG.HolsterItemAttribute) or tostring(safeGet(item, "Name"))))
	end
	return joinLabels("Holster", labels)
end

-- Re-reads the equipment rows of one target.
local function readEquipment(target: Target, now: number)
	target.gearAt = now
	local model = target.model
	if target.kind == "player" then
		target.held = readHeld(model)
		target.armor, target.armorPlain, target.clothes = readGear(model)
		target.pack = readPack(model)
		target.holster = readHolster(model)
	elseif target.kind == "npc" then
		local weapon = attribute(model, CONFIG.WeaponAttribute)
		target.held = if weapon ~= nil then "Held: " .. prettify(weapon) else ""
	end
end

-- ===== Targets (players, bots, sleepers) =====

-- Builds one target for a model, or nil when it is out of range, dead or has no usable part.
local function makeTarget(kind: string, name: string, model: any, cameraPos: vector, limitSq: number, static: boolean): Target?
	local root: any = findRoot(model)
	if root == nil then
		return nil
	end
	local position: any = safeGet(root, "Position")
	if typeof(position) ~= "vector" then
		return nil
	end
	local dx = position.x - cameraPos.x
	local dy = position.y - cameraPos.y
	local dz = position.z - cameraPos.z
	local distSq = dx * dx + dy * dy + dz * dz
	if distSq > limitSq then
		return nil
	end

	local humanoid: any = childOfClass(model, "Humanoid")
	local health = -1
	local maxHealth = 100
	if humanoid ~= nil then
		local value: any = safeGet(humanoid, "Health")
		if type(value) == "number" then
			health = value
		end
		local maxValue: any = safeGet(humanoid, "MaxHealth")
		if type(maxValue) == "number" and maxValue > 0 then
			maxHealth = maxValue
		end
	end
	if kind == "npc" then
		if (humanoid ~= nil and health >= 0 and health <= 0) or attribute(model, "Dead") == "true" then
			return nil
		end
	end

	local bits = headerBits()
	local target: Target = {
		kind = kind,
		model = model,
		name = name,
		nameColor = if kind == "player" then COLORS.Player elseif kind == "sleeper" then COLORS.Sleeper else COLORS.Npc,
		root = root,
		humanoid = humanoid,
		static = static,
		ready = static, -- moving targets wait for PostLocal's first position read
		dead = false,
		position = position,
		distSq = distSq,
		nextUpdate = 0,
		gearAt = -1000,
		health = health,
		maxHealth = maxHealth,
		hpColor = if health >= 0 then healthColor(health, maxHealth) else COLORS.Player,
		lastHp = math.floor(health),
		lastDist = math.floor(math.sqrt(distSq)),
		lastBits = bits,
		headA = "",
		headB = "",
		held = "",
		armor = "",
		armorPlain = "",
		clothes = "",
		pack = "",
		holster = "",
	}
	buildHeader(target, bits)
	return target
end

-- Returns the camera position and the squared range of a range flag, or nil without a camera.
local function rangeOf(flag: string, margin: number): (vector?, number)
	local camera: any = Workspace.CurrentCamera
	if camera == nil then
		return nil, 0
	end
	local limit: number = (Flags[flag] :: number) + margin
	return camera.Position, limit * limit
end

-- Syncs players and bots: keeps existing entries (no flicker), adds new ones, drops vanished ones.
local function syncLive()
	local cameraPos, playerSq = rangeOf("playerDist", 50)
	local _, npcSq = rangeOf("npcDist", 50)
	if cameraPos == nil then
		return
	end
	local old = Live
	local list: { Target } = {}

	-- Returns the live entry that already wraps this model.
	local function existing(model: any): Target?
		for _, target in old do
			if target.model == model and not target.dead then
				return target
			end
		end
		return nil
	end

	if Flags.playersOn == true then
		local showSelf = Flags.showSelf == true
		local localPlayer: any = Players.LocalPlayer
		for _, player in safeChildren(Players) do
			if showSelf or player ~= localPlayer then
				local character: any = safeGet(player, "Character")
				if character ~= nil then
					local target = existing(character)
					if target ~= nil then
						if target.distSq <= playerSq * 1.44 then
							table.insert(list, target)
						end
					else
						target = makeTarget("player", tostring(safeGet(player, "DisplayName")), character, cameraPos, playerSq, false)
						if target ~= nil then
							table.insert(list, target)
						end
					end
				end
			end
		end
	end

	if Flags.npcsOn == true then
		local folder: any = child(Workspace, CONFIG.NpcFolder)
		if folder ~= nil then
			for _, npc in safeChildren(folder) do
				local target = existing(npc)
				if target ~= nil then
					if target.distSq <= npcSq * 1.44 then
						table.insert(list, target)
					end
				else
					local name = capitalize(prettify(attribute(npc, CONFIG.NpcKindAttribute) or tostring(safeGet(npc, "Name"))))
					target = makeTarget("npc", name, npc, cameraPos, npcSq, false)
					if target ~= nil then
						table.insert(list, target)
					end
				end
			end
		end
	end
	Live = list
end

-- Rebuilds the (static) sleeper list.
local function syncSleepers()
	local list: { Target } = {}
	local cameraPos, sleeperSq = rangeOf("sleeperDist", 50)
	local folder: any = child(Workspace, CONFIG.SleeperFolder)
	if cameraPos ~= nil and folder ~= nil and Flags.sleepersOn == true then
		for _, sleeper in safeChildren(folder) do
			local name = attribute(sleeper, CONFIG.SleeperNameAttribute) or tostring(safeGet(sleeper, "Name"))
			local target = makeTarget("sleeper", name, sleeper, cameraPos, sleeperSq, true)
			if target ~= nil then
				table.insert(list, target)
			end
		end
	end
	Sleepers = list
end

local equipCursor = 1

-- Re-reads the equipment of the next targets in turn, until the time budget of this tick is used up.
local function stepEquipment(now: number, deadline: number)
	local count = #Live
	local interval = (Flags.refreshMs :: number) / 1000
	for _ = 1, count do
		if equipCursor > count then
			equipCursor = 1
		end
		local target = Live[equipCursor]
		equipCursor += 1
		if not target.dead and now - target.gearAt >= interval then
			readEquipment(target, now)
			if os.clock() >= deadline then
				return
			end
		end
	end
end

-- ===== Time-sliced scans (ground items, world objects) =====

-- Runs a scan until the deadline; returns true once every job is finished.
local function stepScan(scan: Scan, deadline: number): boolean
	while scan.jobIndex <= #scan.jobs do
		local job = scan.jobs[scan.jobIndex]
		local items = job.items
		local processed = 0
		while scan.itemIndex <= #items do
			job.process(items[scan.itemIndex])
			scan.itemIndex += 1
			processed += 1
			if processed % 4 == 0 and os.clock() >= deadline then
				return false
			end
		end
		scan.jobIndex += 1
		scan.itemIndex = 1
	end
	return true
end

-- Starts a scan of pickups and dropped items near the camera.
local function startGroundScan(): Scan?
	local cameraPos, limitSq = rangeOf("itemDist", 50)
	if cameraPos == nil then
		return nil
	end
	local out: { GroundEntry } = {}
	local jobs: { ScanJob } = {}
	local showAmount = Flags.showAmount == true
	local showDist = Flags.showDist == true

	-- Squared distance from the camera.
	local function distanceSq(position: vector): number
		local dx = position.x - cameraPos.x
		local dy = position.y - cameraPos.y
		local dz = position.z - cameraPos.z
		return dx * dx + dy * dy + dz * dz
	end

	if Flags.pickupsOn == true then
		local folder: any = child(Workspace, CONFIG.PickupFolder)
		if folder ~= nil then
			table.insert(jobs, {
				items = safeChildren(folder),
				process = function(pickup: any)
					local part: any = childOfClass(pickup, "MeshPart")
					local position: any = if part ~= nil then safeGet(part, "Position") else nil
					if typeof(position) ~= "vector" then
						return
					end
					local distSq = distanceSq(position)
					if distSq > limitSq then
						return
					end
					local kind = string.lower(attribute(pickup, CONFIG.PickupTypeAttribute) or tostring(safeGet(pickup, "Name")))
					local base = capitalize(prettify(kind))
					if showAmount then
						local amount = tonumber(attribute(pickup, CONFIG.PickupAmountAttribute))
						if amount ~= nil then
							base ..= " x" .. tostring(math.floor(amount))
						end
					end
					table.insert(out, {
						group = "pickups",
						flag = if KnownPickup[kind] then "type_" .. kind else "type_other",
						base = base,
						position = position,
						distSq = distSq,
						text = if showDist then base .. " [" .. tostring(math.floor(math.sqrt(distSq))) .. "m]" else base,
						color = PICKUP_COLORS[kind] or COLORS.PickupOther,
					})
				end,
			})
		end
	end

	if Flags.droppedOn == true then
		local folder: any = child(Workspace, CONFIG.WorldItemFolder)
		if folder ~= nil then
			table.insert(jobs, {
				items = safeChildren(folder),
				process = function(item: any)
					local position = positionOf(item)
					if position == nil then
						return
					end
					local distSq = distanceSq(position)
					if distSq > limitSq then
						return
					end
					local base = capitalize(prettify(firstAttribute(item, CONFIG.WorldItemAttributes) or tostring(safeGet(item, "Name"))))
					if showAmount then
						local amount = tonumber(firstAttribute(item, CONFIG.AmountAttributes))
						if amount ~= nil then
							base ..= " x" .. tostring(math.floor(amount))
						end
					end
					table.insert(out, {
						group = "dropped",
						flag = "",
						base = base,
						position = position,
						distSq = distSq,
						text = if showDist then base .. " [" .. tostring(math.floor(math.sqrt(distSq))) .. "m]" else base,
						color = COLORS.Dropped,
					})
				end,
			})
		end
	end

	return {
		jobs = jobs,
		jobIndex = 1,
		itemIndex = 1,
		finish = function()
			SnapGround = out
		end,
	}
end

-- Returns the position of a recycler model (marker parts first, then any part).
local function recyclerPosition(model: any): vector?
	for _, name in { "Marker_Prompt", "Body", "Hopper", "Frame" } do
		local part: any = child(model, name)
		if part ~= nil then
			local position: any = safeGet(part, "Position")
			if typeof(position) == "vector" then
				return position
			end
		end
	end
	return positionOf(model)
end

-- Walks the monuments (one level of garages) and the workspace top for recycler models.
local function scanRecyclers(): { RecyclerInfo }
	local out: { RecyclerInfo } = {}
	local taken: { any } = {}

	-- Adds one recycler model once (a model reachable through two paths is only counted once).
	local function take(model: any)
		for _, other in taken do
			if other == model then
				return
			end
		end
		table.insert(taken, model)
		local kind = attribute(model, "Kind")
		if kind ~= nil and kind ~= "recycler" then
			return
		end
		if kind == nil and child(model, "Marker_Prompt") == nil then
			return
		end
		local pose = readPose(model)
		local position = recyclerPosition(model)
		if position == nil then
			return
		end
		local parent: any = safeGet(model, "Parent")
		local fallback = if parent ~= nil then tostring(safeGet(parent, "Name")) else CONFIG.RecyclerName
		local place: string = attribute(model, "Monument") or attribute(model, "RecyclerId") or fallback
		table.insert(out, {
			position = position,
			label = place,
			on = attribute(model, "On") == "true",
			poses = if pose ~= nil then { pose } else {},
			height = if pose ~= nil then poseHeight(pose) else 3,
		})
	end

	local map: any = child(Workspace, CONFIG.MapFolder)
	local monuments: any = if map ~= nil then child(map, CONFIG.MonumentFolder) else nil
	if monuments ~= nil then
		for _, monument in safeChildren(monuments) do
			local direct: any = child(monument, CONFIG.RecyclerName)
			if direct ~= nil then
				take(direct)
			end
			for _, sub in safeChildren(monument) do
				local nested: any = child(sub, CONFIG.RecyclerName)
				if nested ~= nil then
					take(nested)
				end
			end
		end
	end
	for _, top in safeChildren(Workspace) do
		if safeGet(top, "Name") == CONFIG.RecyclerName then
			take(top)
		end
	end
	return out
end

-- Label of a player-placed object, with its power / lock / lit state when it has one.
local function baseLabel(def: { cat: string, label: string, color: Color3 }, model: any): string
	local label = def.label
	if def.cat == "turrets" or def.cat == "power" then
		local power = attribute(model, "PowerOn")
		if power ~= nil then
			label ..= if power == "true" then " [on]" else " [off]"
		end
	elseif def.cat == "storage" then
		if attribute(model, "Locked") == "true" then
			label ..= " [locked]"
		end
	elseif def.cat == "furnaces" then
		if attribute(model, "Lit") == "true" then
			label ..= " [lit]"
		end
	elseif def.cat == "bags" then
		local owner = attribute(model, "BagName")
		if owner ~= nil then
			label ..= " - " .. owner
		end
	end
	return label
end

-- Starts a scan of ore nodes, crates, airdrops and recyclers near the camera.
local function startWorldScan(): Scan?
	local cameraPos, limitSq = rangeOf("worldDist", 50)
	if cameraPos == nil then
		return nil
	end
	local _, baseSq = rangeOf("baseDist", 50)
	local out: { WorldEntry } = {}
	local jobs: { ScanJob } = {}
	local showDist = Flags.showDist == true

	-- Squared distance from the camera.
	local function distanceSq(position: vector): number
		local dx = position.x - cameraPos.x
		local dy = position.y - cameraPos.y
		local dz = position.z - cameraPos.z
		return dx * dx + dy * dy + dz * dz
	end

	if Flags.baseOn == true then
		local folder: any = child(Workspace, CONFIG.DeployableFolder)
		if folder ~= nil then
			table.insert(jobs, {
				items = safeChildren(folder),
				process = function(object: any)
					local def = BASE_KINDS[tostring(safeGet(object, "Name"))]
					if def == nil or Flags["base_" .. def.cat] ~= true then
						return
					end
					local near = positionOf(object)
					if near == nil or distanceSq(near) > baseSq then
						return
					end
					local pose = readPose(object)
					local position: vector = if pose ~= nil then pose.Position else near
					local distSq = distanceSq(position)
					local label = baseLabel(def, object)
					table.insert(out, {
						group = "base",
						flag = "base_" .. def.cat,
						label = label,
						sub = "",
						infoKey = "",
						height = if pose ~= nil then poseHeight(pose) else 2,
						color = def.color,
						position = position,
						distSq = distSq,
						text = entryText(label, distSq, showDist),
						poses = if pose ~= nil then { pose } else {},
					})
				end,
			})
		end
	end

	if Flags.oreOn == true then
		local folder: any = child(Workspace, CONFIG.NodeFolder)
		local onlyUnmined = Flags.oreUnmined == true
		if folder ~= nil then
			table.insert(jobs, {
				items = safeChildren(folder),
				process = function(node: any)
					local def = ORE_KINDS[tostring(safeGet(node, "Name"))]
					if def == nil or Flags["ore_" .. def.key] ~= true then
						return
					end
					-- A metal / sulfur node keeps its Ore child only while it can still be mined; stone never has one.
					if onlyUnmined and def.key ~= "stone" and child(node, "Ore") == nil then
						return
					end
					local pose = readPose(node)
					local position: vector? = if pose ~= nil then pose.Position else positionOf(node)
					if position == nil then
						return
					end
					local distSq = distanceSq(position)
					if distSq > limitSq then
						return
					end
					local label = def.label
					local hp = tonumber(attribute(node, CONFIG.HpAttribute))
					local maxHp = tonumber(attribute(node, CONFIG.MaxHpAttribute))
					if hp ~= nil and maxHp ~= nil and maxHp > 0 and hp < maxHp then
						label = string.format("%s  %.0f%%", def.label, 100 * hp / maxHp)
					end
					table.insert(out, {
						group = "ore",
						flag = "ore_" .. def.key,
						label = label,
						sub = "",
						infoKey = "",
						height = if pose ~= nil then poseHeight(pose) else 3,
						color = def.color,
						position = position,
						distSq = distSq,
						text = entryText(label, distSq, showDist),
						poses = if pose ~= nil then { pose } else {},
					})
				end,
			})
		end
	end

	if Flags.lootOn == true then
		local hideOpen = Flags.lootHideOpen == true
		for _, folderName in { CONFIG.LootFolder, CONFIG.AirdropFolder } do
			local folder: any = child(Workspace, folderName)
			if folder ~= nil then
				table.insert(jobs, {
					items = safeChildren(folder),
					process = function(crate: any)
						local def = CRATE_KINDS[tostring(safeGet(crate, "Name"))]
						if def == nil or Flags["loot_" .. def.key] ~= true then
							return
						end
						if hideOpen and attribute(crate, CONFIG.OpenAttribute) == "true" then
							return
						end
						local pose = readPose(crate)
						local position: vector? = if pose ~= nil then pose.Position else positionOf(crate)
						if position == nil then
							return
						end
						local distSq = distanceSq(position)
						if distSq > limitSq then
							return
						end
						table.insert(out, {
							group = "loot",
							flag = "loot_" .. def.key,
							label = def.label,
							sub = "",
							infoKey = def.tbl,
							height = if pose ~= nil then poseHeight(pose) else 3,
							color = def.color,
							position = position,
							distSq = distSq,
							text = entryText(def.label, distSq, showDist),
							poses = if pose ~= nil then { pose } else {},
						})
					end,
				})
			end
		end
	end

	return {
		jobs = jobs,
		jobIndex = 1,
		itemIndex = 1,
		finish = function()
			if Flags.recyclerOn == true then
				for _, recycler in Recyclers do
					local distSq = distanceSq(recycler.position)
					if distSq <= limitSq then
						local label = "Recycler - " .. recycler.label
						table.insert(out, {
							group = "recycler",
							flag = "",
							label = label,
							sub = if recycler.on then "running" else "",
							infoKey = "",
							height = recycler.height,
							color = COLORS.Recycler,
							position = recycler.position,
							distSq = distSq,
							text = entryText(label, distSq, showDist),
							poses = recycler.poses,
						})
					end
				end
			end
			table.sort(out, function(a: WorldEntry, b: WorldEntry): boolean
				return a.distSq < b.distSq
			end)
			-- Only the nearest crates get the second info line, so the screen stays legible.
			if Flags.lootInfo == true then
				local linesLeft = CONFIG.LootInfoLines
				for _, entry in out do
					if entry.group == "loot" and linesLeft > 0 then
						linesLeft -= 1
						entry.sub = lootInfo(entry.infoKey)
					end
				end
			end
			SnapWorld = out
		end,
	}
end


