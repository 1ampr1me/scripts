-- ===== Events =====

local NEAR_SQ = CONFIG.NearRange * CONFIG.NearRange
local lastRoster = -1000
local lastSlow = -1000
local lastRecyclers = -1000
local lastModelStep = 0
local lastTextUpdate = 0
local groundScan: Scan? = nil
local worldScan: Scan? = nil

-- Model step: roster syncs, scans and equipment reads, all sliced to a small time budget per tick.
local function modelStep(now: number)
	lastModelStep = now
	if now - lastRoster >= CONFIG.RosterRate then
		lastRoster = now
		syncLive()
	end
	if now - lastSlow >= CONFIG.SlowRate then
		lastSlow = now
		syncSleepers()
		if Flags.recyclerOn == true and now - lastRecyclers >= CONFIG.RecyclerRate then
			lastRecyclers = now
			Recyclers = scanRecyclers()
		end
		if groundScan == nil then
			groundScan = startGroundScan()
		end
		if worldScan == nil then
			worldScan = startWorldScan()
		end
	end

	stepEquipment(now, os.clock() + CONFIG.SliceBudget)

	local ground = groundScan
	if ground ~= nil and stepScan(ground, os.clock() + CONFIG.SliceBudget) then
		ground.finish()
		groundScan = nil
	end
	local world = worldScan
	if world ~= nil and stepScan(world, os.clock() + CONFIG.SliceBudget) then
		world.finish()
		worldScan = nil
	end
end

-- Model step: character / world models are read here.
RunService.PostModel:Connect(function()
	modelStep(os.clock())
end)

-- Refreshes position, health and distance of one target and rebuilds its header only when something changed.
local function refreshTarget(target: Target, cameraPos: vector, now: number, bits: number)
	if not target.static then
		if now < target.nextUpdate then
			return
		end
		target.nextUpdate = now + (if target.distSq < NEAR_SQ then 0 else CONFIG.FarInterval)
		local position: any = safeGet(target.root, "Position")
		if typeof(position) ~= "vector" then
			target.dead = true
			target.ready = false
			return
		end
		target.position = position
		target.ready = true
		if target.humanoid ~= nil then
			local value: any = safeGet(target.humanoid, "Health")
			if type(value) == "number" then
				target.health = value
			end
		end
	end
	local dx = target.position.x - cameraPos.x
	local dy = target.position.y - cameraPos.y
	local dz = target.position.z - cameraPos.z
	local distSq = dx * dx + dy * dy + dz * dz
	target.distSq = distSq

	local hp = math.floor(target.health)
	local dist = math.floor(math.sqrt(distSq))
	if hp ~= target.lastHp or dist ~= target.lastDist or bits ~= target.lastBits then
		if hp ~= target.lastHp and target.health >= 0 then
			target.hpColor = healthColor(target.health, target.maxHealth)
		end
		target.lastHp = hp
		target.lastDist = dist
		target.lastBits = bits
		buildHeader(target, bits)
	end
end

-- Local step: menu input, camera, positions, health and distances; also drives the model step if PostModel stalls.
RunService.PostLocal:Connect(function()
	ui:update()
	local now = os.clock()
	if now - lastModelStep > CONFIG.FallbackAfter then
		modelStep(now)
	end

	local camera: any = Workspace.CurrentCamera
	if camera == nil then
		return
	end
	Camera = camera
	Chams.SetCamera(camera)
	local cameraPos: vector = camera.Position
	local bits = headerBits()
	for _, target in Live do
		refreshTarget(target, cameraPos, now, bits)
	end
	for _, target in Sleepers do
		refreshTarget(target, cameraPos, now, bits)
	end

	-- Static world entries: distances every tick, label strings four times a second.
	local updateText = now - lastTextUpdate >= 0.25
	if updateText then
		lastTextUpdate = now
	end
	local showDist = Flags.showDist == true
	for _, entry in SnapGround do
		local dx = entry.position.x - cameraPos.x
		local dy = entry.position.y - cameraPos.y
		local dz = entry.position.z - cameraPos.z
		entry.distSq = dx * dx + dy * dy + dz * dz
		if updateText then
			entry.text = if showDist then entry.base .. " [" .. tostring(math.floor(math.sqrt(entry.distSq))) .. "m]" else entry.base
		end
	end
	for _, entry in SnapWorld do
		local dx = entry.position.x - cameraPos.x
		local dy = entry.position.y - cameraPos.y
		local dz = entry.position.z - cameraPos.z
		entry.distSq = dx * dx + dy * dy + dz * dz
		if updateText then
			entry.text = entryText(entry.label, entry.distSq, showDist)
		end
	end
end)

-- ===== Drawing =====

-- Draws one text line centered at x.
local function drawText(x: number, y: number, size: number, color: Color3, text: string)
	DrawingImmediate.OutlinedText(vector.create(x, y, 0), size, color, 1, text, true, CONFIG.Font)
end

-- Draws one info row and returns the next line index; empty rows are skipped or replaced by a placeholder.
local function drawRow(x: number, y: number, line: number, color: Color3, text: string, emptyText: string): number
	local shown = text
	if shown == "" then
		if ViewState.hideEmpty then
			return line
		end
		shown = emptyText
	end
	drawText(x, y + line * (ViewState.size + 2), ViewState.size, color, shown)
	return line + 1
end

-- Draws one target: header (name / distance with health in front) and the equipment rows.
local function drawTarget(target: Target, camera: any)
	local position = target.position
	local offset = if target.kind == "sleeper" then ViewState.sleeperLift else CONFIG.AnchorOffset
	local screen, visible = camera:WorldToScreenPoint(vector.create(position.x, position.y + offset, position.z))
	if not visible then
		return
	end
	local x: number = screen.x
	local y: number = screen.y
	local size = ViewState.size
	local line = 0
	if target.headA ~= "" or target.headB ~= "" then
		if target.headA ~= "" then
			drawText(x, y, size, target.nameColor, target.headA)
		end
		if target.headB ~= "" then
			drawText(x, y, size, target.hpColor, target.headB)
		end
		line = 1
	end
	if ViewState.held then
		line = drawRow(x, y, line, COLORS.Held, target.held, EMPTY_ROWS.Held)
	end
	if ViewState.armor then
		line = drawRow(x, y, line, COLORS.Armor, if ViewState.tier then target.armor else target.armorPlain, EMPTY_ROWS.Armor)
	end
	if ViewState.clothes then
		line = drawRow(x, y, line, COLORS.Clothes, target.clothes, EMPTY_ROWS.Clothes)
	end
	if ViewState.pack then
		line = drawRow(x, y, line, COLORS.Pack, target.pack, EMPTY_ROWS.Pack)
	end
	if ViewState.holster then
		drawRow(x, y, line, COLORS.Holster, target.holster, EMPTY_ROWS.Holster)
	end
end

-- True when the world entry's group and type toggles are on.
local function worldVisible(entry: WorldEntry): boolean
	local group = entry.group
	if group == "ore" then
		if Flags.oreOn ~= true then
			return false
		end
	elseif group == "loot" then
		if Flags.lootOn ~= true then
			return false
		end
	elseif group == "base" then
		if Flags.baseOn ~= true then
			return false
		end
	elseif Flags.recyclerOn ~= true then
		return false
	end
	return entry.flag == "" or Flags[entry.flag] == true
end

-- Render step: menu + overlay, drawing only.
RunService.Render:Connect(function()
	ui:render()
	local camera: any = Camera
	if camera == nil then
		return
	end
	local size = Flags.textSize :: number
	ViewState.size = size
	ViewState.hideEmpty = Flags.hideEmpty == true
	ViewState.held = Flags.showHeld == true
	ViewState.armor = Flags.showArmor == true
	ViewState.tier = Flags.showTier == true
	ViewState.clothes = Flags.showClothes == true
	ViewState.pack = Flags.showPack == true
	ViewState.holster = Flags.showHolster == true
	ViewState.sleeperLift = Flags.sleeperLift :: number

	local playerDist = Flags.playerDist :: number
	local npcDist = Flags.npcDist :: number
	local sleeperDist = Flags.sleeperDist :: number
	local playerSq = playerDist * playerDist
	local npcSq = npcDist * npcDist
	local sleeperSq = sleeperDist * sleeperDist

	local playersOn = Flags.playersOn == true
	local npcsOn = Flags.npcsOn == true
	for _, target in Live do
		if target.ready then
			if target.kind == "player" then
				if playersOn and target.distSq <= playerSq then
					drawTarget(target, camera)
				end
			elseif npcsOn and target.distSq <= npcSq then
				drawTarget(target, camera)
			end
		end
	end

	if Flags.sleepersOn == true then
		for _, target in Sleepers do
			if target.distSq <= sleeperSq then
				drawTarget(target, camera)
			end
		end
	end

	local worldDist = Flags.worldDist :: number
	local worldSq = worldDist * worldDist
	local baseDist = Flags.baseDist :: number
	local baseSq = baseDist * baseDist
	local labelSq = CONFIG.LabelRange * CONFIG.LabelRange
	local labelsLeft = CONFIG.LabelMax
	local chamsLeft = if Flags.chamsOn == true then CONFIG.ChamsLimit else 0
	for _, entry in SnapWorld do
		if entry.distSq <= (if entry.group == "base" then baseSq else worldSq) and worldVisible(entry) then
			local position = entry.position
			local center, centerVisible = camera:WorldToScreenPoint(position)
			if centerVisible then
				-- One outlined box per object, in the object's own color.
				if chamsLeft > 0 and #entry.poses > 0 then
					chamsLeft -= 1
					pcall(Chams.HighlightGroup, entry.poses, entry.color, CONFIG.ChamsFill, 1, CONFIG.ChamsThickness, CONFIG.ChamsMerge)
				end
				if labelsLeft > 0 and entry.distSq <= labelSq then
					labelsLeft -= 1
					local top = camera:WorldToScreenPoint(vector.create(position.x, position.y + entry.height, position.z))
					drawText(top.x, top.y - size - 3, size, entry.color, entry.text)
					if entry.sub ~= "" then
						drawText(center.x, center.y + (center.y - top.y) + 2, size - 1, entry.color, entry.sub)
					end
				end
			end
		end
	end

	local itemDist = Flags.itemDist :: number
	local itemSq = itemDist * itemDist
	local pickupsOn = Flags.pickupsOn == true
	local droppedOn = Flags.droppedOn == true
	for _, entry in SnapGround do
		if entry.distSq <= itemSq then
			local visibleGroup = if entry.group == "pickups" then pickupsOn and Flags[entry.flag] == true else droppedOn
			if visibleGroup then
				local position = entry.position
				local screen, visible = camera:WorldToScreenPoint(vector.create(position.x, position.y + CONFIG.GroundLift, position.z))
				if visible then
					drawText(screen.x, screen.y, size, entry.color, entry.text)
				end
			end
		end
	end
end)
