local lastCamT: number = 0
local lastScreenT: number = 0
local lastCacheT: number = 0

local function onPostLocal(): ()
	if not running then
		return
	end
	local now = os.clock()

	if now - lastCamT >= CAM_RATE then
		lastCamT = now
		Camera = Workspace.CurrentCamera
	end
	if now - lastScreenT >= SCREEN_RATE then
		lastScreenT = now
		updateScreenSize()
	end
	ui:update()

	local espOn: boolean = Config.Enabled
	if not espOn and not Config.Missile and not Config.TeamCount then
		Front = EMPTY
		TargetCount = 0
		hideAllRings()
		return
	end
	if now - lastCacheT >= CACHE_RATE then
		lastCacheT = now
		if espOn then
			rebuildCache()
		end
		if Config.TeamCount then
			countTeams()
		end
	end
	buildFrame(now)
end

local function onRender(): ()
	if not running then
		return
	end
	drawBuffer(Front)
	ui:render()
end

local connRender: any = RunService.Render:Connect(onRender)
local connLogic: any = RunService.PostLocal:Connect(onPostLocal)

local function disconnect(conn: any): ()
	local ok = pcall(function()
		conn:Disconnect()
	end)
	if not ok then
		pcall(function()
			conn:disconnect()
		end)
	end
end

local function stop(): ()
	running = false
	disconnect(connRender)
	disconnect(connLogic)
	ui:destroy()
	for _, pool in { HeliPool, MslPool } do
		for _, ring in pool.list do
			ring:Remove()
		end
		table.clear(pool.list)
		pool.used = 0
	end
end

_G.TankESP = { stop = stop }

pcall(send_notification, "Tank ESP loaded - RIGHT SHIFT toggles the menu")
