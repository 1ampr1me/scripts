local function resolveMslContainers(now: number): ()
	lastMslResolveT = now
	local list: { any } = {}
	local rs: any = game:GetService("ReplicatedStorage")
	local bullets = child(child(child(rs, "PHRST"), "Shells"), "PhysicalBullets")
	if bullets then
		list[#list + 1] = bullets
	end
	local ter = Workspace:FindFirstChild("Terrain")
	if ter then
		list[#list + 1] = ter
	end
	MslContainers = list
end

-- A projectile counts as flying when it moved between scans; any projectile heading at the camera (cos > INCOMING_COS, within INBOUND_RANGE) is incoming.
local function scanMissiles(now: number, camPos: vector): ()
	if #MslContainers == 0 or now - lastMslResolveT > 5 then
		resolveMslContainers(now)
	end
	local out: { MslTarget } = {}
	local seen: { [any]: boolean } = {}
	local threatNear: boolean = false

	for _, cont in MslContainers do
		for _, c in cont:GetChildren() do
			local cat = projCat(c.Name)
			if not cat then
				continue
			end
			local cn: string = c.ClassName
			local anchor: any = nil
			if cn == "Model" then
				anchor = c.PrimaryPart
			elseif MSL_PART[cn] then
				anchor = c
			end
			if not anchor then
				continue
			end
			local key = c.Data
			if not key then
				continue
			end
			seen[key] = true

			local pos: vector = anchor.CFrame.Position
			local prev = MslPrev[key]
			MslPrev[key] = pos
			if not prev then
				continue
			end
			local mv: vector = pos - prev
			local mv2 = vector.dot(mv, mv)
			if mv2 <= MSL_MOVE2 then
				continue
			end

			local toMe: vector = camPos - pos
			local dl2 = vector.dot(toMe, toMe)
			local incoming = false
			if dl2 > 1 and dl2 < INBOUND_RANGE * INBOUND_RANGE then
				local dv = vector.dot(mv, toMe)
				if dv > 0 and dv * dv > INCOMING_COS * INCOMING_COS * mv2 * dl2 then
					incoming = true
					threatNear = true
				end
			end
			out[#out + 1] = {
				anchor = anchor, label = cat.label, col = MSL_COL[cat.label] or Col.Missile,
				incoming = incoming, distM = -1, text = "",
			}
		end
	end
	for key in MslPrev do
		if not seen[key] then
			MslPrev[key] = nil
		end
	end
	MslTargets = out

	if threatNear then
		InboundUntil = now + INBOUND_HOLD
		if now - lastInboundNote >= INBOUND_COOL then
			lastInboundNote = now
			pcall(send_notification, "Missile inbound")
		end
	end
end

local function buildFrame(now: number): ()
	local cam = Camera
	if not cam then
		Front = EMPTY
		TargetCount = 0
		hideAllRings()
		return
	end
	local camPos: vector = cam.Position
	local camLook: vector = cam.LookVector

	local maxStud: number = Config.MaxDist * STUD_PER_M
	local maxSq: number = maxStud * maxStud
	local modStud: number = Config.ModMaxDist * STUD_PER_M
	local modSq: number = modStud * modStud
	local modsOn: boolean = (Config.ModOutline or Config.ModFilled)
		and (Config.ModEngine or Config.ModAmmo or Config.ModBarrel or Config.ModTrack)
	local heliOn: boolean = Config.Heli
	local occOnly: boolean = Config.OccupiedOnly
	local teamChk: boolean = Config.TeamCheck
	local showBox: boolean = Config.Box
	local showName: boolean = Config.Names
	local showClass: boolean = Config.Class
	local showDist: boolean = Config.Distance
	local showReload: boolean = Config.ReloadStatus
	local aimOn: boolean = Config.AimedAt
	local wantOcc: boolean = showName or occOnly or aimOn

	writeBuf.n = 0
	local count: number = 0
	local modCount: number = 0
	local rings: number = 0
	local bannerOn: boolean = false

	if Config.TeamCount and TeamText ~= "" then
		pushText(math.floor(vpW * 0.5), 8, Col.Name, TeamText, 18)
	end

	-- Missile ESP can run with Tank ESP off, so the vehicle list is simply empty then.
	local list: { Entry } = if Config.Enabled then Active else NO_ACTIVE

	for _, e in list do
		if count >= MAX_TARGETS then
			break
		end
		local isHeli = e.kind == "Heli"
		if (isHeli and not heliOn) or (teamChk and e.ally == true) then
			continue
		end
		local anchor = e.anchor
		if not alive(anchor) then
			continue
		end

		local cf = anchor.CFrame
		local pos: vector = cf.Position
		local rel: vector = pos - camPos
		local d2: number = vector.dot(rel, rel)
		-- Squared-distance culling, sqrt only for survivors. A tank behind the camera is not drawn but is still checked for Aimed At.
		local front: boolean = vector.dot(rel, camLook) > 0
		if d2 > maxSq or (not front and not aimOn) then
			continue
		end

		-- Occupied is read only for vehicles in range, at most once per OCC_RATE.
		if wantOcc and now - e.occT >= OCC_RATE then
			e.occT = now
			local occ = readAttr(e.inst, "Occupied")
			e.occupied = occ == true or occ == "true"
		end
		if occOnly and not e.occupied then
			continue
		end

		local aimedAtMe: boolean = false
		if aimOn and not isHeli and e.occupied and e.muz and alive(e.muz) then
			aimedAtMe = aimedAtCam(e, pos, camPos)
			if aimedAtMe then
				bannerOn = true
			end
		end
		if not front then
			continue
		end

		count += 1
		local distM: number = math.floor(math.sqrt(d2) * STUDS_TO_M)
		if distM ~= e.distM then
			e.distM = distM
			e.distText = distM .. "m"
		end
		local nameCol: Color3 = if e.occupied then Col.Occupied else Col.Name

		if isHeli then
			local sp, on = cam:WorldToScreenPoint(pos)
			if on and sp then
				local x = math.floor(sp.x + 0.5)
				local y = math.floor(sp.y + 0.5)
				if x >= 0 and x <= vpW and y >= 0 and y <= vpH then
					if showBox then
						rings += 1
						local ring = getRing(HeliPool, rings)
						ring.Position = Vector2.new(x, y)
						ring.Radius = HELI_R
						ring.Color = Col.Box
						ring.Visible = true
					end
					local yy = y - HELI_R - 4 - FONT
					if showDist then
						pushText(x, yy, Col.Dist, e.distText)
						yy -= STEP
					end
					if showName then
						pushText(x, yy, nameCol, e.name)
					end
				end
			end
			continue
		end

		-- Reload state is throttled and uses the fast reader only, no slow fallback.
		if showReload and e.gun and now - e.rlT >= RELOAD_RATE then
			e.rlT = now
			local lv = e.loaded
			if not alive(e.gun) or not alive(lv) then
				e.rl = 0
			else
				local rl = fastAttr(e.gun, "reloading")
				if rl == true or (type(rl) == "string" and rl ~= "" and string.lower(rl) ~= "false") then
					e.rl = 2
				else
					local shell = lv.Value
					if type(shell) == "string" and shell ~= "" and shell ~= "Unloaded" then
						e.rl = 1
						if shell ~= e.rlShell then
							e.rlShell = shell
							e.rlLabel = "READY " .. roundType(shell)
						end
					else
						e.rl = 3
					end
				end
			end
		end

		local size = convexHull(projectCorners(cam, pos, cf.RightVector, cf.UpVector, cf.LookVector, e.hx, e.hy, e.hz))
		if size >= 3 then
			local minX: number = math.huge
			local maxX: number = -math.huge
			local minY: number = math.huge
			for i = 1, size do
				local px = hullX[i]
				local py = hullY[i]
				if px < minX then
					minX = px
				end
				if px > maxX then
					maxX = px
				end
				if py < minY then
					minY = py
				end
			end
			if showBox then
				pushHull(size, Col.Box, BOX_THICK)
			end
			local cx = math.floor((minX + maxX) * 0.5)
			local yy = math.floor(minY) - 4 - FONT
			if showDist then
				pushText(cx, yy, Col.Dist, e.distText)
				yy -= STEP
			end
			if showName then
				pushText(cx, yy, nameCol, e.name)
				yy -= STEP
			end
			local cls = e.class
			if showClass and cls then
				pushText(cx, yy, Col.Class, cls)
				yy -= STEP
			end
			if showReload and e.gun and e.rl > 0 then
				local rtxt = if e.rl == 1 and e.rlLabel ~= "" then e.rlLabel else RELOAD_TEXT[e.rl]
				pushText(cx, yy, RELOAD_COL[e.rl], rtxt)
				yy -= STEP
			end
			if aimedAtMe then
				pushText(cx, yy, Col.Threat, "AIMED AT YOU")
			end
		end

		if modsOn and d2 <= modSq then
			if Config.ModAmmo then
				refreshAmmo(e, now)
			end
			for _, pl in polysByKind do
				table.clear(pl)
			end
			for _, m in e.mods do
				if modCount >= MAX_MODULES then
					break
				end
				local k = m.kind
				if Config[MOD_ON[k]] and (k ~= "ammo" or m.live) and alive(m.part) then
					local mcf = m.part.CFrame
					local poly = projectPolygon(
						cam, mcf.Position, mcf.RightVector, mcf.UpVector, mcf.LookVector, m.hx, m.hy, m.hz
					)
					if poly then
						modCount += 1
						local pl = polysByKind[k]
						pl[#pl + 1] = poly
					end
				end
			end
			for _, k in MOD_KINDS do
				pushModules(polysByKind[k], Config[MOD_COL[k]])
			end
		end
	end

	finishRings(HeliPool, rings)

	local mslN: number = 0
	if Config.Missile then
		if now - lastMslT >= MSL_RATE then
			lastMslT = now
			scanMissiles(now, camPos)
		end
		for _, t in MslTargets do
			if mslN >= MSL_POOL then
				break
			end
			local anchor = t.anchor
			if not alive(anchor) then
				continue
			end
			local pos: vector = anchor.CFrame.Position
			local sp, on = cam:WorldToScreenPoint(pos)
			if on and sp then
				local x = math.floor(sp.x + 0.5)
				local y = math.floor(sp.y + 0.5)
				local rel: vector = pos - camPos
				local distM: number = math.floor(math.sqrt(vector.dot(rel, rel)) * STUDS_TO_M)
				if distM > MSL_MAX_M then
					continue
				end
				if distM ~= t.distM then
					t.distM = distM
					t.text = (if t.incoming then "INCOMING " else "") .. t.label .. "  " .. distM .. "m"
				end
				local col: Color3 = if t.incoming then Col.Threat else t.col
				mslN += 1
				local ring = getRing(MslPool, mslN)
				ring.Position = Vector2.new(x, y)
				ring.Radius = if t.incoming then 9 else 6
				ring.Color = col
				ring.Visible = true
				pushText(x, y - 18, col, t.text)
			end
		end
		if now < InboundUntil then
			pushText(math.floor(vpW * 0.5), math.floor(vpH * 0.12), Col.Threat, "!! MISSILE INBOUND !!", 22)
		end
	elseif #MslTargets > 0 then
		MslTargets = {}
		table.clear(MslPrev)
	end
	finishRings(MslPool, mslN)

	if bannerOn then
		pushText(math.floor(vpW * 0.5), math.floor(vpH * 0.07), Col.Threat, "!! AIMED AT YOU !!", 22)
	end

	TargetCount = count
	Front = writeBuf
	writeBuf = if writeBuf == bufA then bufB else bufA
end

local function cycleColor(key: string): ()
	local idx = (ColorIdx[key] or 0) % #PALETTE + 1
	ColorIdx[key] = idx
	Config[key] = PALETTE[idx]
end

local function drawBuffer(buf: Buffer): ()
	local items = buf.items
	for i = 1, buf.n do
		local p = items[i]
		local k = p.k
		if k == K_POLY then
			DrawingImmediate.Polyline(p.pts, p.col, 1, p.thick)
		elseif k == K_TRI then
			DrawingImmediate.FilledTriangle(p.pts[1], p.pts[2], p.pts[3], p.col, MOD_FILL_A)
		elseif k == K_TEXT then
			DrawingImmediate.OutlinedText(p.pts[1], p.thick, p.col, 1, p.text, true)
		end
	end
end

