local HEADER_H: number = 38
local MAIN_ROW_H: number = 28
local PART_ROW_H: number = 24
local PART_GAP: number = 1
local SLIDER_ROW_H: number = 56
local MENU_GAP: number = 10
local T2W: number = 230
local PANEL2_H: number = HEADER_H + 1 + #MISC_ROWS * MAIN_ROW_H + 10
local PANEL_H: number = HEADER_H + 1 + MAIN_ROW_H * #MAIN_ROWS + 3 + SLIDER_ROW_H + 9
	+ 30 + #MOD_ROWS * (PART_ROW_H + PART_GAP) + 3 + SLIDER_ROW_H + 6 + 32

local function cycleColor(key: string): ()
	local idx = (ColorIdx[key] or 0) % #PALETTE + 1
	ColorIdx[key] = idx
	Config[key] = PALETTE[idx]
end

-- Keys arrive as virtual-key numbers or names depending on the game, accept both.
local function processKeys(): ()
	local keyDown: boolean = false
	if isrbxactive() then
		local keys: any = getpressedkeys()
		keyDown = table.find(keys, MENU_KEY) ~= nil or table.find(keys, "RightShift") ~= nil
	end
	if keyDown and not prevMenuKey then
		UIState.Visible = not UIState.Visible
	end
	prevMenuKey = keyDown
end

local function drawBuffer(buf: Buffer): ()
	local items = buf.items
	for i = 1, buf.n do
		local p = items[i]
		local k = p.k
		if k == K_POLY then
			DrawingImmediate.Polyline(p.pts, p.col, 1, p.thick)
		elseif k == K_TRI then
			DrawingImmediate.FilledTriangle(p.pts[1], p.pts[2], p.pts[3], p.col, MOD_FILL_A)
		elseif k == K_TEXT then
			DrawingImmediate.OutlinedText(p.pts[1], p.thick, p.col, 1, p.text, true)
		end
	end
end

-- Immediate mode has no rounding, so corners are built from rectangles and circles.
local function RoundRect(x: number, y: number, w: number, h: number, r: number, color: Color3): ()
	if r <= 3 then
		DrawingImmediate.FilledRectangle(v2(x + 1, y), v2(w - 2, h), color, 1)
		DrawingImmediate.FilledRectangle(v2(x, y + 1), v2(w, h - 2), color, 1)
		return
	end
	DrawingImmediate.FilledRectangle(v2(x + r, y), v2(w - 2 * r, h), color, 1)
	DrawingImmediate.FilledRectangle(v2(x, y + r), v2(r, h - 2 * r), color, 1)
	DrawingImmediate.FilledRectangle(v2(x + w - r, y + r), v2(r, h - 2 * r), color, 1)
	DrawingImmediate.FilledCircle(v2(x + r, y + r), r, color, 1)
	DrawingImmediate.FilledCircle(v2(x + w - r, y + r), r, color, 1)
	DrawingImmediate.FilledCircle(v2(x + r, y + h - r), r, color, 1)
	DrawingImmediate.FilledCircle(v2(x + w - r, y + h - r), r, color, 1)
end

local function DrawPill(x: number, y: number, w: number, h: number, on: boolean): ()
	RoundRect(x, y, w, h, 5, if on then T.PillLine else T.PillLineOff)
	RoundRect(x + 1, y + 1, w - 2, h - 2, 4, if on then T.PillBg else T.PillBgOff)
	local knob: number = 10
	local kx: number = if on then (x + w - knob - 4) else (x + 4)
	RoundRect(kx, y + (h - knob) / 2, knob, knob, 3, if on then T.Knob else T.KnobOff)
end

local function DrawToggleRow(
	x: number, y: number, w: number, h: number,
	label: string, enabled: boolean,
	clicked: boolean, mp: vector, swatch: Color3?
): (boolean, boolean)
	local labelX: number = x + 10
	if swatch then
		DrawingImmediate.FilledRectangle(v2(x + 10, y + h / 2 - 3), v2(6, 6), swatch, 1)
		labelX = x + 22
	end
	DrawingImmediate.Text(v2(labelX, y + h / 2 - 6), 13, if enabled then T.TextRow else T.TextOff, 1, label, false)

	local pillW: number = 32
	local pillH: number = 18
	DrawPill(x + w - pillW - 10, y + (h - pillH) / 2, pillW, pillH, enabled)

	local inRow: boolean = clicked and mp.x >= x and mp.x <= x + w and mp.y >= y and mp.y <= y + h
	local onSwatch: boolean = swatch ~= nil and inRow and mp.x <= x + 22
	return inRow and not onSwatch, onSwatch
end

local function DrawSliderRow(
	x: number, y: number, w: number, id: string,
	label: string, value: number, minV: number, maxV: number, suffix: string,
	clicked: boolean, ldown: boolean, mp: vector
): number
	DrawingImmediate.Text(v2(x + 10, y + 9), 11, T.TextDim, 1, label, false)

	local valStr = tostring(math.floor(value)) .. suffix
	RoundRect(x + w - 55, y + 9, 45, 14, 4, T.Chip)
	DrawingImmediate.Text(v2(x + w - 32.5, y + 10), 11, T.TextMain, 1, valStr, true)

	local tX: number = x + 10
	local tW: number = w - 20
	local tC: number = y + 43

	if clicked and mp.x >= tX - 6 and mp.x <= tX + tW + 6 and mp.y >= tC - 10 and mp.y <= tC + 10 then
		ActiveSlider = id
	end
	if not ldown then
		ActiveSlider = nil
	end

	if ActiveSlider == id then
		local rel = math.clamp((mp.x - tX) / tW, 0, 1)
		value = math.floor((minV + rel * (maxV - minV)) / 10 + 0.5) * 10
		value = math.clamp(value, minV, maxV)
	end

	RoundRect(tX, tC - 2, tW, 4, 2, T.Track)

	local frac: number = math.clamp((value - minV) / (maxV - minV), 0, 1)
	local thumbX: number = tX + math.floor(tW * frac) - 5
	RoundRect(thumbX, tC - 5, 10, 10, 3, T.Knob)

	return value
end

local function drawUI(): ()
	local active: boolean = isrbxactive()
	local ldown: boolean = active and isleftpressed()
	local clicked: boolean = ldown and not MouseWasPressed
	MouseWasPressed = ldown
	local mp: vector = getmouseposition()

	if ldown then
		if not UIState.Dragging then
			if clicked and UIState.Visible and ActiveSlider == nil
			and mp.x >= UIState.X and mp.x <= UIState.X + T.W + MENU_GAP + T2W
			and mp.y >= UIState.Y and mp.y <= UIState.Y + HEADER_H then
				UIState.Dragging = true
				UIState.DragOffset.x = mp.x - UIState.X
				UIState.DragOffset.y = mp.y - UIState.Y
			end
		else
			UIState.X = mp.x - UIState.DragOffset.x
			UIState.Y = mp.y - UIState.DragOffset.y
		end
	else
		UIState.Dragging = false
	end
	-- The menu cannot leave the screen.
	UIState.X = math.clamp(UIState.X, 0, math.max(0, vpW - (T.W + MENU_GAP + T2W)))
	UIState.Y = math.clamp(UIState.Y, 0, math.max(0, vpH - PANEL_H))

	if not UIState.Visible then
		return
	end

	local ux: number = UIState.X
	local uy: number = UIState.Y
	local uw: number = T.W

	RoundRect(ux, uy, uw, PANEL_H, 10, T.Bg)

	DrawingImmediate.FilledRectangle(v2(ux + 18, uy + 18), v2(6, 6), T.White, 1)
	DrawingImmediate.Text(v2(ux + 30, uy + 14), 13, T.TextMain, 1, "SEVERE | MTC", false)
	DrawingImmediate.Text(v2(ux + 31, uy + 14), 13, T.TextMain, 1, "SEVERE | MTC", false)
	DrawingImmediate.Text(v2(ux + uw - 26, uy + 13), 14, T.TextDim, 1, "x", false)
	if clicked and mp.x >= ux + uw - 28 and mp.x <= ux + uw and mp.y >= uy and mp.y <= uy + HEADER_H then
		UIState.Visible = false
		return
	end

	local x2: number = ux + uw + MENU_GAP
	RoundRect(x2, uy, T2W, PANEL2_H, 10, T.Bg)
	DrawingImmediate.Text(v2(x2 + 18, uy + 14), 11, T.TextDim, 1, "MISC", false)
	local yo2: number = uy + HEADER_H + 1
	for _, row in MISC_ROWS do
		local hit = DrawToggleRow(x2 + 8, yo2, T2W - 16, MAIN_ROW_H, row.label, Config[row.key] == true, clicked, mp, nil)
		if hit then
			Config[row.key] = not Config[row.key]
		end
		yo2 += MAIN_ROW_H
	end

	local yo: number = uy + HEADER_H + 1

	for _, row in MAIN_ROWS do
		local hit = DrawToggleRow(ux + 8, yo, uw - 16, MAIN_ROW_H, row.label, Config[row.key] == true, clicked, mp, nil)
		if hit then
			Config[row.key] = not Config[row.key]
		end
		yo += MAIN_ROW_H
	end
	yo += 3

	Config.MaxDist = DrawSliderRow(
		ux + 8, yo, uw - 16, "maxdist", "MAX DISTANCE", Config.MaxDist, 0, 4000, " m", clicked, ldown, mp
	)
	yo += SLIDER_ROW_H + 9

	DrawingImmediate.FilledRectangle(v2(ux + 12, yo), v2(uw - 24, 1), T.Divider, 1)
	DrawingImmediate.Text(v2(ux + 18, yo + 12), 11, T.TextDim, 1, "MODULES", false)
	yo += 30

	for _, row in MOD_ROWS do
		local colorKey = row.color
		local swatch: Color3? = if colorKey then Config[colorKey] else nil
		local hit, swatchHit = DrawToggleRow(
			ux + 8, yo, uw - 16, PART_ROW_H, row.label, Config[row.key] == true, clicked, mp, swatch
		)
		if swatchHit and colorKey then
			cycleColor(colorKey)
		elseif hit then
			Config[row.key] = not Config[row.key]
		end
		yo += PART_ROW_H + PART_GAP
	end
	yo += 3

	Config.ModMaxDist = DrawSliderRow(
		ux + 8, yo, uw - 16, "moddist", "MODULE DISTANCE", Config.ModMaxDist, 0, 4000, " m", clicked, ldown, mp
	)
	yo += SLIDER_ROW_H + 6

	DrawingImmediate.FilledRectangle(v2(ux + 12, yo), v2(uw - 24, 1), T.Divider, 1)
	DrawingImmediate.Text(v2(ux + 18, yo + 11), 11, T.TextDim, 1, "Targets:", false)
	DrawingImmediate.Text(v2(ux + 74, yo + 11), 11, T.TextRow, 1, tostring(TargetCount), false)
	DrawingImmediate.Text(v2(ux + 114, yo + 11), 11, T.TextDim, 1, "Team check:", false)
	DrawingImmediate.Text(v2(ux + 194, yo + 11), 11, T.TextMain, 1, if Config.TeamCheck then "ON" else "OFF", false)
end

-- No Armor (PostModel, driven by the vehicle cache)

-- Zeroes every found ArmourValue that is not zero yet
local function zeroArmorList(list: { any }): ()
	for _, v in list do
		if v.Value ~= 0 then
			v.Value = 0
		end
	end
end

-- Searches one vehicle for ArmourValue objects (a single GetDescendants call) and remembers them
local function scanArmor(e: Entry): ()
	local found: { any } = {}
	for _, d in e.inst:GetDescendants() do
		if d.Name == ARMOR_NAME and ARMOR_CLASSES[d.ClassName] then
			found[#found + 1] = d
		end
	end
	e.armor = found
end

-- Zeroes the vehicle's found values, a failed read means a stale object so the list is dropped
local function zeroEntry(e: Entry, now: number): ()
	e.armorChkT = now
	if not pcall(zeroArmorList, e.armor) then
		e.armor = {}
	end
end

local lastArmorT: number = 0

local function onPostModel(): ()
	if not running or not Config.NoArmor then
		return
	end
	local now = os.clock()
	if now - lastArmorT < ARMOR_TICK then
		return
	end
	lastArmorT = now

	local list = Active -- snapshot, rebuildCache swaps the table instead of editing it
	local teamChk: boolean = Config.TeamCheck
	local scansLeft: number = ARMOR_SCANS_PER_TICK
	for _, e in list do
		if teamChk and e.ally == true then
			continue
		end

		-- Search again while nothing was found yet (parts can load after the hull), and once more after the first hit
		local wantScan = e.armorScans < ARMOR_SCAN_TRIES and (#e.armor == 0 or e.armorScans < 2)
		local scanned = false
		if wantScan and scansLeft > 0 and now - e.armorScanT >= ARMOR_SCAN_GAP then
			scansLeft -= 1
			e.armorScanT = now
			e.armorScans += 1
			if pcall(scanArmor, e) then
				zeroEntry(e, now)
			end
			scanned = true
		end

		if not scanned and #e.armor > 0 and now - e.armorChkT >= ARMOR_CHECK_RATE then
			zeroEntry(e, now)
		end
	end
end

local lastCamT: number = 0
local lastScreenT: number = 0
local lastCacheT: number = 0

local function onPostLocal(): ()
	if not running then
		return
	end
	local now = os.clock()

	if now - lastCamT >= CAM_RATE then
		lastCamT = now
		Camera = Workspace.CurrentCamera
	end
	if now - lastScreenT >= SCREEN_RATE then
		lastScreenT = now
		updateScreenSize()
	end
	processKeys()

	local espOn: boolean = Config.Enabled
	if not espOn and not Config.NoArmor then
		Front = EMPTY
		TargetCount = 0
		hideAllRings()
		return
	end
	-- The cache also feeds No Armor, so it keeps rebuilding while either feature is on.
	if now - lastCacheT >= CACHE_RATE then
		lastCacheT = now
		rebuildCache()
	end
	if espOn then
		buildFrame(now)
	else
		Front = EMPTY
		TargetCount = 0
		hideAllRings()
	end
end

local function onRender(): ()
	if not running then
		return
	end
	drawBuffer(Front)
	drawUI()
end

local connRender: any = RunService.Render:Connect(onRender)
local connLogic: any = RunService.PostLocal:Connect(onPostLocal)
local connModel: any = RunService.PostModel:Connect(onPostModel)

local function disconnect(conn: any): ()
	local ok = pcall(function()
		conn:Disconnect()
	end)
	if not ok then
		pcall(function()
			conn:disconnect()
		end)
	end
end

local function stop(): ()
	running = false
	disconnect(connRender)
	disconnect(connLogic)
	disconnect(connModel)
	for _, pool in { HeliPool, MslPool } do
		for _, ring in pool.list do
			ring:Remove()
		end
		table.clear(pool.list)
		pool.used = 0
	end
end

_G.TankESP = { stop = stop }

