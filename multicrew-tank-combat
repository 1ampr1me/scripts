				end
			end
		end
	end
	TeamText = "ALLY " .. a .. " | ENEMY " .. en
end

-- Gun axis (muzzle look, sign fixed relative to hull) passes within AIM_R of the camera.
local function aimedAtCam(e: Entry, massPos: vector, camPos: vector): boolean
	local ok, mcf = pcall(getCF, e.muz)
	if not ok or not mcf then
		return false
	end
	local mp: vector = mcf.Position
	local lk: vector = mcf.LookVector
	local dir: vector = lk * (if vector.dot(lk, mp - massPos) < 0 then -1 else 1)
	local toCam: vector = camPos - mp
	local along = vector.dot(toCam, dir)
	if along <= 0 then
		return false
	end
	local perp: vector = toCam - dir * along
	return vector.dot(perp, perp) <= AIM_R2
end

