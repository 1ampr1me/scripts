-- Muzzle may be a part, or an ObjectValue chain (up to 4 links).
local function linkPart(o: any): any
	for _ = 1, 4 do
		if not o then
			return nil
		end
		local okc, cf = pcall(getCF, o)
		if okc and cf then
			return o
		end
		local okv, v = pcall(getValue, o)
		if okv and v then
			o = v
		else
			o = o:FindFirstChild("Muzzle")
		end
	end
	return nil
end

-- Round type: external table roundtypes.lua (optional), then prefix match, then name heuristic.
local RT: { [string]: string } = {}
do
	local ok, src = pcall(readfile, "roundtypes.lua")
	if ok and type(src) == "string" then
		local f = loadstring(src)
		if f then
			pcall(f)
		end
		local g: any = _G
		if type(g.SahurRoundTypes) == "table" then
			RT = g.SahurRoundTypes
		end
	end
end
local rtCache: { [string]: string } = {}
local function roundType(nm: string): string
	local c = rtCache[nm]
	if c then
		return c
	end
	local s: string? = RT[nm]
	if not s then
		for k, v in RT do
			if #k >= 4 and string.sub(nm, 1, #k) == k then
				s = v
				break
			end
		end
	end
	if not s then
		local u = string.upper(nm)
		if string.find(u, "APFSDS") or string.find(u, "^3BM") or string.find(u, "^M8[23]%d") then
			s = "APFSDS"
		elseif string.find(u, "HEAT") or string.find(u, "^3BK") then
			s = "HEAT"
		elseif string.find(u, "APDS") then
			s = "APDS"
		elseif string.find(u, "HESH") then
			s = "HESH"
		elseif string.find(u, "^3OF") or string.find(u, "HE") then
			s = "HE"
		elseif string.find(u, "SMOKE") then
			s = "SMOKE"
		else
			s = string.sub(u, 1, 8)
		end
	end
	local r: string = s :: string
	rtCache[nm] = r
	return r
end

local function collectModules(veh: any): { ModuleDef }
	local out: { ModuleDef } = {}
	local dm = child(veh, "DamageModules")
	if not dm then
		return out
	end
	local hpFolder = child(child(veh, "Values"), "DamageModule")
	for _, mdl in dm:GetChildren() do
		local ammoObj = mdl:FindFirstChild("AmmoValue")
		local rack: Rack? = if ammoObj then { ammoObj = ammoObj } else nil
		for _, p in mdl:GetChildren() do
			local nm: string = p.Name
			local kind: string? = nil
			if nm == "Engine" then
				kind = "eng"
			elseif string.match(nm, "^AmmoModel%d+$") then
				kind = "ammo"
			elseif string.match(nm, "^Turret%d+Barrel$") then
				kind = "barrel"
			elseif nm == "LeftTrack" or nm == "RightTrack" then
				kind = "track"
			end
			if kind then
				local sz = p.Size
				local isAmmo = kind == "ammo"
				out[#out + 1] = {
					part = p, hx = sz.X * 0.5, hy = sz.Y * 0.5, hz = sz.Z * 0.5, kind = kind,
					rack = if isAmmo then rack else nil,
					hpObj = if isAmmo and hpFolder then hpFolder:FindFirstChild(nm) else nil,
					live = true,
				}
			end
		end
	end
	return out
end

-- Rack hidden when AmmoValue <= 0 or part HP <= 0; read at AMMO_RATE, not per frame.
local function refreshAmmo(e: Entry, now: number): ()
	if now - e.ammoT < AMMO_RATE then
		return
	end
	e.ammoT = now
	for _, m in e.mods do
		if m.kind == "ammo" then
			local live = true
			local r = m.rack
			if r then
				local a = readNum(r.ammoObj) or 0
				if a <= 0 then
					live = false
				end
			end
			if live and m.hpObj then
				local h = readNum(m.hpObj)
				if h and h <= 0 then
					live = false
				end
			end
			m.live = live
		end
	end
end

local function countTeams(): ()
