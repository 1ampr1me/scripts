-- Samples the mouse once per frame (a click stays flagged until Render consumes it).
local function sampleInput(): ()
	local mouse = getmouseposition()
	local down: boolean = isrbxactive() and isleftpressed()
	if down and not input.down then
		input.clicked = true
	end
	input.down = down
	input.mx = mouse.x
	input.my = mouse.y
end

-- Handles RightShift (menu) and Enter (collect money).
local function handleKeys(): ()
	-- No key reads while Roblox is not the active window (RightShift in another app must not toggle the menu)
	local keys: { any } = if isrbxactive() then getpressedkeys() else EMPTY_KEYS
	local rshift: boolean = table.find(keys, "RightShift") ~= nil or table.find(keys, 0xA1) ~= nil
	if rshift and not RShiftWasDown then
		UIState.Visible = not UIState.Visible
	end
	RShiftWasDown = rshift

	local enter: boolean = table.find(keys, "Return") ~= nil
		or table.find(keys, "Enter") ~= nil
		or table.find(keys, 0x0D) ~= nil
	if enter and not EnterWasDown then
		collectQueued = true
	end
	EnterWasDown = enter

	-- F1 toggles auto buy
	local f1: boolean = table.find(keys, "F1") ~= nil or table.find(keys, 0x70) ~= nil
	if f1 and not F1WasDown then
		toggles.autoBuy = not toggles.autoBuy
		if toggles.autoBuy then
			lastCollectAt = os.clock()
		end
	end
	F1WasDown = f1
end

-- Starts the next queued action when nothing else is running.
local function dispatchActions(now: number): ()
	-- Infinite ammo: applied when switched on, then refreshed for guns that loaded later
	if toggles.infAmmo and now - lastAmmoAt >= AMMO_EVERY then
		lastAmmoAt = now
		applyInfiniteAmmo()
	end

	-- Auto buy collects money on a fixed interval, then keeps buying
	if toggles.autoBuy and now - lastCollectAt >= COLLECT_EVERY then
		collectQueued = true
	end

	if actionBusy then
		return
	end
	if pendingTeleport ~= nil then
		local request = pendingTeleport
		pendingTeleport = nil
		startAction(function()
			runTeleport(request)
		end)
	elseif collectQueued then
		collectQueued = false
		startAction(collectMoney)
	elseif toggles.autoBuy and now - lastBuyPass >= BUY_RATE and isrbxactive() then
		lastBuyPass = now
		startAction(autoBuyPass)
	end
end

local lastRebuild = 0
local lastLogic = 0
local lastSlow = 0
local lastPlayers = 0

refreshSlow()
refreshPlayers()
rebuildTracked()
refreshPositions(os.clock())
calibrateProjection()

local postConn = RunService.PostLocal:Connect(function()
	if not alive then
		return
	end
	local now = os.clock()

	sampleInput()

	if now - lastSlow >= SLOW_RATE then
		lastSlow = now
		refreshSlow()
		calibrateProjection()
	end

	if now - lastPlayers >= PLAYERS_RATE then
		lastPlayers = now
		refreshPlayers()
	end

	if forceRebuild or now - lastRebuild >= REBUILD_RATE then
		forceRebuild = false
		lastRebuild = now
		rebuildTracked()
		refreshPositions(now)
	end

	if now - lastLogic >= LOGIC_RATE then
		lastLogic = now
		handleKeys()
		refreshPositions(now)
	end

	projectItems()
	dispatchActions(now)
end)

local renderConn = RunService.Render:Connect(function()
	if not alive then
		return
	end
	drawEsp()
	drawAdminWarning()
	drawMenu()
end)

G.WarTycoonCleanup = function()
	alive = false
	postConn:Disconnect()
	renderConn:Disconnect()
end

