-- Returns the owner name of a vehicle. Attribute reads are slow in Severe, so the result is cached
-- and unknown owners are only retried every OWNER_RETRY seconds.
local function getOwner(model: Inst, now: number): string
	local cached = ownerCache[model]
	if cached ~= nil then
		return cached
	end
	local retryAt = ownerMissAt[model]
	if retryAt ~= nil and now < retryAt then
		return "Unknown"
	end
	local owner = model:GetAttribute("Owner")
	if type(owner) == "string" then
		ownerCache[model] = owner
		return owner
	end
	if not ownerScanned[model] then
		if ownerScansLeft <= 0 then
			return "Unknown" -- searched on a later rebuild so a burst of new vehicles cannot freeze the game
		end
		ownerScansLeft -= 1
		ownerScanned[model] = true
		for _, child in model:GetChildren() do
			local o = child:GetAttribute("Owner")
			if type(o) == "string" then
				ownerCache[model] = o
				return o
			end
		end
	end
	ownerMissAt[model] = now + OWNER_RETRY
	return "Unknown"
end

-- Picks the ESP anchor part: BoatPivot, then PrimaryPart, then the first part child.
local function getAnchor(model: Inst): Inst
	local pivot = model:FindFirstChild("BoatPivot")
	if pivot ~= nil then
		return pivot
	end
	local primary = model.PrimaryPart
	if primary ~= nil then
		return primary
	end
	for _, child in model:GetChildren() do
		if PART_CLASSES[child.ClassName] then
			return child
		end
	end
	return nil
end

-- Creates a tracked ESP entry.
-- Middle ESP line: the owner's nickname, followed by his team when known.
local function ownerText(owner: string): string
	local team = teamOf[owner]
	if toggles.showTeam and team ~= nil then
		return `{owner} [{team}]`
	end
	return owner
end

-- Color of the owner's team (white while the team is unknown)
local function teamColor(owner: string): Color3
	return TEAM_COLORS[teamOf[owner] or ""] or T.White
end

local function newTracked(anchor: Inst, title: string, color: Color3): Tracked
	return {
		anchor = anchor,
		top = title,
		owner = "",
		team = "",
		teamShown = true,
		mid = "",
		midColor = T.White,
		bot = "",
		color = color,
		isOwn = false,
		pos = vec(0, 0, 0),
		px = 0,
		py = 0,
		pz = 0,
		lastDist = -2,
		inRange = false,
		valid = true,
		nextAt = 0,
		aliveAt = 0,
		labelAt = 0,
	}
end

-- Rebuilds the owner dependent fields of an entry (nickname, team text and color, own flag).
local function applyOwner(item: Tracked, owner: string): ()
	item.owner = owner
	item.team = teamOf[owner] or ""
	item.teamShown = toggles.showTeam
	item.mid = if owner == "" then "" else ownerText(owner)
	item.midColor = teamColor(owner)
	item.isOwn = owner == localName
end

