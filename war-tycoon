-- Rescans the enabled vehicle folders and swaps the list in one step. Entries are reused between rebuilds.
local function rebuildTracked(): ()
	local now = os.clock()
	ownerScansLeft = OWNER_SCANS_PER_REBUILD
	local nextList: { Tracked } = {}
	local seen: { [Inst]: boolean } = {}
	local gameSystems = if toggles.enabled then workspace:FindFirstChild("Game Systems") else nil

	if gameSystems ~= nil then
		for _, cat in CATEGORIES do
			if not toggles[cat.key] then
				continue
			end
			local folder = gameSystems:FindFirstChild(cat.folder)
			if folder == nil then
				continue
			end
			for _, model in folder:GetChildren() do
				local existing = byModel[model]
				if existing ~= nil and not existing.valid then
					byModel[model] = nil -- its anchor part died: build the entry again
					existing = nil
				end
				local item: Tracked
				if existing ~= nil then
					item = existing
				else
					local anchor = getAnchor(model)
					if anchor == nil then
						continue
					end
					item = newTracked(anchor, model.Name, cat.color)
					byModel[model] = item
				end
				seen[model] = true
				local owner = getOwner(model, now)
				if owner ~= item.owner or (teamOf[owner] or "") ~= item.team or toggles.showTeam ~= item.teamShown then
					applyOwner(item, owner)
				end
				table.insert(nextList, item)
			end
		end
	end

	-- Drop cache entries of models that no longer exist
	for model in byModel do
		if not seen[model] then
			byModel[model] = nil
		end
	end
	for model in ownerCache do
		if not seen[model] then
			ownerCache[model] = nil
		end
	end
	for model in ownerScanned do
		if not seen[model] then
			ownerScanned[model] = nil
			ownerMissAt[model] = nil
		end
	end

	tracked = nextList
end

-- Reads one entry's position and distance. Far or hidden entries are read less often.
local function readItem(item: Tracked, now: number): ()
	local anchor = item.anchor
	if now >= item.aliveAt then
		item.aliveAt = now + ALIVE_CHECK
		if anchor.Parent == nil then
			item.valid = false
			return
		end
	end
	if item.isOwn and not showOwn then
		item.inRange = false
		item.nextAt = now + FAR_RATE
		return
	end
	local pos: vector = anchor.Position
	local x, y, z = pos.x, pos.y, pos.z
	item.pos = pos
	item.px = x
	item.py = y
	item.pz = z
	local dx = x - originX
	local dy = y - originY
	local dz = z - originZ
	local sq = dx * dx + dy * dy + dz * dz
	local inRange = sq <= maxSq
	item.inRange = inRange
	if not inRange then
		item.nextAt = now + FAR_RATE
		return
	end
	item.nextAt = if sq > NEAR_SQ then now + MID_RATE else now
	if showDist then
		if now >= item.labelAt then
			item.labelAt = now + LABEL_RATE
			local d = floor(sqrt(sq))
			if d ~= item.lastDist then
				item.lastDist = d
				item.bot = `{d} st`
			end
		end
	else
		item.bot = ""
		item.lastDist = -2 -- so the text comes back when the option is switched on again
	end
end

-- Refreshes positions and distances of the entries that are due (logic tick).
local function refreshPositions(now: number): ()
	local root = localRoot
	if root == nil or root.Parent == nil then
		for _, item in tracked do
			item.inRange = false
		end
		return
	end
	local origin: vector = root.Position
	originX, originY, originZ = origin.x, origin.y, origin.z
	maxSq = state.maxDistance * state.maxDistance
	showDist = toggles.showDistance
	showOwn = toggles.showOwn

	for _, item in tracked do
		if item.valid and now >= item.nextAt then
			readItem(item, now)
		end
	end
end

-- One pass over the players (slow poll): every player's team name and the admin warning text
-- (another player with a non-zero AdminRank value).
