-- Lowercases a button name and removes a "[N Rebirth(s)]" tag so names from different places match.
local function matchKey(name: string): string
	local stripped = (string.gsub(name, "%s*%[%d+%s*[Rr]ebirths?%]", ""))
	return string.lower(stripped)
end

-- Restriction groups (buttons the auto buy can skip); ON = skip
type RestrictGroup = { read title: string, read names: { string }, read keys: { string } }

local function makeGroup(title: string, names: { string }): RestrictGroup
	local keys: { string } = {}
	for _, name in names do
		table.insert(keys, matchKey(name))
	end
	return table.freeze({ title = title, names = table.freeze(names), keys = table.freeze(keys) })
end

