-- Restrict tab: ON = auto buy skips that button.
local function drawRestrictTab(ux: number, yo: number, uw: number, clicked: boolean, mp: vector): number
	DrawLabel(ux, yo + 2, "ON = auto buy skips this button")
	yo += 20

	local total = 0
	local skipped = 0
	for _, group in RESTRICT_GROUPS do
		for _, key in group.keys do
			total += 1
			if restricted[key] then
				skipped += 1
			end
		end
	end
	local allOn = skipped == total
	if DrawToggleRow(ux + 8, yo, uw - 16, MAIN_ROW_H, "Restrict all", allOn, clicked, mp, nil) then
		for _, group in RESTRICT_GROUPS do
			for _, key in group.keys do
				restricted[key] = not allOn
			end
		end
	end
	yo += MAIN_ROW_H + 2

	local cw: number = (uw - 32 - CHIP_GAP) / 2
	for _, group in RESTRICT_GROUPS do
		local open = UIState.OpenGroup == group.title
		local count = 0
		for _, key in group.keys do
			if restricted[key] then
				count += 1
			end
		end
		local size = #group.keys

		if DrawDropdownHeader(ux + 8, yo, uw - 16, MAIN_ROW_H, group.title, `{count}/{size}`, open, clicked, mp) then
			UIState.OpenGroup = if open then "" else group.title
		end
		yo += MAIN_ROW_H

		if open then
			yo += DROP_TOP_GAP
			local groupAll = count == size
			if DrawToggleRow(ux + 16, yo, uw - 32, DROP_ROW_H, `All {group.title}`, groupAll, clicked, mp, T.White) then
				for _, key in group.keys do
					restricted[key] = not groupAll
				end
			end
			yo += DROP_ROW_H + DROP_GAP + 2

			for i, key in group.keys do
				local col = (i - 1) % 2
				local row = floor((i - 1) / 2)
				local cx = ux + 16 + col * (cw + CHIP_GAP)
				local cy = yo + row * (CHIP_H + CHIP_GAP)
				if DrawChip(cx, cy, cw, CHIP_H, shortLabel(group.names[i], 19), restricted[key] == true, clicked, mp) then
					restricted[key] = not restricted[key]
				end
			end
			yo += floor((size + 1) / 2) * (CHIP_H + CHIP_GAP) + 4
		end
	end
	return yo
end

