	for _, player in Players:GetChildren() do
		if player.ClassName ~= "Player" then
			continue
		end
		local name: string = player.Name
		local team = player.Team
		if team ~= nil then
			teams[name] = team.Name
		end
		if name ~= localName then
			local rank = player:FindFirstChild("AdminRank")
			if rank ~= nil then
				local value = rank.Value
				if value ~= nil and value ~= 0 then
					names = if names == "" then name else `{names}, {name}`
				end
			end
		end
	end
	teamOf = teams
	adminText = if names == "" then "" else `ADMIN ON SERVER: {names}`
end

-- Reads the camera basis once (position, right, up, look, field of view) for the Lua projection.
-- Returns false when the camera does not provide it.
local function loadCameraBasis(cam: Inst): boolean
	local p: vector? = cam.Position
	local r: vector? = cam.RightVector
	local u: vector? = cam.UpVector
	local l: vector? = cam.LookVector
	if p == nil or r == nil or u == nil or l == nil then
		return false
	end
	camX, camY, camZ = p.x, p.y, p.z
	rgX, rgY, rgZ = r.x, r.y, r.z
	upX, upY, upZ = u.x, u.y, u.z
	lkX, lkY, lkZ = l.x, l.y, l.z
	local fov = cam.FieldOfView
	projTan = math.tan(math.rad(if fov ~= nil then fov else 70) * 0.5)
	projAspect = if viewH > 0 then viewW / viewH else 1
	return true
end

-- Projects a world point with the camera basis: screen x, y and whether the point is on screen.
local function projectOwn(x: number, y: number, z: number): (number, number, boolean)
	local dx = x - camX
	local dy = y - camY
	local dz = z - camZ
	local depth = dx * lkX + dy * lkY + dz * lkZ
	if depth <= 0.001 then
		return 0, 0, false
	end
	local sx = ((dx * rgX + dy * rgY + dz * rgZ) / (depth * projTan * projAspect) * 0.5 + 0.5) * viewW
	local sy = (0.5 - (dx * upX + dy * upY + dz * upZ) / (depth * projTan) * 0.5) * viewH
	return sx, sy, sx >= 0 and sx <= viewW and sy >= 0 and sy <= viewH
end

-- Compares the Lua projection with WorldToScreenPoint on a few entries (slow poll). The Lua projection is
-- used only while it matches, otherwise every entry goes through WorldToScreenPoint as before.
local function calibrateProjection(): ()
	local cam = camera
	if cam == nil or viewW <= 0 then
		useOwnProjection = false
		return
	end
	if not loadCameraBasis(cam) then
		useOwnProjection = false
		return
	end
	local checked = 0
	for _, item in tracked do
		if checked >= 4 then
			break
		end
		if item.valid and item.inRange then
			local screen, on = cam:WorldToScreenPoint(item.pos)
			if on then
				local sx, sy, ownOn = projectOwn(item.px, item.py, item.pz)
				if not ownOn or math.abs(sx - screen.x) > CALIB_PIXELS or math.abs(sy - screen.y) > CALIB_PIXELS then
					useOwnProjection = false
					return
				end
				checked += 1
			end
		end
	end
	if checked > 0 then
		useOwnProjection = true
	end
end

-- Projects entries to the screen into the marker pool (every frame, PostLocal).
local function projectItems(): ()
	markerCount = 0
	local cam = camera
	if cam == nil or not toggles.enabled then
		return
	end
	local own = useOwnProjection
	if own and not loadCameraBasis(cam) then
		own = false
		useOwnProjection = false
	end
	for _, item in tracked do
		if not item.valid or not item.inRange then
			continue
		end
		if markerCount >= MAX_MARKERS then
			break
		end
		local sx: number, sy: number, onScreen: boolean
		if own then
			sx, sy, onScreen = projectOwn(item.px, item.py, item.pz)
		else
			local screen, on = cam:WorldToScreenPoint(item.pos)
			sx, sy, onScreen = screen.x, screen.y, on
		end
		if onScreen then
			markerCount += 1
			local m = markers[markerCount]
			m.x = sx
			m.y = sy
			m.top = item.top
			m.mid = item.mid
			m.midColor = item.midColor
			m.bot = item.bot
			m.color = item.color
		end
	end
end

-- ───────────────────────── Tycoon actions ─────────────────────────

-- Returns the local HumanoidRootPart (fresh lookup, used by one-shot actions).
local function getRoot(): Inst
	local character = localPlayer.Character
	if character == nil then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

-- Reads a number from leaderstats (Cash / Rebirths), 0 if missing.
local function getStat(name: string): number
	local stats = localPlayer:FindFirstChild("leaderstats")
	if stats == nil then
		return 0
	end
	local value = stats:FindFirstChild(name)
	if value == nil then
		return 0
	end
	return tonumber(value.Value) or 0
end

local myTycoon: Inst = nil -- cached local tycoon
local tycoonRetryAt = 0

-- Returns the local tycoon. The team name is tried first (no attribute reads), the Owner attribute is the
-- fallback; the result is cached until the tycoon disappears.
local function getMyTycoon(): Inst
	if myTycoon ~= nil and myTycoon.Parent ~= nil then
		return myTycoon
	end
	myTycoon = nil
	local now = os.clock()
	if now < tycoonRetryAt then
		return nil
	end
	tycoonRetryAt = now + TYCOON_RETRY
	local root = workspace:FindFirstChild("Tycoon")
	local folder = if root ~= nil then root:FindFirstChild("Tycoons") else nil
	if folder == nil then
		return nil
	end
	local team = localPlayer.Team
	if team ~= nil then
		myTycoon = folder:FindFirstChild(team.Name)
	end
	if myTycoon == nil then
		for _, tycoon in folder:GetChildren() do
			if tycoon:GetAttribute("Owner") == localName then
				myTycoon = tycoon
				break
			end
		end
	end
	if myTycoon ~= nil then
		tycoonRetryAt = 0
	end
	return myTycoon
end

-- Returns a world position for a part, a model (PrimaryPart) or a folder (first part child).
local function getInstancePosition(inst: Inst): vector?
	if PART_CLASSES[inst.ClassName] then
		return inst.Position
	end
	if inst.ClassName == "Model" then
		local primary = inst.PrimaryPart
		if primary ~= nil then
			return primary.Position
		end
	end
	for _, child in inst:GetChildren() do
		if PART_CLASSES[child.ClassName] then
			return child.Position
		end
	end
	return nil
end

-- True for a SpawnLocation or anything named "...spawn...".
local function isSpawn(inst: Inst): boolean
	return inst.ClassName == "SpawnLocation" or string.find(string.lower(inst.Name), "spawn", 1, true) ~= nil
end

-- Looks for the tycoon spawn point in the tycoon and in its Essentials folder.
local function findSpawn(tycoon: Inst): Inst
	for _, child in tycoon:GetChildren() do
		if isSpawn(child) then
			return child
		end
	end
	local essentials = tycoon:FindFirstChild("Essentials")
	if essentials ~= nil then
		for _, child in essentials:GetChildren() do
			if isSpawn(child) then
				return child
			end
		end
	end
	return nil
end

-- Returns the cash collector position (Essentials/CollectorParts/Collector, its Bottom part first).
local function getCollectorPosition(tycoon: Inst): vector?
	local essentials = tycoon:FindFirstChild("Essentials")
	local parts = if essentials ~= nil then essentials:FindFirstChild("CollectorParts") else nil
	local collector = if parts ~= nil then parts:FindFirstChild("Collector") else nil
	if collector == nil then
		return nil
	end
	local bottom = collector:FindFirstChild("Bottom")
	return getInstancePosition(if bottom ~= nil then bottom else collector)
end

-- Teleports the local character to a position (3 studs above it).
local function teleportTo(pos: vector): ()
	local root = getRoot()
	if root ~= nil then
		root.Position = vec(pos.x, pos.y + 3, pos.z)
	end
end

-- Resolves and runs a teleport request: a vector, "base" or "deposit".
local function runTeleport(request: any): ()
	if type(request) ~= "string" then
		teleportTo(request :: vector)
		return
	end
	tycoonRetryAt = 0 -- a click always searches for the tycoon
	local tycoon = getMyTycoon()
	if tycoon == nil then
		return
	end

	if request == "deposit" then
		local pos = baseByName[tycoon.Name]
		if pos ~= nil then
			teleportTo(pos)
		end
		return
	end

	-- "base": the spawn point, else the cash collector
	local spawn = findSpawn(tycoon)
	local pos = if spawn ~= nil then getInstancePosition(spawn) else nil
	if pos == nil then
		pos = getCollectorPosition(tycoon)
	end
	if pos ~= nil then
		teleportTo(pos)
		return
	end

	-- Neither is loaded: go to the oil deposit, then to the spawn point half a second later
	local deposit = baseByName[tycoon.Name]
	if deposit == nil then
		return
	end
	teleportTo(deposit)
	task.wait(0.5)
	local late = findSpawn(tycoon)
	local latePos = if late ~= nil then getInstancePosition(late) else nil
	if latePos ~= nil then
		teleportTo(latePos)
	end
end

-- Teleports to the cash collector of the local tycoon and back.
local function collectMoney(): ()
	lastCollectAt = os.clock()
	local root = getRoot()
	local tycoon = getMyTycoon()
	if root == nil or tycoon == nil then
		return
	end
	local target = getCollectorPosition(tycoon)
	if target == nil then
		return
	end
	local saved: vector = root.Position
	root.Position = target
	task.wait(COLLECT_DWELL)
	root.Position = saved

	-- Money arrived: let every button be tried again right away
	for _, info in buttonInfo do
		info.retryAt = 0
	end
	medbayRetryAt = 0
end

-- Writes 999999999 into the Ammo value of every gun in ReplicatedStorage.Configurations.ACS_Guns.
local function applyInfiniteAmmo(): ()
	-- GetService can return nil for ReplicatedStorage in Severe, so a plain lookup is the fallback
	local storage = game:GetService("ReplicatedStorage")
	if storage == nil then
		storage = game:FindFirstChild("ReplicatedStorage")
	end
	local configs = if storage ~= nil then storage:FindFirstChild("Configurations") else nil
	local guns = if configs ~= nil then configs:FindFirstChild("ACS_Guns") else nil
	if guns == nil then
		return
	end
	for _, gun in guns:GetChildren() do
		local ammo = gun:FindFirstChild("Ammo")
		if ammo ~= nil and ammo.ClassName == "NumberValue" and ammo.Value ~= INFINITE_AMMO then
			ammo.Value = INFINITE_AMMO
		end
	end
end

-- ───────────────────────── Auto buy ─────────────────────────

-- Lowercases a button name and strips every [tag] so names from different places match.
local function normalizeName(name: string): string
	local stripped = (string.gsub(name, "%s*%b[]", ""))
	stripped = (string.gsub(stripped, "%s+", " "))
	stripped = (string.gsub(stripped, "^%s*(.-)%s*$", "%1"))
	return string.lower(stripped)
end

-- Converts "[$80,000]" parts (amount + optional K/M/B suffix) into a number.
local function parsePrice(amount: string, suffix: string): number?
	local value = tonumber((string.gsub(amount, ",", "")))
	if value == nil then
		return nil
	end
	return value * (PRICE_SUFFIX[string.lower(suffix)] or 1)
end

-- Reads a price written inside a button name, e.g. "Buy Third Floor - [$15,000]".
local function priceFromName(name: string): number?
	local amount, suffix = string.match(name, "%[%$([%d,%.]+)([KkMmBb]?)%]")
	if amount == nil then
		return nil
	end
	return parsePrice(amount, suffix or "")
end

-- Builds normalizedName -> price from the "Buy <name> - [$price]" attachments in
-- workspace.LocalPartStorage["Base Center Position"].
local function buildPriceIndex(): { [string]: number }
	local index: { [string]: number } = {}
	local storage = workspace:FindFirstChild("LocalPartStorage")
	local holder = if storage ~= nil then storage:FindFirstChild("Base Center Position") else nil
	if holder == nil then
		return index
	end
	for _, child in holder:GetChildren() do
		local base, amount, suffix = string.match(child.Name, "^Buy%s+(.-)%s*%-%s*%[%$([%d,%.]+)([KkMmBb]?)%]")
		if base ~= nil and amount ~= nil then
			local price = parsePrice(amount, suffix or "")
			if price ~= nil then
				index[normalizeName(base)] = price
			end
		end
	end
	return index
end

-- Returns the cached info of a button, creating it on first sight.
local function getInfo(button: Inst): ButtonInfo
	local info = buttonInfo[button]
	if info ~= nil then
		return info
	end
	local name: string = button.Name
	local named = priceFromName(name)
	local created: ButtonInfo = {
		skipType = SKIP_TYPES[button:GetAttribute("ButtonType")] == true
			or string.find(string.lower(name), "gamepass", 1, true) ~= nil,
		rebirth = tonumber(button:GetAttribute("RebirthRequirement"))
			or tonumber(string.match(name, "%[(%d+)%s*[Rr]ebirth"))
			or 0,
		restrictKey = matchKey(name),
		nameKey = normalizeName(name),
		price = named or 0,
		known = named ~= nil,
		retryAt = 0,
	}
	buttonInfo[button] = created
	return created
end

-- True while the buy pass must stop (cleanup, toggle off, other action waiting, game not focused).
local function buyAborted(): boolean
	return not alive or not toggles.autoBuy or collectQueued or pendingTeleport ~= nil or not isrbxactive()
end

-- Teleports onto a button, stays BUY_DWELL seconds (triggers the purchase), then goes back.
local function buyButton(button: Inst): boolean
	local part = button:FindFirstChild("Part")
	local root = getRoot()
	if part == nil or root == nil then
		return false
	end
	local saved: vector = root.Position
	local target: vector = part.Position
	root.Position = vec(target.x, target.y + 1, target.z)
	task.wait(BUY_DWELL)
	root.Position = saved
	return true
end

-- Tries to buy one button. Returns true if it left UnpurchasedButtons; otherwise sets a retry delay.
local function tryBuy(button: Inst, buttons: Inst, retryDelay: number): boolean
	local bought = false
	if buyButton(button) then
		task.wait(0.1)
		bought = button.Parent ~= buttons
	end
	if bought then
		buttonInfo[button] = nil
	else
		local info = buttonInfo[button]
		if info ~= nil then
			info.retryAt = os.clock() + retryDelay
		end
	end
	return bought
end

-- One pass over the unpurchased buttons: cheapest first, buttons with unreadable prices last.
local function autoBuyPass(): ()
	local tycoon = getMyTycoon()
	if tycoon == nil then
		return
	end
	local buttons = tycoon:FindFirstChild("UnpurchasedButtons")
	if buttons == nil then
		return
	end

	local rebirths = getStat("Rebirths")
	local priceIndex = buildPriceIndex()

	-- Forget info of buttons that are gone
	for button in buttonInfo do
		if button.Parent ~= buttons then
			buttonInfo[button] = nil
		end
	end

	-- The Medbay start button goes first (retried every 10 s at most)
	local medbay = buttons:FindFirstChild("Medbay Start")
	if medbay ~= nil and os.clock() >= medbayRetryAt then
		if not tryBuy(medbay, buttons, 10) then
			medbayRetryAt = os.clock() + 10
		end
		task.wait(0.3)
	end

	local eligible: { Candidate } = {}
	for _, button in buttons:GetChildren() do
		if button.ClassName ~= "Model" then
			continue
		end
		local info = getInfo(button)
		if info.skipType or restricted[info.restrictKey] == true or rebirths < info.rebirth then
			continue
		end
		if not info.known then
			local indexed = priceIndex[info.nameKey]
			if indexed ~= nil then
				info.price = indexed
				info.known = true
			end
		end
		table.insert(eligible, { button = button, info = info, sort = if info.known then info.price else math.huge })
	end
	table.sort(eligible, function(a: Candidate, b: Candidate): boolean
		return a.sort < b.sort
	end)

	local cash = getStat("Cash")
	for _, item in eligible do
		if buyAborted() then
			return
		end
		local button = item.button
		local info = item.info
		if button.Parent ~= buttons or info.retryAt > os.clock() then
			continue
		end
		if info.known and info.price > cash then
			continue
		end
		if tryBuy(button, buttons, if info.known then 5 else 30) then
			cash = getStat("Cash")
		end
	end
end

-- Runs fn in its own thread while holding the action lock. The lock is always released; an error is
-- rethrown so Severe shows it in its console.
local function startAction(fn: () -> ()): ()
	actionBusy = true
	task.spawn(function()
		local ok, err = pcall(fn)
		actionBusy = false
		if not ok then
			error(err, 0)
		end
	end)
end

-- ───────────────────────── Menu drawing ─────────────────────────

-- Checks whether a point is inside a rectangle.
local function inRect(px: number, py: number, x: number, y: number, w: number, h: number): boolean
	return px >= x and px <= x + w and py >= y and py <= y + h
end

-- Cuts a label to maxLen characters.
local function shortLabel(s: string, maxLen: number): string
	if #s > maxLen then
		return string.sub(s, 1, maxLen - 1) .. "."
	end
	return s
end

-- Filled rounded rectangle; immediate mode has no rounding, so it is built from rectangles and corner circles.
local function RoundRect(x: number, y: number, w: number, h: number, r: number, color: Color3)
	if r <= 3 then
		DrawingImmediate.FilledRectangle(vec(x + 1, y, 0), vec(w - 2, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + 1, 0), vec(w, h - 2, 0), color, 1)
		return
	end
	if r <= 6 then
		-- three stacked rectangles shape the corner (about half the draw calls of real circles)
		local i1 = floor(r * 0.6 + 0.5)
		local i2 = math.max(1, floor(r * 0.25 + 0.5))
		local t = floor(r * 0.6)
		DrawingImmediate.FilledRectangle(vec(x + i1, y, 0), vec(w - 2 * i1, h, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x + i2, y + 1, 0), vec(w - 2 * i2, h - 2, 0), color, 1)
		DrawingImmediate.FilledRectangle(vec(x, y + t, 0), vec(w, h - 2 * t, 0), color, 1)
		return
	end
	DrawingImmediate.FilledRectangle(vec(x + r, y, 0), vec(w - 2 * r, h, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledRectangle(vec(x + w - r, y + r, 0), vec(r, h - 2 * r, 0), color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + r, y + h - r, 0), r, color, 1)
	DrawingImmediate.FilledCircle(vec(x + w - r, y + h - r, 0), r, color, 1)
end

-- Toggle pill with a 1px outline and a square knob (right = on, left = off).
local function DrawPill(x: number, y: number, w: number, h: number, on: boolean)
	RoundRect(x, y, w, h, 5, on and T.PillLine or T.PillLineOff)
	RoundRect(x + 1, y + 1, w - 2, h - 2, 4, on and T.PillBg or T.PillBgOff)
	local knob: number = 10
	local kx: number = on and (x + w - knob - 4) or (x + 4)
	RoundRect(kx, y + (h - knob) / 2, knob, knob, 3, on and T.Knob or T.KnobOff)
end

-- Draws one toggle row (optional color swatch). Returns true if the row was clicked.
local function DrawToggleRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	enabled: boolean,
	clicked: boolean,
	mp: vector,
	swatch: Color3?
): boolean
	local labelX: number = x + 10
	if swatch then
		DrawingImmediate.FilledRectangle(vec(x + 10, y + h / 2 - 3, 0), vec(6, 6, 0), swatch, 1)
		labelX = x + 22
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 13, enabled and T.TextRow or T.TextOff, 1, label, false)

	local pillW: number = 32
	local pillH: number = 18
	DrawPill(x + w - pillW - 10, y + (h - pillH) / 2, pillW, pillH, enabled)

	return clicked and inRect(mp.x, mp.y, x, y, w, h)
end

-- Draws a row with a small button on the right. Returns true if the button was clicked.
local function DrawActionRow(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	btnText: string,
	clicked: boolean,
	mp: vector
): boolean
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextRow, 1, label, false)

	local bw: number = 64
	local bh: number = 18
	local bx: number = x + w - bw - 10
	local by: number = y + (h - bh) / 2
	local hover = inRect(mp.x, mp.y, bx, by, bw, bh)
	RoundRect(bx, by, bw, bh, 5, T.PillLine)
	RoundRect(bx + 1, by + 1, bw - 2, bh - 2, 4, if hover then T.PillLine else T.PillBg)
	DrawingImmediate.Text(vec(bx + bw / 2, by + 3, 0), 12, T.TextMain, 1, btnText, true)

	return clicked and hover
end

-- Draws a compact chip (optional on/off indicator, label). Returns true if it was clicked.
local function DrawChip(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	on: boolean?,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	RoundRect(x, y, w, h, 5, if hover then T.PillLine else T.Chip)
	local labelX = x + 10
	if on ~= nil then
		DrawingImmediate.FilledRectangle(vec(x + 8, y + h / 2 - 3, 0), vec(6, 6, 0), if on then T.Knob else T.PillLineOff, 1)
		labelX = x + 20
	end
	DrawingImmediate.Text(vec(labelX, y + h / 2 - 6, 0), 11, if on == false then T.TextOff else T.TextRow, 1, label, false)
	return clicked and hover
end

-- Draws a collapsible section header (label, counter, arrow). Returns true if clicked.
local function DrawDropdownHeader(
	x: number,
	y: number,
	w: number,
	h: number,
	label: string,
	countText: string,
	open: boolean,
	clicked: boolean,
	mp: vector
): boolean
	local hover = inRect(mp.x, mp.y, x, y, w, h)
	if hover or open then
		RoundRect(x, y, w, h, 6, T.Chip)
	end
	DrawingImmediate.Text(vec(x + 10, y + h / 2 - 6, 0), 13, T.TextMain, 1, label, false)
	DrawingImmediate.Text(vec(x + w - 46, y + h / 2 - 6, 0), 12, T.TextDim, 1, countText, true)

	local cx: number = x + w - 16
	local cy: number = y + h / 2
	if open then
		DrawingImmediate.FilledTriangle(vec(cx - 5, cy - 3, 0), vec(cx + 5, cy - 3, 0), vec(cx, cy + 3, 0), T.Knob, 1)
	else
		DrawingImmediate.FilledTriangle(vec(cx - 3, cy - 5, 0), vec(cx - 3, cy + 5, 0), vec(cx + 3, cy, 0), T.Knob, 1)
	end

	return clicked and hover
end

-- Draws the tab bar; returns the index of the clicked tab (0 if none).
local function DrawTabs(x: number, y: number, w: number, clicked: boolean, mp: vector): number
	local count = #TAB_NAMES
	local gap: number = 4
	local tabW: number = (w - gap * (count - 1)) / count
	local hit = 0
	for i, name in TAB_NAMES do
		local tx = x + (i - 1) * (tabW + gap)
		local active = UIState.Tab == i
		local hover = inRect(mp.x, mp.y, tx, y, tabW, TAB_H)
		if active or hover then
			RoundRect(tx, y, tabW, TAB_H, 6, T.Chip)
		end
		DrawingImmediate.Text(vec(tx + tabW / 2, y + TAB_H / 2 - 6, 0), 12, if active then T.TextMain else T.TextOff, 1, name, true)
		if clicked and hover then
			hit = i
		end
	end
	return hit
end

-- Draws a slider row; returns the new value and keeps dragging while the button is held.
local function DrawSliderRow(
	x: number,
	y: number,
	w: number,
	label: string,
	value: number,
	minV: number,
	maxV: number,
	suffix: string,
	clicked: boolean,
	ldown: boolean,
	mp: vector
): number
	DrawingImmediate.Text(vec(x + 10, y + 9, 0), 11, T.TextDim, 1, label, false)

	local valStr = tostring(floor(value)) .. suffix
	RoundRect(x + w - 55, y + 9, 45, 14, 4, T.Chip)
	DrawingImmediate.Text(vec(x + w - 32.5, y + 10, 0), 11, T.TextMain, 1, valStr, true)

	local tX: number = x + 10
	local tW: number = w - 20
	local tC: number = y + 43 -- vertical center of the track

	if clicked and inRect(mp.x, mp.y, tX - 6, tC - 10, tW + 12, 20) then
		SliderActive = true
	end
	if not ldown then
		SliderActive = false
	end

	if SliderActive then
		local rel = math.clamp((mp.x - tX) / tW, 0, 1)
		value = floor((minV + rel * (maxV - minV)) / 10 + 0.5) * 10
		value = math.clamp(value, minV, maxV)
	end

	RoundRect(tX, tC - 2, tW, 4, 2, T.Track)

	local frac: number = math.clamp((value - minV) / (maxV - minV), 0, 1)
	local thumbX: number = tX + floor(tW * frac) - 5
	RoundRect(thumbX, tC - 5, 10, 10, 3, T.Knob)

	return value
end

