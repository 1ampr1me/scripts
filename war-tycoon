-- Draws the menu, handles dragging and every click (uses only the input snapshot, no memory calls).
local function drawMenu(): ()
	local clicked: boolean = input.clicked
	input.clicked = false
	local ldown: boolean = input.down
	local mx: number = input.mx
	local my: number = input.my
	local mp: vector = vec(mx, my, 0)

	-- Dragging by the title bar
	if ldown then
		if not UIState.Dragging then
			if UIState.Visible and not SliderActive and inRect(mx, my, UIState.X, UIState.Y, T.W, HEADER_H) then
				UIState.Dragging = true
				UIState.DragOffset.x = mx - UIState.X
				UIState.DragOffset.y = my - UIState.Y
			end
		else
			UIState.X = math.clamp(mx - UIState.DragOffset.x, 0, math.max(0, viewW - T.W))
			UIState.Y = math.clamp(my - UIState.DragOffset.y, 0, math.max(0, viewH - UIState.PanelH))
		end
	else
		UIState.Dragging = false
	end

	if not UIState.Visible then
		return
	end

	local ux: number = UIState.X
	local uy: number = UIState.Y
	local uw: number = T.W

	RoundRect(ux, uy, uw, UIState.PanelH, 10, T.Bg)

	-- Header + close "x"
	DrawingImmediate.FilledRectangle(vec(ux + 18, uy + 18, 0), vec(6, 6, 0), T.White, 1)
	DrawingImmediate.Text(vec(ux + 30, uy + 14, 0), 13, T.TextMain, 1, "SEVERE | WAR TYCOON", false)
	DrawingImmediate.Text(vec(ux + 31, uy + 14, 0), 13, T.TextMain, 1, "SEVERE | WAR TYCOON", false) -- second pass = bolder title
	DrawingImmediate.Text(vec(ux + uw - 26, uy + 13, 0), 14, T.TextDim, 1, "x", false)
	if clicked and inRect(mx, my, ux + uw - 28, uy, 28, HEADER_H) then
		UIState.Visible = false
		return
	end

	local tab = DrawTabs(ux + 8, uy + HEADER_H, uw - 16, clicked, mp)
	if tab ~= 0 then
		UIState.Tab = tab
	end

	local yo: number = uy + HEADER_H + TAB_H + 8
	local current = UIState.Tab
	if current == 1 then
		yo = drawEspTab(ux, yo, uw, clicked, mp)
	elseif current == 2 then
		yo = drawFarmTab(ux, yo, uw, clicked, mp)
	elseif current == 3 then
		yo = drawTeleportTab(ux, yo, uw, clicked, mp)
	else
		yo = drawRestrictTab(ux, yo, uw, clicked, mp)
	end
	yo += 6

	-- Footer
	DrawingImmediate.FilledRectangle(vec(ux + 12, yo, 0), vec(uw - 24, 1, 0), T.Divider, 1)
	DrawingImmediate.Text(vec(ux + 18, yo + 11, 0), 11, T.TextDim, 1, "Shown:", false)
	DrawingImmediate.Text(vec(ux + 62, yo + 11, 0), 11, T.TextRow, 1, tostring(markerCount), false)
	DrawingImmediate.Text(vec(ux + 114, yo + 11, 0), 11, T.TextDim, 1, "Hide menu:", false)
	DrawingImmediate.Text(vec(ux + 188, yo + 11, 0), 11, T.TextMain, 1, "RShift", false)
	UIState.PanelH = yo + 32 - uy
end

